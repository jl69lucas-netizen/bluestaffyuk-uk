---
// src/pages/index.astro — REBUILT from the approved board record (data/boards/index.json,
// approved 2026-09-20). Hand-written and NOT regenerated by `npm run extract`: the slug is
// listed in data/facts/rebuilt.json, so `migration_parity.py` skips it and
// `facts_preserved_check.py` plus `verbatim_set_check.py` are its gates instead.
//
// THE FIRST PAGE UNDER WORKING RULE 15 (faithful rewrite). Two kinds of sentence live here
// and they must not be confused. The VERBATIM SET — the migrated H1, every H2/H3 carrying a
// target keyword, the first paragraph under each of those headings, the FAQ questions and
// every image alt — is carried WORD FOR WORD from the migrated body at 63a7b12. Everything
// else is written fresh, in Lisa Bright's first person, from the record's outline; not one
// sentence of it is pasted. Where the old wording states a wrong fact or collides with
// another page's heading the change is in the record's `verbatim.changed` with its reason,
// and `scripts/verbatim_set_check.py --check` proves all 67 elements are accounted for.
//
// TWENTY-ONE SECTIONS, in the record's order, each mounted in the style `approval.picks`
// names. No section, link, image or video is here that the board does not carry, and none
// the board carries is missing: `scripts/link_parity_check.py` is the gate on the links in
// both directions and `facts_preserved_check.py` on the rest.
//
// NO FORM ON THIS PAGE, and no puppy Offer markup. One enquiry form per money page — the
// contact page and the listing carry the site's two — and the listing page owns the
// per-puppy Product/Offer nodes (spec §2), so the grid here links to it rather than marking
// up a second machine-readable price for the same dog. `brief.schema.offer_model` is
// "none"; the only node this page adds is FAQPage. LocalBusiness, WebSite and WebPage come
// from the shell, with the town-level address Known Issue 16 leaves us.
//
// NO DATE IS RENDERED. `schema-no-visible-date` is blocking on a sales-shaped page and
// freshness belongs in the schema; PageDate is the privacy policy's exception (amendment
// 6e) and this record asks for none.
//
// H4-H6 ARE WRITTEN HERE, not in the record (amendment 2.1): the approved outline stops at
// the H3 the breeder read. Every ladder sentence traces to the migrated body or to a file
// under data/ (amendment 6f), and the H6 lines all open on the record's own
// `tuple.h6_prefixes` entry, "Kennel Note:". Every heading renders through `titleCase()`
// (amendment 4b) — approved wording, site-wide case.
import PageShell from '../layouts/PageShell.astro';
import Hero from '../components/kit/Hero.astro';
import CounterStrip from '../components/kit/CounterStrip.astro';
import TrustStrip from '../components/kit/TrustStrip.astro';
import PuppyCard from '../components/kit/PuppyCard.astro';
import InfoCard from '../components/kit/InfoCard.astro';
import DataTable from '../components/kit/DataTable.astro';
import Testimonial from '../components/kit/Testimonial.astro';
import VideoEmbed from '../components/kit/VideoEmbed.astro';
import Faq from '../components/kit/Faq.astro';
import { sectionsFromRecord } from '../lib/sections';
import { pickedStyle, approvalInForce } from '../lib/pickedStyle';
import { bakedAssets, bakedSrcset, inPublic } from '../lib/assets';
import { countedFigures, type StatRow } from '../lib/recordText';
import { boxClass } from '../lib/boardStyles';
import { titleCase as T } from '../lib/headings';
import { loadFaq } from '../lib/faq';
import { SITE, abs, guaranteeLabel, guaranteeCoverSentence, type PuppyRow } from '../lib/site';
import { videoObject } from '../lib/video';
import puppiesJson from '../../data/puppies.json';
import reviewsJson from '../../data/reviews.json';
import record from '../../data/boards/index.json';
import healthRecord from '../../data/boards/blue-staffy-health-uk.json';

const path = '/';
// The picked meta variants and H1, BY INDEX from the approval — never retyped here. `h1`
// index 0 IS the migrated H1, carried whole (rule 15).
// `approvalInForce()`, not `record.approval`: these three are INDICES, and the record
// is back on the board for its hero and its counter (working rule 16) with its approval
// carried under `approval_previous`. What the page is called was never the question.
const approved = approvalInForce(record);
const title = record.meta_set.titles[approved.meta!.title];
const description = record.meta_set.descriptions[approved.meta!.description];
const h1 = record.h1.variants[approved.h1];

// The fourteen photographs, by slot, at their ORIGINAL public paths with their ORIGINAL alt
// text (working rule 11; those alts are also fourteen elements of the verbatim set). A
// missing slot throws at build rather than rendering an image with no alt.
const asset = bakedAssets(record, 'index.astro');
const heroPhoto = asset('home-hero');
const guarantee = asset('home-guarantee');
const ownerManchester = asset('home-owner-manchester');
const litterPlaying = asset('home-litter-playing');
const litterRehoming = asset('home-litter-rehoming');
const inTheHouse = asset('home-in-the-house');
const onTheLawn = asset('home-on-the-lawn');
const damWithPups = asset('home-dam-with-pups');
const familyDog = asset('home-family-dog');
const vetCheck = asset('home-vet-check');
const breedGuide = asset('home-breed-guide');
const deliveryVan = asset('home-delivery-van');
const deliveryTransport = asset('home-delivery-transport');
const ownerLondon = asset('home-owner-london');

// THE SIX PUPPIES, filtered on `status` rather than hard-coded: a puppy leaving the list is
// a data edit, not a page edit, which is the only honest way for a front page to say what
// is still looking. All six rows are Available today.
const available = (puppiesJson as PuppyRow[]).filter((p) => p.status === 'Available');

// THE REVIEWS, found BY NAME so a row inserted above one cannot swap the quote silently.
// The single slot near the top is the Victoria family (data/reviews.json entry 1, sourced
// to this page); the grid at the foot renders all three, so no REVIEW_PLACEHOLDER is
// counted on this page.
const victoria = reviewsJson.find((r) => r.name === 'The Victoria Family')!;
const allReviews = reviewsJson;

// THE TEN FAQ ROWS THE RECORD NAMES, BY ID, in the record's order. By id and not by
// `source`: two of the ten (`home-safe-delivery`, `home-price-range`) are sourced to
// data/settings.json because the answer IS the setting, so a `source` filter would drop
// them. Ten of the migrated accordion's twelve questions; the other two are the duplicate
// pair the record's `verbatim.changed` merges into these rows.
const faqSection = record.sections.find((s) => s.id === 'your-questions-about-blue-staffies-answered')!;
const faqRows = loadFaq();
const faqs = faqSection.tree.map((n) => {
  const row = faqRows.find((r) => r.id === n.heading);
  if (!row) throw new Error(`index.astro: data/faq.json has no row ${n.heading}`);
  return row;
});

// THE ELEVEN LOCATION LINKS, read off the record so the cluster block cannot point anywhere
// the board did not approve. All eleven are `nav: true` — a cluster repeats its destinations
// by nature — and they are the eleven INDEXED rows of data/locations.json; the seventeen
// noindex stubs are in `dropped.links`.
const locationLinks = record.sections.find((s) => s.id === 'uk-locations')!.links.internal;

// The at-a-glance table, cell for cell from the record — every figure in it is a value on
// disk (data/price-matrix.json, data/settings.json), and this is the only place on the page
// a money figure is printed.
const table = record.sections.find((s) => s.id === 'whats-included')!.table!;

// The three videos, at the ids the old site already ranks for (working rule 14). Nothing is
// re-uploaded and no id is minted: each is read off the record's own `video` block.
const video = (id: string) => record.sections.find((s) => s.id === id)!.video!;
const videoLitter = video('video-litter');
const videoOurHome = video('video-our-home');
const videoBreed = video('video-breed');

const sections = sectionsFromRecord(record);

// Each section's approved arrangement, resolved through the same `boxClass()` the board
// preview called: what the breeder signed off is what ships.
const style = (id: string) => pickedStyle(record, id);
const box = (id: string) => boxClass(style(id));
const heroStyle = style('top');
const counterStyle = style('at-a-glance');

// WORKING RULE 16 — the per-page hero and counter the breeder picked on 2026-09-22: H-HM2 and
// C-HM2, the home family's own arrangements, resolved through `pickedStyle()` like every other
// section so the page mounts what the board rendered.
//
// THE COUNTER'S FIGURES ARE DERIVED HERE, and the record's `n` is the expectation each one is
// counted against (`countedFigures()`, src/lib/recordText.ts). The record's three rows cite a
// filter over data/puppies.json, the length of the health record's own DNA table (the page
// that OWNS those two tests) and the two ends of the delivery band in data/settings.json. A
// puppy reserved, a test added or a band re-priced changes the figure here and then stops the
// build until the board's `n` has been looked at, rather than printing a number nobody checked.
const heroSection = record.sections.find((s) => s.id === 'top')!;
const counterSection = record.sections.find((s) => s.id === 'at-a-glance')!;
const dnaTests = healthRecord.sections.find((s) => s.id === 'dna-tests')!.table!.rows.length;
const COUNTED: Record<string, string> = {
  'data/puppies.json#count(status=Available)': String(available.length),
  'data/boards/blue-staffy-health-uk.json#len(sections[dna-tests].table.rows)': String(dnaTests),
  'data/settings.json#delivery_min_gbp|data/settings.json#delivery_max_gbp':
    `£${SITE.delivery_min_gbp}–£${SITE.delivery_max_gbp}`,
  // The hero's two figure tiles (the price band and the refundable deposit; Known Issue 33,
  // user ruling R11). The price band is the setting's own two numbers written the way the
  // page prints money; the deposit tile says "refundable", so it prints nothing a
  // non-refundable setting could back.
  'data/settings.json#price_range':
    SITE.price_range.replace(/£(\d)(\d{3})/g, '£$1,$2').replace(/\s*-\s*/, '–'),
  'data/settings.json#deposit_gbp|data/settings.json#deposit_refundable':
    SITE.deposit_refundable ? `£${SITE.deposit_gbp}` : 'a deposit that is not refundable',
  // Held for a third figure tile ("3 films of our puppies") the user may ask for at the R11
  // pause; no record row cites it today, so nothing prints it.
  'data/settings.json#len(youtube_embeds)': String(SITE.youtube_embeds.length),
};
const counted = countedFigures(COUNTED, 'index.astro');
const counterStats = (counterSection.stats as StatRow[]).map(counted);
// H-HM2's ledge is `stats`, and its entries are the RECORD's: two figure tiles of the page's
// own (the price band and the refundable deposit), neither of them one of the counter's three
// one section down, each derived above from the file its row cites.
const heroStats = ((heroSection.stats ?? []) as StatRow[]).map(counted);
// The mosaic's four tiles are the photographs the record's hero section names, at their
// original paths (working rule 11; Known Issue 33, user ruling R11). The FIRST is the migrated
// page's own primary image, keeps its alt and is the LCP image. The other three are
// photographs this page already shows and describes lower down, so their tile alt is EMPTY: a
// repeated image described twice is a duplicate alt (`img-alt-present-and-unique`, blocking)
// and a screen reader would hear the same sentence twice. Each tile offers the smaller
// siblings baked beside its master, because a tile paints at 140-182px on a desktop.
const TILE_WIDTHS: Record<string, number[]> = {
  'home-hero': [440],
  'home-on-the-lawn': [240, 400, 760],
  'home-family-dog': [240, 400],
  'home-delivery-transport': [240, 400, 760],
  'home-dam-with-pups': [400, 760],
  'home-vet-check': [400, 760],
};
const heroTiles = heroSection.images.map((i, n) => {
  const a = asset(i.slot);
  return { src: a.file, alt: n === 0 ? a.alt : '', w: a.w, h: a.h, caption: a.caption,
           srcset: bakedSrcset(a, TILE_WIDTHS[i.slot] ?? [], inPublic) };
});

// "Mo-Su 09:00-23:00" as a sentence, from the setting rather than typed as prose.
const hours = SITE.hours.replace('Mo-Su ', 'from ').replace('-', ' to ');

// The FAQPage node is built from the SAME ten rows the accordion renders, so the markup and
// the page can never answer a question differently. `data/faq.json` keeps the sentence-case
// wording, which is what `name` reads; the visible question is cased at render (amendment
// 6g). No `dateModified` here on purpose — BaseLayout adds the WebPage node with the
// git-derived dates, and a second date on one page is worse than one.
const pageSchema = [
  // The VideoObject(s) for the embed(s) this page carries, built from the record's own
  // `video` block through `src/lib/video.ts` — one id, one spelling, shared with the video
  // sitemap. No `uploadDate`: no file in this repo holds one and rule 9 forbids inventing a
  // date (Known Issue 17).
  videoObject(videoLitter, abs(path)),
  videoObject(videoOurHome, abs(path)),
  videoObject(videoBreed, abs(path)),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${abs(path)}#faq`,
    mainEntity: faqs.map((r) => ({
      '@type': 'Question',
      name: r.q,
      acceptedAnswer: { '@type': 'Answer', text: r.a },
    })),
  },
];
---
<PageShell
  title={title}
  description={description}
  canonical={path}
  schema={pageSchema}
  sections={sections}
>
  {/* 01 top — hero, picked style H-HM2 (the home family's mosaic above centred copy, figure
      tiles as its ledge). No trust chips and no CTA buttons (amendment 6a): the trust strip is
      its own section two below. The H1 is the migrated H1, carried whole (rule 15), and the
      first tile is the migrated page's own primaryImageOfPage at its original path and alt.
      Four tiles and two figures since Known Issue 33 closed (user ruling R11): the
      arrangement the breeder picked, no longer its single-photo fallback. */}
  <section slot="hero" id="top" data-section-label="Blue Staffy puppies raised at home" class={box('top')}>
    <Hero
      as="h1"
      eyebrow={`KC registered · Microchipped · ${SITE.location_label}`}
      title={T(h1)}
      lede="I am Lisa Bright. We raise our blue Staffy puppies at home."
      image={heroPhoto.file}
      imageAlt={heroPhoto.alt}
      imageWidth={heroPhoto.w}
      imageHeight={heroPhoto.h}
      imageSrcset="/images/blue-staffy-puppy-for-sale-uk-440.webp 440w, /images/blue-staffy-puppy-for-sale-uk.webp 612w"
      layout={heroStyle.layout.hero ?? 'split'}
      align={heroStyle.layout.align ?? 'left'}
      media={heroStyle.layout.media ?? 'right'}
      ledge={heroStyle.layout.ledge ?? 'none'}
      stats={heroStats}
      mosaic={heroTiles}
    />
    <p>
      Home is our own house in Carlisle, and the puppies are blue Staffordshire Bull Terriers.
      Both parents have DNA tests for L-2-HGA and HC-HSF4, and every puppy is microchipped
      and has had its first vaccination before it goes.
    </p>
    <p>
      <a href="/buy-blue-staffy-puppies-uk/">See which puppies are looking for homes</a> — every
      one of ours is on that page by name, with its sex, its colour, its price and whether it
      is still free. Nothing here is a waiting list for a litter that has not been born.
    </p>
    <p>
      <a href="/blue-staffy-pup-sale-uk/">What a puppy costs, and what the deposit holds</a> is
      set out in full on the price page, and the short version is in the table further down
      this one. We make no claim on this page that we cannot put a document behind, which is
      also why there is no ranking in the heading above it.
    </p>
  </section>

  {/* 02 at-a-glance — stats, picked style C-HM2 (ruled columns, the label beside each
      figure). The strip prints the record's three sourced `stats` rows, every figure derived
      above from the file its row cites; not one of them is typed here, which is what stops a
      front page going stale between litters. */}
  <section id="at-a-glance" data-section-label="Today's figures" class={box('at-a-glance')}>
    <div class="bl-head">
      <p class="bl-eyebrow">Read straight from our files</p>
      <h2>{T(counterSection.heading)}</h2>
      <p class="bl-lede">
        Three numbers, kept current as puppies are reserved: how many puppies our list still has
        free, how many DNA tests stand behind both parents, and what home delivery costs.
      </p>
    </div>
    <div class="bl-body">
      <CounterStrip
        stats={counterStats}
        tiles={counterStyle.layout.tiles ?? 'inline'}
        label={counterStyle.layout.label ?? 'under'}
      />
      <p>When a puppy is reserved the first figure moves, because the figure is the list.</p>
    </div>
  </section>

  {/* 03 trust — trust, picked style S2 (strip in a card). The H2 and its opening paragraph
      are the migrated page's own (rule 15), as are the "Ethically Bred" H3 and its opening.
      The health-guarantee PHOTOGRAPH is carried at its original path and alt (working rule
      11); the guarantee itself is stated in the H5 below from data/settings.json
      `guarantee_label` (answer board q07, 2026-09-29); the record's `dropped.creds` still lists
      it from before, to be updated on the board's next touch. */}
  <section id="trust" data-section-label="Key takeaways" class={box('trust')}>
    <div class="bl-head">
      <p class="bl-eyebrow">What we can show you</p>
      <h2>{T('Key Takeaways: The BluestaffyUK Promise')}</h2>
      <p class="bl-lede">
        We are a small, family-run team dedicated to the health and well-being of every puppy. We are KC-registered and DEFRA-approved , and all our puppies are raised in a loving home environment, not a kennel.
      </p>
    </div>
    <div class="bl-body">
      <TrustStrip />
      <img
        class="bl-img"
        src={guarantee.file}
        alt={guarantee.alt}
        width={guarantee.w}
        height={guarantee.h}
        srcset="/images/buy-staffy-health-guarantee-uk-760.webp 760w, /images/buy-staffy-health-guarantee-uk.webp 1080w"
        sizes="(max-width: 800px) 100vw, 420px"
        loading="lazy"
        decoding="async"
      />
      <h3>{T('Ethically Bred')}</h3>
      <p>
        We adhere to the highest ethical Staffy breeding standards, ensuring healthy and happy parent dogs.
      </p>
      <p>
        <a href="/buy-staffy-puppies-for-sale-uk/">The case for choosing us, with the evidence attached</a> takes
        each of those in turn, with what sits behind it.
      </p>
      <h4>{T('Four Things, Not Four Adjectives')}</h4>
      <p>
        Each claim above names something real: a registration, two DNA tests whose paperwork you
        may ask for, a vaccination card and a microchip number. The papers are handed over on the day.
      </p>
      {/* The guarantee is data/settings.json `guarantee_label` (the breeder's answer, answer
          board q07, 2026-09-29), read through guaranteeLabel(), never typed; its cover is
          `guarantee_cover` (q02), read through guaranteeCoverSentence(). */}
      <h5>{T(`Our ${guaranteeLabel()}`)}</h5>
      <p>
        {guaranteeCoverSentence()} Every puppy goes home with it on paper, like the documents above. Ask us for the full
        wording before you pay anything.
      </p>
      <h6>{T('Kennel Note: Ask to see the papers early')}</h6>
      <p>They exist, so asking costs you nothing and tells you a great deal.</p>
    </div>
  </section>

  {/* 04 why-choose — standard, picked style S2. Restored under rule 15: the H2, its opening
      and the "Ethical Breeding Practices" H3 and opening are all the migrated page's own. The
      four pillars are a sentence each; /buy-staffy-puppies-for-sale-uk/ is the page that
      argues them, and this section carries no photograph so the puppies stay above the fold. */}
  <section id="why-choose" data-section-label="Why choose a pure-bred Staffy pup" class={box('why-choose')}>
    <div class="bl-head">
      <h2>{T('Why Choose a Pure-bred Staffy Pup for Sale from BlueStaffyUK.uk?')}</h2>
      <p class="bl-lede">
        When buying a blue staffy puppy in the UK, you want quality assurance, health, and ethical breeding. At BlueStaffyUK.uk, we prioritize:
      </p>
    </div>
    <div class="bl-body">
      <div class="bl-prose">
        <div class="bl-stub">
          <h3>{T('Ethical Breeding Practices')}</h3>
          <p>
            We adhere to the highest standards, ensuring our parent dogs are healthy, have excellent temperaments, and are carefully selected to produce exceptional offspring.
          </p>
          <p>
            Health is the pillar we test for: both parents are DNA tested for the two
            conditions this breed is screened for. Temperament comes from where a puppy grows up,
            which here is a kitchen and not a kennel block. And the journey home is your own
            car or transport approved to carry animals.
          </p>
          <p>
            <a href="/buy-staffy-puppies-for-sale-uk/">The full case, reason by reason</a> is
            the page that sets all four out at length.
          </p>
        </div>
      </div>
      <h4>{T('Pure-bred Means the Paperwork Says So')}</h4>
      <p>
        Kennel Club registration is the record of a dog's parents and it travels with the
        puppy. It is a document, not a description.
      </p>
      <h5>{T('One Sentence Each, on Purpose')}</h5>
      <p>A front page that argues all four at length is a page nobody finishes.</p>
      <h6>{T('Kennel Note: We breed from two dogs, not a programme')}</h6>
      <p>Maggie and Jones are the whole of it, and they live here.</p>
    </div>
  </section>

  {/* 05 owners-top — reviews, picked style S2 (band, eyebrow heading). MODE IS SINGLE, which
      the record states twice — in this section's `options.note` and again in
      `approval.notes` — and the style axis does not contradict it: `boxClass()` emits no
      mode, so the bed is S2's and the mode is the one the board wrote down. The quote itself
      is a row of data/reviews.json and is not retyped here. */}
  <section id="owners-top" data-section-label="One family on arriving day" class={box('owners-top')}>
    <div class="bl-head">
      <p class="bl-eyebrow">One review, near the top</p>
      <h2>{T('One Family On What Arriving Day Was Like')}</h2>
      <p class="bl-lede">
        The Victoria family in Manchester wrote this after their puppy had settled. It is here
        rather than at the foot of the page because what a reader is weighing this early is
        what the process felt like, not what the dog looks like.
      </p>
    </div>
    <div class="bl-body">
      {/* mode="single" is the RECORD's note, not the style's `mode` axis: S2 is the bed this
          slot was picked for (steel band, eyebrow heading) and the note is what says how many
          reviews sit on it. Ratified by the breeder 2026-09-20. */}
      <Testimonial mode="single" reviews={[victoria]} />
      <img
        class="bl-img"
        src={ownerManchester.file}
        alt={ownerManchester.alt}
        width={ownerManchester.w}
        height={ownerManchester.h}
        srcset="/images/victoria-family-blue-staffy-manchester-440.webp 440w, /images/victoria-family-blue-staffy-manchester.webp 723w"
        sizes="(max-width: 800px) 100vw, 420px"
        loading="lazy"
        decoding="async"
      />
      <p>
        Three families have sent us a review and we hold three; the other two are at the foot
        of this page. None of them is a screenshot of somewhere else.
      </p>
    </div>
  </section>

  {/* 06 available-blue-staffy-puppies — puppies, picked style S3 (scrolling rail on a band).
      The H2 and the first H3 are the migrated page's own (rule 15). The cards are rows of
      data/puppies.json rendered by PuppyCard, filtered on `status`; their own links are the
      grid's data and are exempt from link parity (amendment 6b). The listing page OWNS the
      per-puppy Product and Offer markup, so this page marks up no offer at all. */}
  <section id="available-blue-staffy-puppies" data-section-label="Meet our affordable blue Staffy puppies" class={box('available-blue-staffy-puppies')}>
    <div class="bl-head">
      <p class="bl-eyebrow">Ready for their forever homes</p>
      <h2>{T('Meet Our Affordable Blue Staffy Puppies Ready for Their Forever Homes')}</h2>
      <p class="bl-lede">
        Every puppy we have, by name, off our own list. We give no age, because our list holds
        none, and no count in this sentence, because a count is wrong the day a puppy is
        reserved.
      </p>
    </div>
    <div class="bl-body">
      <div class="bl-cards">
        {available.map((p) => <PuppyCard slug={p.slug} />)}
      </div>
      <img
        class="bl-img"
        src={litterPlaying.file}
        alt={litterPlaying.alt}
        width={litterPlaying.w}
        height={litterPlaying.h}
        loading="lazy"
        decoding="async"
      />
      <h3>{T('Our UK Blue Staffy Litter Details')}</h3>
      <p>
        Sex, colour, price and whether the puppy is still free are the four things our list
        holds about each dog, and the four things a card shows.
      </p>
      <h3>{T('What Each Card Shows')}</h3>
      <p>
        A photograph of that dog, its name, its sex, its colour, its price and its status.
        <a href="/available-puppies/">Open a puppy's own page</a> from any card for the rest of
        what we know about it.
      </p>
      <img
        class="bl-img"
        src={litterRehoming.file}
        alt={litterRehoming.alt}
        width={litterRehoming.w}
