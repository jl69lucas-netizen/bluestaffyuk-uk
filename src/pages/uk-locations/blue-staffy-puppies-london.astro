---
// src/pages/uk-locations/blue-staffy-puppies-london.astro — the London city page, written from its
// APPROVED outline and board (page-run row 12; data/outlines/blue-staffy-puppies-london.json,
// STOP 2; data/boards/blue-staffy-puppies-london.json, STOP 3 and the Asset Gate, STOP 4).
//
// THE BOARD IS THE SOURCE. Every H2 is its section's `heading` and every H3 its `tree` node, in
// record order and word for word, including the six infographic H3s added after STOP 2
// (`outline_changes_since_stop2`). The H4-H6 ladder is the tree's own. Every image is the one
// `approval.picks["img:<slot>"]` names, from the record's baked `assets` row (its served alt kept,
// working rule 11). Every link is one the board lists, Link-First with the board's anchor
// (working rule 12); the only others are in-page pointers from an FAQ answer down to the section
// that answers it at length. The three FAQ blocks carry exactly the board's questions, which are
// the question file's FAQ `covered_by` texts.
//
// EVERY FACT IS DATA (working rule 9): prices, deposit, delivery band, town, guarantee, the
// deposit's refund clause (data/settings.json `deposit_refund_clause`, the user's wording of
// 2026-09-27 landed at this build by the ruling of 2026-09-30), the puppies' names, sexes and
// colours, and every breed-standard figure (data/breed-standards.json) are read, never typed. The
// parents (Maggie and Jones), the video call on request and payment by bank transfer are the
// breeder's answers on the answer board (2026-09-27 and 2026-09-29). The tests are named and no
// result is stated (plan Ruling 4). Nothing on the page is about a licence (Ruling 5).
//
// KEPT OUT OF THE INDEX until the user approves the page (`noindex, follow`, Task 37 flips it).
//
// THE SIX INFOGRAPHICS (approved on the answer board, 2026-10-03 q02 a) are art-directed: the wide
// file in the uniform box, its tall `-760` layout below 640px. Each is one entry of `IG` below.
//
// ONE SERVED PHOTOGRAPH, ONE ALT PER USE: Maggie's photograph opens the page in the trust ledger
// with its served alt (the board's `london-hero` slot) and returns under the parents' H4 with the
// board's new alt (`litter-parents-dam`). The frame's other photographs are files no body slot
// uses, so each is a first use.
import CityShell from '../../layouts/CityShell.astro';
import locations from '../../../data/locations.json';
import settings from '../../../data/settings.json';
import board from '../../../data/boards/blue-staffy-puppies-london.json';
import standards from '../../../data/breed-standards.json';
import faqBank from '../../../data/faq.json';
import queries from '../../../data/queries/blue-staffy-puppies-london.json';
import type { LocationRow, PuppyRow } from '../../lib/site';
import { SITE_URL } from '../../lib/site';
import type { SectionRef } from '../../lib/sections';
import { bakedAssets, bakedSrcset, inPublic } from '../../lib/assets';
import type { BodyAsset } from '../../components/BodyImage.astro';
import BodyImage from '../../components/BodyImage.astro';
import SectionDivider from '../../components/kit/SectionDivider.astro';
import CityHeroFilmstrip from '../../components/kit/CityHeroFilmstrip.astro';
import CityPriceScale from '../../components/kit/CityPriceScale.astro';
import CityTrustLedger from '../../components/kit/CityTrustLedger.astro';
import CityJumpStepper from '../../components/kit/CityJumpStepper.astro';
import CityDialPhotoMarker from '../../components/kit/CityDialPhotoMarker.astro';
import CityContentsPhotoIndex from '../../components/kit/CityContentsPhotoIndex.astro';
import CityTakeawaysLedger from '../../components/kit/CityTakeawaysLedger.astro';
import CityRoster from '../../components/kit/CityRoster.astro';
import CityFaqLedger, { type CityFaqRow } from '../../components/kit/CityFaqLedger.astro';
import CityChapters from '../../components/kit/CityChapters.astro';
import CityLetter from '../../components/kit/CityLetter.astro';
import CityNewsletterNotice from '../../components/kit/CityNewsletterNotice.astro';
import CityContactLineup from '../../components/kit/CityContactLineup.astro';
import { BOY_PRICE, DELIVERY_BAND, DEPOSIT, GIRL_PRICE, TOWN, availablePuppies, depositBrief, depositLine, faqPageNode, guaranteeRow } from '../../lib/cityKit';
import { guaranteePhraseOf, guaranteeWords, type GuaranteeSettings } from '../../lib/guarantee';
import { numberWord } from '../../lib/recordText';

const SLUG = 'blue-staffy-puppies-london';
const loc = (locations as LocationRow[]).find((l) => l.slug === SLUG);
if (!loc) throw new Error(`data/locations.json has no row for ${SLUG}`);

// ── the record ──────────────────────────────────────────────────────────────────────────────
const SECTIONS = Object.fromEntries(board.sections.map((s) => [s.id, s]));
const H2 = (id: string) => {
  const s = SECTIONS[id];
  if (!s) throw new Error(`the London board has no section ${id}`);
  return s.heading as string;
};
type TreeNode = { level: number; heading: string; children?: TreeNode[] };
/** The tree node at a path of child indexes, e.g. tree(id, 0) is the first H3, tree(id, 0, 0) its H4. */
const tree = (id: string, ...path: number[]): string => {
  let nodes = (SECTIONS[id].tree ?? []) as TreeNode[];
  let node: TreeNode | undefined;
  for (const i of path) {
    node = nodes[i];
    if (!node) throw new Error(`the London board's ${id} tree has no node at ${path.join('.')}`);
    nodes = node.children ?? [];
  }
  return node!.heading;
};
const H1 = board.h1.variants[board.approval.h1];
const TITLE = board.meta_set.titles[board.approval.meta.title];
const DESCRIPTION = board.meta_set.descriptions[board.approval.meta.description];

// ── the litter (data/puppies.json) ─────────────────────────────────────────────────────────
const pups = availablePuppies();
const boys = pups.filter((p) => p.sex === 'male');
const girls = pups.filter((p) => p.sex === 'female');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const LITTER = numberWord(pups.length);
const BOYS = numberWord(boys.length);
const GIRLS = numberWord(girls.length);
const andList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const coats = (ps: PuppyRow[]) => andList(ps.map((p) => `${p.name} is ${p.colour.toLowerCase()}`));

// ── the facts that are not a cityKit line ──────────────────────────────────────────────────
const REFUND = settings.deposit_refund_clause;
const G = settings as unknown as GuaranteeSettings;
const guarantee = guaranteeRow();
const GUARANTEE_PHRASE = guaranteePhraseOf(G);
const GUARANTEE_LOWER = guaranteeWords(G, 'lower');
const REGION = settings.address.region;
const SBT = standards.breeds['staffordshire-bull-terrier'];
const AMS = standards.breeds['american-staffordshire-terrier'];
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const bank = (id: string) => {
  const row = (faqBank as { id: string; q: string; a: string }[]).find((r) => r.id === id);
  if (!row) throw new Error(`data/faq.json has no row ${id}`);
  return row;
};

// ── images: the board's baked rows ─────────────────────────────────────────────────────────
const asset = bakedAssets(board as never, SLUG);
const SIBLINGS = [240, 400, 440, 760];
/** A served photograph's row, with the width siblings baked beside it on disk. */
const photo = (slot: string): BodyAsset => {
  const a = asset(slot);
  const widths = SIBLINGS.filter((w) => w < a.w && inPublic(a.file.replace(/(\.[a-z]+)$/, `-${w}$1`)));
  return widths.length ? { ...a, srcset: bakedSrcset(a, widths, inPublic) } : a;
};
/** An approved infographic: the wide file, its tall phone layout and the alt it is read by. To
 *  swap one, change its entry here. */
const infographic = (slot: string, alt: string, phone: { w: number; h: number }): BodyAsset => {
  const a = asset(slot);
  return { ...a, alt: a.alt || alt, phone: { src: a.file.replace(/\.webp$/, '-760.webp'), ...phone } };
};
const IG = {
  'deposit-steps': infographic('deposit-steps', '', { w: 760, h: 1013 }),
  'delivery-route': infographic('delivery-route',
    `The route from ${TOWN} to London: collection in ${TOWN}, or UK home delivery by DEFRA-approved transport, priced by distance`, { w: 760, h: 692 }),
  'litter-prices-figures': infographic('litter-prices-figures',
    'Four cards: the price of a boy, the price of a girl, the deposit and its terms, and how many puppies are available now', { w: 760, h: 1062 }),
  'health-tests-checklist': infographic('health-tests-checklist',
    'A checklist of six health questions to put to a Staffy breeder, from the two DNA tests to checking a Kennel Club registration', { w: 760, h: 754 }),
  'paperwork-checklist': infographic('paperwork-checklist',
    "A checklist for your puppy's folder: microchip and vaccinations, the written contract, what to check before signing, and the guarantee", { w: 760, h: 458 }),
  'breed-split': infographic('breed-split',
    'The English Staffy and American Staffordshire Terrier breed standards side by side: the standard, height, coat colours and UK law', { w: 760, h: 1187 }),
};

// ── links (the board's, Link-First) ────────────────────────────────────────────────────────
const EXT = { target: '_blank', rel: 'noopener noreferrer' } as const;

// ── the nav set: ten stops, each section's own H2 as its question ──────────────────────────
const sections: SectionRef[] = [
  { id: 'deposit-viewing', label: 'The deposit and the video call', stop: 'Deposit', icon: 'deposit', question: H2('deposit-viewing') },
  { id: 'delivery', label: 'Getting your puppy to London', stop: 'Delivery', icon: 'delivery', question: H2('delivery') },
  { id: 'litter-prices', label: 'The litter and its prices', stop: 'Prices', icon: 'prices', question: H2('litter-prices') },
  { id: 'health-tests', label: 'Health tests to ask about', stop: 'Health', icon: 'health', question: H2('health-tests') },
  { id: 'paperwork', label: 'What comes home with a puppy', stop: 'Papers', icon: 'list', question: H2('paperwork') },
  { id: 'london-life', label: 'A Staffy in a London home', stop: 'London', icon: 'home', question: H2('london-life') },
  { id: 'temperament', label: 'Temperament and bonding', stop: 'Nature', icon: 'puppies', question: H2('temperament') },
  { id: 'breed', label: 'Staffy, pit bull or AmStaff', stop: 'Breed', icon: 'faq', question: H2('breed') },
  { id: 'everyday-health', label: 'Everyday health', stop: 'Care', icon: 'health', question: H2('everyday-health') },
  { id: 'enquiry', label: 'Send your enquiry', stop: 'Enquire', icon: 'enquire', question: H2('enquiry') },
];

// ── the takeaways ──────────────────────────────────────────────────────────────────────────
const takeaways = [
  { label: 'Video first', text: 'Ask for a live video call with your puppy and Maggie before you pay anything.' },
  { label: 'The deposit', text: depositLine },
  { label: 'The prices', text: `${BOY_PRICE} for a boy and ${GIRL_PRICE} for a girl, the same wherever you live.` },
  { label: 'Getting home', text: `UK home delivery for ${DELIVERY_BAND}, priced by distance, or collection in ${TOWN}.` },
  { label: 'The tests', text: 'Ask any breeder, us included, about L-2-HGA, HC-HSF4, eye screening and elbow screening.' },
  ...(guarantee ? [{ label: guarantee.t, text: guarantee.d }] : []),
];

// ── the three FAQ blocks: the board's questions, each answered from its bank row or data key ──
const faqTop: CityFaqRow[] = [
  { q: 'How Much Do Blue Staffy Puppies Cost in the UK?',
    a: `Ours are ${BOY_PRICE} for a boy and ${GIRL_PRICE} for a girl, and a London buyer pays the same as anyone else.`,
    more: { href: '#litter-prices', label: 'The litter, puppy by puppy' } },
  { q: 'Can I Get a Blue Staffy Puppy Delivered to My Home in London?',
    a: `Yes. We deliver to London homes by DEFRA-approved transport for ${DELIVERY_BAND}, priced by distance.`,
    more: { href: '#delivery', label: 'How delivery to London works' } },
  { q: 'How Much Is the Deposit?', a: `${DEPOSIT}. ${depositBrief}`,
    more: { href: '#deposit-viewing', label: 'What the deposit does, step by step' } },
  { q: 'How Do I Know a Puppy Is Still Available?',
    a: 'Our list is updated as puppies are reserved, so a puppy still on it is free, and we confirm the one you like before you pay anything.' },
  { q: 'How Do I Reserve One of Your Blue Staffy Puppies From London?',
    a: "Send the enquiry form at the foot of this page with the puppy's name, and we reply by email with the next steps." },
  { q: 'Where Can I Find Blue Staffy Breeders in the UK?',
    a: `Here. We raise blue Staffordshire Bull Terrier puppies in our own home in ${TOWN}, deliver across the UK, London included, and keep a page for each part of the country.` },
];
const faqMiddle: CityFaqRow[] = [
  { q: 'Should I See My Puppy With Its Mother Before Any Money Changes Hands?',
    a: 'Yes. You can ask for a live video call with your puppy and Maggie before any deposit, then meet them in person when you visit.',
    more: { href: '#deposit-viewing', label: 'The video call and the deposit' } },
  { q: "Are the Puppy's Parents Health Tested?",
    a: 'Ask us about L-2-HGA, HC-HSF4, eye screening and elbow screening for Maggie and Jones. We hold no certificates, so we name the tests and quote no result.',
    more: { href: '#health-tests', label: 'What each test is for' } },
  { q: 'Will the Breeder Still Support Me After I Collect the Puppy?',
    a: 'Yes. Write to us before or after your puppy is home and you get the same answer, from us rather than an agency.' },
  { q: 'Can I Visit You Before I Decide?',
    a: `Yes, by appointment. Our dogs live in our family home in ${TOWN}, so we arrange a visit once we have talked through your enquiry.` },
  { q: 'Do You Offer Health Guarantees for Your Blue Staffy Puppies?',
    a: `Yes. Every puppy leaves with our written ${GUARANTEE_PHRASE} and we ask you to read the full terms before you pay a deposit.` },
  { q: 'What Is Included When I Buy a Blue Staffy Puppy From BlueStaffyUK?',
    a: 'A veterinary health check, first vaccinations, a microchip, worming and flea treatment, the Kennel Club paperwork and a puppy pack.',
    more: { href: '#paperwork', label: 'The paperwork, item by item' } },
  { q: 'What Makes BlueStaffyUK an Ethical Breeder for London Buyers?',
    a: 'Every litter grows up in our home with Puppy Culture and early neurological stimulation, we name the health tests to ask about, and you can see your puppy on a video call before you pay.' },
];
const rarity = bank('breed-blue-rarity');
const faqBottom: CityFaqRow[] = [
  { q: 'Are Blue Staffies Suitable for First-Time Dog Owners?',
    a: 'Yes, for a household with time to give. Early socialising, steady reward-based training and company matter more than experience.' },
  { q: 'Is a Staffy a Good House Dog?',
    a: 'Yes. It is a medium-sized, people-focused dog that is happiest indoors with its family, and its old nickname is the nanny dog.',
    more: { href: '#london-life', label: 'A Staffy in a London home' } },
  { q: 'Is It Better to Get a Male or Female Staffy?',
    a: "Neither is better. Boys can be more boisterous and girls a little more independent, but training and the puppy's own character count for more." },
  { q: 'Are Blue Staffies Good Family Pets, Especially With Children?',
    a: 'Yes, when well socialised. Ours hear the noise of an ordinary family house before they leave, and any dog with children still needs supervising.' },
  { q: 'Are Staffies Hard to Train?',
    a: 'No, though they are strong-willed. They learn quickly, so short, regular sessions work better than long ones.' },
  { q: 'Are the Puppies Raised in a Family Home or in Kennels?',
    a: 'In our home, never in kennels. Every litter grows up indoors with us, among the everyday sights and sounds of a house.' },
  { q: 'Can a Staffordshire Bull Terrier Live in a London Flat?',
    a: 'Yes, with daily walks and something to think about. The breed is medium-sized and people-focused, so a garden matters less than regular exercise.' },
  { q: rarity.q, a: rarity.a },
];
// The board names each block's rows, and the question file records the wording each takes on
// the page (`covered_by.text`): the board's own words, or a recorded change where those words
// would collide with another live page's heading (scripts/pageboard.py header-collision). Two
// do: the board's "How Much Are Blue Staffy Puppies in the UK?" and "Should I See the Puppy With
// Its Mother Before Any Money Changes Hands?" share a five-word run with headings on
// /buy-staffy-puppies-for-sale-uk/ and /uk-blue-staffy-puppy-buying-guide/, so the page asks the
// same questions as "How Much Do Blue Staffy Puppies Cost in the UK?" and "Should I See My Puppy
// With Its Mother Before Any Money Changes Hands?". A question that drifts from both stops the build.
const norm = (t: string) => t.replace(/’/g, "'").trim().toLowerCase();
const onPage = (boardQ: string) => {
  const qs = (queries.questions as { question: string; covered_by: { where: string; text: string } | null }[])
    .filter((q) => q.covered_by?.where === 'faq');
  const hit = qs.find((q) => norm(q.covered_by!.text) === norm(boardQ)) ?? qs.find((q) => norm(q.question) === norm(boardQ));
  if (!hit) throw new Error(`data/queries/${SLUG}.json covers no FAQ question "${boardQ}"`);
  return hit.covered_by!.text;
};
for (const [id, rows] of [['faq-top', faqTop], ['faq-middle', faqMiddle], ['faq-bottom', faqBottom]] as const) {
  const want = (SECTIONS[id].tree as { intent: string }[]).map((n) => onPage(n.intent.match(/^Q: (.*?) —/)![1]));
  const got = rows.map((r) => r.q);
  if (want.map(norm).join('|') !== got.map(norm).join('|')) {
    throw new Error(`${id}: the questions differ from the approved board:\n${got.join('\n')}\nwant\n${want.join('\n')}`);
  }
}

// ── schema ─────────────────────────────────────────────────────────────────────────────────
const business = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': `${SITE_URL}/#business`,
  name: settings.site_name, areaServed: { '@type': 'City', name: 'London' },
};
const schema = [faqPageNode([...faqTop, ...faqMiddle, ...faqBottom]), business];
---
<CityShell title={TITLE} description={DESCRIPTION} canonical={`/uk-locations/${SLUG}/`}
  robots="noindex, follow" ogType="article" schema={schema} crumbTitle="London" sections={sections}
  nav={{
    bar: { component: CityJumpStepper },
    dial: { component: CityDialPhotoMarker, props: {
      photo: 'Cheryl1.jpeg', photoAlt: 'Cheryl, a blue Staffy girl with a white blaze, lying on a wooden floor at home' } },
    contents: { component: CityContentsPhotoIndex, props: {
      id: 'contents', 'data-section-label': H2('contents'),
      heading: H2('contents'),
      lede: 'Jump to the part you need: the deposit, delivery to London, the litter and its prices, the health tests or life with a Staffy.',
      photo: 'Vennie.jpeg',
      photoAlt: 'Vennie, a blue and white Staffy girl, curled up asleep on a sheepskin rug',
    } },
  }}>
  <Fragment slot="hero">
    <CityHeroFilmstrip id="top" data-section-label={H2('top')}
      eyebrow={`${cap(LITTER)} puppies · ${TOWN} to London`}
      title={H1}
      lede={`Yes. You can ask for a live video call with your puppy and Maggie, its mother, before any deposit. Your visit to us in ${TOWN} comes after that call. We raise every litter in our own home, and our blue Staffy puppies for London homes come from this one: ${LITTER} puppies, ${BOYS} boys at ${BOY_PRICE} and ${GIRLS} girls at ${GIRL_PRICE}. Lisa Bright, BlueStaffyUK.`}
      cta={{ label: 'Blue Staffy puppies available now', href: '/available-puppies/' }}
      more={{ label: 'BlueStaffyUK', href: '/' }}
    />
    <CityPriceScale id="counter" data-section-label={H2('counter')} labels={{
      count: 'puppies available now',
      delivery: 'UK home delivery, priced by distance',
      deposit: 'deposit, taken off the price',
      price: 'the price of one puppy from this litter',
    }} />
    <CityTrustLedger id="trust" data-section-label={H2('trust')}
      heading={H2('trust')}
      intro="Each line is something you can check with us before you pay."
      photo="maggie-blue-staffy-dam-with-pups.webp" caption="Maggie, our dam, with her puppies"
      items={[
        { icon: 'eye', claim: 'A video call first', detail: 'With your puppy and Maggie, on request, before any deposit' },
        { icon: 'dna', claim: 'The tests, named', detail: 'L-2-HGA, HC-HSF4, eye screening and elbow screening; no result quoted' },
        ...(guarantee ? [{ icon: 'shield' as const, claim: guarantee.t, detail: guarantee.d }] : []),
        { icon: 'delivery', claim: 'To your London door', detail: `DEFRA-approved transport, or collect in ${TOWN}` },
      ]} />
  </Fragment>

  <SectionDivider />
  <CityTakeawaysLedger id="key-takeaways" data-section-label={H2('key-takeaways')}
    heading={H2('key-takeaways')}
    lede={`${cap(numberWord(takeaways.length))} short answers for anyone reading from London.`}
    photo="jones-strong-staffy-sire-temperament.webp" caption={`Jones, our sire, at home in ${TOWN}`}
    rows={takeaways} />

  <SectionDivider />
  <CityLetter id="review-top" data-section-label={H2('review-top')}
    heading={H2('review-top')}
    lede="Mark J wrote this after his puppy came home to London."
    name="Mark J" photo="mark-blue-staffy-london.webp" />

  <SectionDivider />
  <CityFaqLedger id="faq-top" data-section-label={H2('faq-top')} block="top" start={1}
    heading={H2('faq-top')}
    lede="Quick answers on price, delivery, the deposit and reserving from London. Each one is short, and the sections below take it further."
    rail={{ photo: 'trusted-blue-staffy-breeder-reviews-satisfied-owners.webp', caption: 'A new owner with her puppy.' }}
    items={faqTop} />

  <SectionDivider />
  <CityChapters id="deposit-viewing" data-section-label={H2('deposit-viewing')}
    heading={H2('deposit-viewing')}
    image={photo('deposit-h2')}
    lede={`No. You can ask for a live video call with your puppy and Maggie, its mother, before any deposit. After that call, your deposit books a visit to us in ${TOWN} and reserves the puppy you chose.`}
    chapters={[
      { place: 'Before you pay', question: tree('deposit-viewing', 0), asset: photo('deposit-video-call'),
        text: 'Yes. Ask us for a live video call and we show you your puppy and Maggie together, at home, before you decide anything.' },
      { place: 'Once you choose', question: tree('deposit-viewing', 1), asset: photo('deposit-choose'),
        text: `It holds that puppy for you. Your ${DEPOSIT} deposit books your viewing in ${TOWN} and takes the puppy off our list, so nobody else can reserve it.` },
      { place: 'In order', question: tree('deposit-viewing', 2), asset: IG['deposit-steps'], wide: true,
        text: `Four steps, in this order: a video call with the puppy and its mother, then the deposit, then your visit to us in ${TOWN}, then collection here or delivery to your London door. Nothing is paid before the first step, and each one waits until you are ready.` },
    ]}>
    <Fragment slot="ch-1">
      <p><a href="/uk-blue-staffy-breeders-contact/">Booking a video call with us</a> takes one message: tell us which puppy you like and when you are free.</p>
      <h4>{tree('deposit-viewing', 0, 0)}</h4>
      <p>Send the enquiry form or write to us, name the puppy and give a time that suits you. We reply by email to fix the call.</p>
      <h5>{tree('deposit-viewing', 0, 0, 0)}</h5>
      <p>Ask to see the puppy move about, then Maggie with the litter. Put any question you have about the parents, the paperwork or the contract.</p>
      <h6>{tree('deposit-viewing', 0, 0, 0, 0)}</h6>
      <p>Because a puppy shown with its mother, in the home it grew up in, is what you are told to look for. <a href="https://www.rspca.org.uk/adviceandwelfare/pets/dogs/puppy/sales" {...EXT}>The RSPCA's advice on puppy adverts</a> asks buyers to see the puppy with its mother, in person. Our call is a first look, and you still meet them in person when you visit.</p>
    </Fragment>
    <Fragment slot="ch-2">
      <p><a href="/uk-blue-staffy-puppy-buying-guide/">The questions to ask any breeder before you pay</a> are in our buying guide; ask us every one of them.</p>
      <h4>{tree('deposit-viewing', 1, 0)}</h4>
      <p>By bank transfer, after you have seen your puppy on the call. It comes off the price, so on a boy at {BOY_PRICE} or a girl at {GIRL_PRICE} it is part of what you pay, never an extra on top.</p>
      <h5>{tree('deposit-viewing', 1, 0, 0)}</h5>
      <p>Tell us as soon as you know, and we talk it through with you. How much comes back depends on timing, which the next answer sets out.</p>
      <h6>{tree('deposit-viewing', 1, 0, 0, 0)}</h6>
      <p>The deposit is {REFUND}. Ask us to confirm that in writing when you pay.</p>
    </Fragment>
    <p><a href="#enquiry">Send us your enquiry and ask for the video call</a>, and tell us which puppy caught your eye.</p>
  </CityChapters>

  <SectionDivider />
  <CityChapters id="delivery" data-section-label={H2('delivery')}
