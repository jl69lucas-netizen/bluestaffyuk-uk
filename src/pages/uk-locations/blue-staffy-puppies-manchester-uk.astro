---
// src/pages/uk-locations/blue-staffy-puppies-manchester-uk.astro — the Manchester city page, written
// from its approved board (the Manchester page run, page-run row 12).
//
// WHAT THIS IS. A question-led breeder page for Greater Manchester buyers that asks whether colour
// should decide (the research board's M1) and answers from the data: health, the parents and the
// deposit first, one price per sex in this litter, the coat last. Its sources, and nothing else:
//   - the approved outline, data/outlines/blue-staffy-puppies-manchester-uk.json (STOP 2): the H1;
//   - the approved page board, data/boards/blue-staffy-puppies-manchester-uk.json (STOP 3): the 22
//     sections in order, each one `<section id="<board id>" data-section-label="<board heading>">`
//     in <main>, every H2 to H6 its section's `heading` and `tree`, every link its `links`, the two
//     HELD links (8 and 9, STOP 3 q12) left unbuilt while their sentences stand;
//   - the Asset Gate (STOP 4): every image is its slot's `assets[]` row, read from the record by
//     slot (file, alt, size), and the four frame repeats take the alts the breeder approved there
//     (data/boards/frame-alts/blue-staffy-puppies-manchester-uk.json, q08 (a)).
// The prose is written for this page from the board's intents; no sibling page was opened for it
// (working rule 8). First-person voice as Lisa Bright; breed facts in a neutral register (rule 1).
//
// EVERY FACT IS DATA (rule 9): prices, the deposit and its refund clause, the delivery band and how
// it is priced, the town, the guarantee and its cover, the test names, the trust signs, the litter's
// names, sexes, coats and personalities are read through src/lib/cityKit.ts, src/lib/site.ts and the
// data files, never typed. The tests are named and no result is stated (the certificates are shared
// on request); the breed is "not a banned breed / not on the government's list" only; no licence
// claim, no rescue wording, no video call, no phone, no mileage, journey time or date.
//
// KEPT OUT OF THE INDEX: `noindex, follow`, written HERE rather than read from data/locations.json,
// until the user approves the page (page-run row 21, Task 54). scripts/generate_sitemaps.py leaves a
// noindex page out of every shard.
import CityShell from '../../layouts/CityShell.astro';
import BodyImage from '../../components/BodyImage.astro';
import locations from '../../../data/locations.json';
import outline from '../../../data/outlines/blue-staffy-puppies-manchester-uk.json';
import board from '../../../data/boards/blue-staffy-puppies-manchester-uk.json';
import frameAlts from '../../../data/boards/frame-alts/blue-staffy-puppies-manchester-uk.json';
import CityFeatureAndThree from '../../components/kit/CityFeatureAndThree.astro';
import CityRangeSheet from '../../components/kit/CityRangeSheet.astro';
import CityPuppyFolder from '../../components/kit/CityPuppyFolder.astro';
import CityIconRows from '../../components/kit/CityIconRows.astro';
import CityNumeralRail from '../../components/kit/CityNumeralRail.astro';
import CityQuestionBar from '../../components/kit/CityQuestionBar.astro';
import CityTickCard from '../../components/kit/CityTickCard.astro';
import CityPhotoShelf from '../../components/kit/CityPhotoShelf.astro';
import CityOffsetSheet from '../../components/kit/CityOffsetSheet.astro';
import CityThreePlates from '../../components/kit/CityThreePlates.astro';
import CityRowsBesideAPhoto from '../../components/kit/CityRowsBesideAPhoto.astro';
import CityPostmarkedNote from '../../components/kit/CityPostmarkedNote.astro';
import CityPhotoAtTheEdge from '../../components/kit/CityPhotoAtTheEdge.astro';
import { MANCHESTER_FAQ } from '../../lib/manchesterFaq';
import { MANCHESTER, MANCHESTER_H2, MANCHESTER_NAV } from '../../lib/manchesterNav';
import {
  availablePuppies, depositTerms, faqPageNode, pickAvailable, priceFor, refundClause, sexWord, sign,
  BOY_PRICE, GIRL_PRICE, DEPOSIT, DELIVERY_BAND, TOWN, PARENT_DNA_TESTS, PUPPY_SIGNS, transportName, pricedBy,
} from '../../lib/cityKit';
import { guaranteeFact } from '../../lib/cityKit';
import { puppyAlt } from '../../lib/imageFocus';
import { bakedAssets, bakedSrcset, inPublic, type FilledAsset } from '../../lib/assets';
import { numberWord } from '../../lib/recordText';
import { SITE, SITE_URL, abs, guaranteeCoverSentence, guaranteeLabel } from '../../lib/site';
import type { LocationRow } from '../../lib/site';
import type { SectionRef } from '../../lib/sections';

const SLUG = 'blue-staffy-puppies-manchester-uk';
const loc = (locations as LocationRow[]).find((l) => l.slug === SLUG);
if (!loc) throw new Error(`data/locations.json has no row for ${SLUG}`);
if (outline.slug !== SLUG || board.meta.slug !== SLUG) throw new Error(`the outline or the board is not ${SLUG}'s`);

// ── the board, as the page reads it ─────────────────────────────────────────────────────────────
type Node = { level: number; heading: string; children?: Node[] };
type Sec = { id: string; heading: string; tree?: Node[] };
const SECTIONS = board.sections as unknown as Sec[];
const sec = (id: string): Sec => {
  const s = SECTIONS.find((x) => x.id === id);
  if (!s) throw new Error(`the board has no section ${id}`);
  return s;
};
/** A section's tree, flattened in document order, so the page can write each heading word for word
 *  and refuse a heading the board does not carry. */
const flat = (nodes: Node[] = []): Node[] => nodes.flatMap((n) => [n, ...flat(n.children)]);
/** The board heading at `path` (indices into the tree), checked to sit at `level`. */
const head = (id: string, level: number, ...path: number[]): string => {
  let nodes = sec(id).tree ?? [];
  let n: Node | undefined;
  for (const i of path) { n = nodes[i]; nodes = n?.children ?? []; }
  if (!n || n.level !== level) throw new Error(`board section ${id}: no H${level} at [${path.join(', ')}]`);
  return n.heading;
};
const label = (id: string) => sec(id).heading;

/** A slot's baked `assets[]` row, with the candidate list of the width siblings baked beside it. */
const asset = bakedAssets(board as unknown as Parameters<typeof bakedAssets>[0]);
const SIBLINGS = [240, 400, 760];
const photo = (slot: string): FilledAsset & { srcset?: string } => {
  const a = asset(slot);
  const dot = a.file.lastIndexOf('.');
  const widths = SIBLINGS.filter((w) => w < a.w && inPublic(`${a.file.slice(0, dot)}-${w}${a.file.slice(dot)}`));
  return widths.length ? { ...a, srcset: bakedSrcset(a, widths, inPublic) } : a;
};
/** The papers infographic's phone layout, drawn for the ~300px phone box at 2x. Its `w` descriptor,
 *  read against `sizes`, gives the browser that density, as London's phone layouts do
 *  (`infographic()` there); without it the 622px file read as 2.11x a 295px box (row 13,
 *  img-srcset-within-2x). */
const PAPERS_PHONE = { src: '/images/blue-staffy-puppy-papers-checklist-manchester-phone.webp', w: 622, h: 1644 };
const papersPhone = {
  ...PAPERS_PHONE,
  srcset: bakedSrcset({ ...asset('papers-checklist'), slot: 'papers-checklist-phone', file: PAPERS_PHONE.src, w: PAPERS_PHONE.w, h: PAPERS_PHONE.h }, [], inPublic),
};
/** A frame repeat's approved alt (STOP 4 q08 (a)), by section and file; never retyped. */
type FrameAlt = { section: string; file: string; alt: string };
const frameAlt = (section: string, file: string): string => {
  const row = (frameAlts.rows as FrameAlt[]).find((r) => r.section === section);
  if (!row || !row.file.endsWith(file)) throw new Error(`frame-alts: no approved alt for ${file} in ${section}`);
  return row.alt;
};
/** The HELD links (STOP 3 q12): on the board, left unbuilt until the deposit-order correction lands. */
const HELD = (board.sections as unknown as { links?: { internal?: { href: string; why: string }[] } }[])
  .flatMap((s) => s.links?.internal ?? []).filter((l) => l.why.includes('HELD:')).map((l) => l.href);
if (HELD.length !== 2) throw new Error(`the board holds ${HELD.length} links, not the two STOP 3 q12 held`);

// ── the nav set: the thirteen H2 sections, in page order (board ids, ruling 3) ───────────────────
const NAV_IDS = ['faq-top', 'deposit', 'health-tests', 'litter', 'faq-middle', 'travel', 'papers', 'guarantee',
  'busy-household', 'favourite-person', 'coat', 'faq-bottom', 'enquiry'];
const sections: SectionRef[] = NAV_IDS.map((id, i) => {
  const question = label(id);
  if (question !== MANCHESTER_H2[i]) throw new Error(`nav row ${i + 1} is "${question}"; the outline's H2 ${i + 1} is "${MANCHESTER_H2[i]}"`);
  return { id, question, ...MANCHESTER_NAV[i] };
});

// ── the litter, from the data ───────────────────────────────────────────────────────────────────
const pups = availablePuppies();
const LITTER = numberWord(pups.length);
const of = (sex: 'male' | 'female') => pups.filter((p) => p.sex === sex);
const BOYS = numberWord(of('male').length);
const GIRLS = numberWord(of('female').length);
const list = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0] ?? '');
const COATS = [...new Set(pups.map((p) => p.colour.toLowerCase()))];
const [TEST_A, TEST_B] = PARENT_DNA_TESTS;
const lcFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const GUARANTEE = guaranteeLabel('lower');
if (!guaranteeCoverSentence()) throw new Error('data/settings.json gives no guarantee cover to state');
const PAPERS = ['Vet-signed health card', 'First vaccinations', 'Microchipped', 'Wormed and flea treated', 'KC registration application form'].map(sign);

// The hero: the board's hero slot is Roman's card (manchester-hero); three more of the litter beside him.
const HERO = asset('manchester-hero');
const HERO_PUPS = pickAvailable(['Roman', 'Cheryl', 'Ince', 'Vennie'], 4);
const heroIsTheSlot = HERO_PUPS[0]?.slug && HERO.file.includes(`/puppies/${HERO_PUPS[0].slug}-card`);
// A puppy's card photo appears in the hero, the counter's faces and the litter table, each under its
// own alt (src/lib/imageFocus.ts); the two FAQ blocks that show a card take the one alt left unused.
const BYRD = pickAvailable(['Byrd'], 1)[0];
const CHRISTA = pickAvailable(['Christa'], 1)[0];
const VENNIE = pickAvailable(['Vennie'], 1)[0];

// ── the schema: the twenty visible questions, the business serving Greater Manchester (no telephone
// while PHONE_PLACEHOLDER) and the byline's author ─────────────────────────────────────────────
const AREA = `Greater ${MANCHESTER}`;
const schema = [
  faqPageNode(MANCHESTER_FAQ.flatMap((b) => b.items)),
  { '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': `${SITE_URL}/#business`, name: SITE.site_name,
    url: SITE_URL, areaServed: { '@type': 'AdministrativeArea', name: AREA } },
  { '@context': 'https://schema.org', '@type': 'Person', '@id': `${SITE_URL}/blue-staffy-uk-breeders/#lisa-bright`,
    name: SITE.breeder_name, url: abs('/blue-staffy-uk-breeders/'), worksFor: { '@id': `${SITE_URL}/#business` },
    address: { '@type': 'PostalAddress', addressLocality: TOWN, addressRegion: SITE.address.region, addressCountry: SITE.address.country } },
];
const [faqFirst, faqHealth, faqLife] = MANCHESTER_FAQ;
const enquiry = label('enquiry');
---
<CityShell title={loc.title} description={loc.description} canonical={`/uk-locations/${SLUG}/`}
  robots="noindex, follow" ogType="article" schema={schema} crumbTitle={loc.city} sections={sections}
  nav={{
    bar: { component: CityQuestionBar, props: { city: MANCHESTER, photo: CHRISTA.card_photo } },
    dial: { component: CityNumeralRail, props: { city: MANCHESTER } },
    contents: { component: CityIconRows, props: { city: MANCHESTER, photo: 'reputable-blue-staffy-breeder-manchester-pup.webp',
      id: 'contents', 'data-section-label': label('contents') } },
  }}>
  <Fragment slot="hero">
    <CityFeatureAndThree id="top" data-section-label={label('top')} as="h1" title={outline.h1}
      cta={{ label: 'Ask about a puppy', href: '#enquiry' }} more={{ label: 'See the whole litter', href: '#litter' }}
      photos={HERO_PUPS.map((p) => p.name)} featureAlt={heroIsTheSlot ? HERO.alt : undefined}>
      <Fragment slot="byline">By <a href="/blue-staffy-uk-breeders/">{SITE.breeder_name}</a>, who breeds our Staffies in {TOWN}</Fragment>
      <Fragment slot="lede"><a href="/">Here at BlueStaffyUK</a> we raise Staffordshire Bull Terrier puppies indoors in {TOWN}, {SITE.address.region}, and price them by sex, never by coat. <a href="/available-puppies/">Available Blue Staffy puppies</a> for {MANCHESTER} homes are {BOY_PRICE} a boy and {GIRL_PRICE} a girl.</Fragment>
    </CityFeatureAndThree>
    <CityRangeSheet id="counter" data-section-label={label('counter')} city={MANCHESTER} shownAbove={HERO_PUPS.map((p) => p.name)} />
    <CityPuppyFolder id="trust" data-section-label={label('trust')} city={MANCHESTER} />
  </Fragment>

  <CityTickCard id="key-takeaways" data-section-label={label('key-takeaways')} city={MANCHESTER}
    photo="blue-staffy-family-dog-uk.webp" cta={{ label: 'Ask us about a puppy', href: '#enquiry' }} />

  <CityThreePlates id="review-top" data-section-label={label('review-top')} name="The Victoria Family"
    photo="victoria-family-blue-staffy-manchester.webp" side="start" />

  <CityRowsBesideAPhoto id="faq-top" data-section-label={label('faq-top')} block={faqFirst.key} heading={faqFirst.heading}
    items={faqFirst.items} side="end" photo={CHRISTA.card_photo} photoAlt={puppyAlt(CHRISTA, 'short')}
    caption={`${CHRISTA.name}, one of our ${GIRLS} girls`}
    lede="Price, where we are, delivery and the deposit: what families ask us before anything else." />

  {/* ── G1 · the deposit and the visit (outline row 8) ── */}
  <section id="deposit" data-section-label={label('deposit')} class="mx-chapter">
    <CityOffsetSheet heading={label('deposit')} asset={photo('deposit-h2')} rows={depositTerms()}>
      <Fragment slot="lede">Because the {DEPOSIT} deposit books your viewing here in {TOWN}, holds your puppy for you and comes off the price. Paying someone you found online is a fair worry, so below is what you can check before any money moves, and what you see before you commit to a puppy.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('deposit', 3, 0)}</h3>
        <BodyImage asset={photo('deposit-settle')} srcset={photo('deposit-settle').srcset} box="uniform" focal="50% 30%" />
        <p>It takes the puppy you chose off our list and fixes the date of your visit, so nobody else can reserve that puppy while you plan the trip. It is a booking, not a sale: you have not committed to the puppy until you have met it, its mother and its papers.</p>
        <h4>{head('deposit', 4, 0, 0)}</h4>
        <p>By bank transfer, once we have confirmed the puppy is still free, and all of it comes off the price of {BOY_PRICE} for a boy or {GIRL_PRICE} for a girl.</p>
        <h5>{head('deposit', 5, 0, 0, 0)}</h5>
        <p>If you change your mind, your {DEPOSIT} is {refundClause()}.</p>
        <h6>{head('deposit', 6, 0, 0, 0, 0)}</h6>
        <p>Up to the day before collection or delivery, the line that clause draws, so tell us as early as you can.</p>
      </div>
      <div class="mx-a">
        <h3>{head('deposit', 3, 1)}</h3>
        <BodyImage asset={photo('deposit-questions')} srcset={photo('deposit-questions').srcset} box="uniform" focal="50% 40%" />
        <p>Whether the puppy is still free, who the parents are, what each parent has been tested for and what our guarantee covers: you can check all four before your deposit leaves your account. <a href="/uk-blue-staffy-puppy-buying-guide/">The UK Blue Staffy puppy buying guide</a> lists everything else worth asking a breeder, from the contract to support after collection.</p>
        <h4>{head('deposit', 4, 1, 0)}</h4>
        <p>Yes. Tell us which puppy you like and we confirm that nobody has reserved it before you pay anything.</p>
        <h4>{head('deposit', 4, 1, 1)}</h4>
        <p><a href="/uk-blue-staffy-breeders-contact/">Ask us for both parents' certificates</a> when you first write; they come to you privately, with the full terms of our guarantee, before any deposit.</p>
        <h5>{head('deposit', 5, 1, 1, 0)}</h5>
        <p>Our own vet. You are welcome to speak to the vet who looks after our dogs before you decide.</p>
        <h6>{head('deposit', 6, 1, 1, 0, 0)}</h6>
        <p>Yes. Ask and we pass on the details; the RCVS register confirms that any vet in the UK is registered to practise.</p>
      </div>
      <div class="mx-a">
        <h3>{head('deposit', 3, 2)}</h3>
        <BodyImage asset={photo('deposit-visit')} srcset={photo('deposit-visit').srcset} box="tall" />
        <p>Maggie with her litter, in the home where they were raised, by appointment, and you can ask us anything while you are here. <a href="https://www.rspca.org.uk/adviceandwelfare/pets/dogs/puppy">Advice on buying a puppy from a breeder</a> from the RSPCA says to see the mother and her puppies together, and the visit is where you do exactly that.</p>
        <h4>{head('deposit', 4, 2, 0)}</h4>
        <p>At the visit, once you have met both parents and looked through their papers and the vet records. <a href="#enquiry">Tell us which puppy you would like to visit</a>, and we will find a time.</p>
      </div>
    </div>
  </section>

  {/* ── G4 · health and raising (outline row 9) ── */}
  <section id="health-tests" data-section-label={label('health-tests')} class="mx-chapter">
    <CityOffsetSheet heading={label('health-tests')} asset={photo('health-tests-h2')}
      rows={[
        { t: 'Named tests on both parents', d: `${TEST_A} and ${TEST_B}, with eye and elbow screening.` },
        { t: 'The parents', d: 'Maggie, our dam, and Jones, our sire.' },
        { t: 'Where the litter grew up', d: `${sign('Raised in our home')} in ${TOWN}.` },
      ]}>
      <Fragment slot="lede">Maggie and Jones both had the {TEST_A} and {TEST_B} tests, and eye and elbow screening, before this litter was planned. Their papers come to you privately once you write; this page prints none of them.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('health-tests', 3, 0)}</h3>
        <BodyImage asset={photo('health-tests-dna')} srcset={photo('health-tests-dna').srcset} box="uniform" focal="50% 40%" />
        <p>Because the condition is recessive, a puppy can only develop it by inheriting the faulty gene from its mother and its father alike, which is why both parents are tested before a litter is planned rather than after it.</p>
        <p>L-2-HGA is a neurological disorder affecting metabolism; HC-HSF4 is an inherited cataract. <a href="/blue-staffy-health-uk/">How L-2-HGA and HC-HSF4 pass from parent to puppy</a> is on our health page.</p>
        <h4>{head('health-tests', 4, 0, 0)}</h4>
        <p>Eye screening for hereditary cataracts and other inherited eye disease, and elbow screening, on both parents. <a href="https://www.bva.co.uk/canine-health-schemes/eye-scheme/">Hereditary eye disease screening by veterinary ophthalmologists</a> is what the BVA's eye scheme explains.</p>
        <h5>{head('health-tests', 5, 0, 0, 0)}</h5>
        <p>Because a paper posted online can be copied onto any dog in an advert, so we keep ours for buyers who write to us.</p>
        <h6>{head('health-tests', 6, 0, 0, 0, 0)}</h6>
        <p><a href="https://www.royalkennelclub.com/search/breeds-a-to-z/breeds/terrier/staffordshire-bull-terrier/">The breed's pre-breeding health screening list</a> sits on the Kennel Club's own Staffordshire Bull Terrier page.</p>
      </div>
      <div class="mx-a">
        <h3>{head('health-tests', 3, 1)}</h3>
        <BodyImage asset={photo('health-tests-home')} srcset={photo('health-tests-home').srcset} box="uniform" />
        <p>Indoors with us, never in kennels, among the people, cats and everyday noise of a busy family house.</p>
        <p>They meet household sounds, visitors and our cats long before they meet yours, with constant company and early socialisation from people of every age. By the time they leave, each one is used to car journeys, other dogs and being picked up and looked over. <a href="/blue-staffy-uk-breeders/">The home our puppies grow up in</a> is described on our breeder page.</p>
        <h4>{head('health-tests', 4, 1, 0)}</h4>
        <p>We follow both with every litter: short, gentle handling and a steady run of new sights, sounds and people through the first weeks.</p>
        <h4>{head('health-tests', 4, 1, 1)}</h4>
        <p>Used to people of every age, cats, other dogs, household noise and the car. Each puppy's own character is written on its page of our listing.</p>
      </div>
    </div>
  </section>

  {/* ── G2 · the litter and its prices (outline row 10) ── */}
  <section id="litter" data-section-label={label('litter')} class="mx-chapter">
    <CityOffsetSheet heading={label('litter')} asset={photo('litter-h2')}
      rows={[
        { t: `Each of our ${BOYS} boys`, d: `${BOY_PRICE}.` },
        { t: `Each of our ${GIRLS} girls`, d: `${GIRL_PRICE}.` },
        { t: 'The coats in this litter', d: `${list(COATS).charAt(0).toUpperCase()}${list(COATS).slice(1)}.` },
      ]}>
      <Fragment slot="lede">This litter is {LITTER} Staffordshire Bull Terrier puppies for sale, {BOYS} boys and {GIRLS} girls, and any of them can come home to {AREA}. The price follows the sex alone, and it carries the parents' papers, the puppy's own folder of records and our {GUARANTEE}.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('litter', 3, 0)}</h3>
        <BodyImage asset={photo('litter-prices')} srcset={photo('litter-prices').srcset} box="uniform" focal="50% 35%" />
        <p>Because in this litter we set one figure for a boy and one for a girl, and the coat changes neither.</p>
        <p>A white or part-white puppy costs what a solid blue one does, so you can choose on health, character and how the puppy fits your home rather than on its colour. Each puppy's price sits beside its photo below, and the table lists only the puppies nobody has reserved, so a row that has gone is a puppy that has found its home.</p>
        <CityPhotoShelf heading={head('litter', 4, 0, 0)} as="h4" caption={(outline.sections.find((s) => s.table) as { table: { caption: string } }).table.caption}
          city={MANCHESTER} shownAbove={pups.map((p) => p.name)} />
        <p>Our regularly updated listing shows the same puppies; one still showing there is unreserved.</p>
        <p class="mx-act"><a class="mx-cta" href="#enquiry">Ask us which puppy suits your home</a></p>
        <h5>{head('litter', 5, 0, 0, 0)}</h5>
        <p>No, never in this litter. <a href={`/available-puppies/${BYRD.slug}/`}>Byrd, our solid white boy</a>, is {priceFor(BYRD)}, the same as his blue brothers.</p>
        <h6>{head('litter', 6, 0, 0, 0, 0)}</h6>
        <p>Not necessarily: this rule describes this litter only, and the next one will carry its own prices.</p>
      </div>
      <div class="mx-a">
        <h3>{head('litter', 3, 1)}</h3>
        <BodyImage asset={photo('litter-parents')} srcset={photo('litter-parents').srcset} box="uniform" focal="50% 50%" />
        <p>Maggie, our dam, and Jones, our sire, are the parents of all {LITTER}, and you meet them both at your visit.</p>
        <p>Seeing the parents tells you more about a puppy's likely build and nature than any photograph can, which is why both of them are here for you to see. Ask to look through their registration papers while you are with us, as every buyer should.</p>
        <h4>{head('litter', 4, 1, 0)}</h4>
        <p>Yes. Maggie and Jones are both Kennel Club registered, and we give you both registration numbers to check the pedigree.</p>
      </div>
    </div>
  </section>

  <CityThreePlates id="review-middle" data-section-label={label('review-middle')} name="Mark J"
    photo="jones-strong-staffy-sire-temperament.webp" photoAlt={frameAlt('review-middle', 'jones-strong-staffy-sire-temperament.webp')}
    side="end" credit="Photo: Jones, the sire of this litter" />

  <CityRowsBesideAPhoto id="faq-middle" data-section-label={label('faq-middle')} block={faqHealth.key} heading={faqHealth.heading}
    items={faqHealth.items} side="start" photo={BYRD.card_photo} photoAlt={puppyAlt(BYRD, 'short')}
    caption={`${BYRD.name}, one of our ${BOYS} boys`}
    lede="Health, vaccinations and what a good breeder lets you see, answered the way we work.">
    <p><a href="/buy-staffy-puppies-for-sale-uk/">How we compare with a classified puppy advert</a> is set out point by point on our Staffy puppies page.</p>
  </CityRowsBesideAPhoto>

  {/* ── G3 · travel to Greater Manchester (outline row 13) ── */}
  <section id="travel" data-section-label={label('travel')} class="mx-chapter">
    <CityOffsetSheet heading={label('travel')} asset={photo('travel-h2')}
      rows={[
        { t: 'Home delivery', d: `${DELIVERY_BAND} by ${transportName}, ${pricedBy}.` },
        { t: 'Collection', d: `From our home in ${TOWN}, by appointment.` },
      ]}>
      <Fragment slot="lede">By {transportName} to your door in {AREA}, for {DELIVERY_BAND} {pricedBy}, or by car from our home in {TOWN}. Either way, your puppy travels after the viewing your deposit books.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('travel', 3, 0)}</h3>
        <BodyImage asset={photo('travel-priced')} srcset={photo('travel-priced').srcset} box="uniform" focal="50% 40%" />
        <p>By distance, as anywhere in the UK: Salford, Stockport, Bolton, Wigan and Rochdale all sit inside the {DELIVERY_BAND} band, and your figure depends on how far you are from {TOWN}.</p>
        <p>The band covers the whole of the UK, so no home in {AREA} pays outside it, whichever borough you live in, and every route is by {transportName}.</p>
        <h4>{head('travel', 4, 0, 0)}</h4>
        <p>{transportName.charAt(0).toUpperCase()}{transportName.slice(1)} carries your puppy, working to the government's rules for moving animals rather than rules of our own.</p>
        <h5>{head('travel', 5, 0, 0, 0)}</h5>
        <p>Both depend on a transport booking made after your viewing, and we would rather give you no date than a wrong one.</p>
        <h6>{head('travel', 6, 0, 0, 0, 0)}</h6>
        <p>In its guidance on the welfare of dogs and cats in transport, published on gov.uk.</p>
      </div>
      <div class="mx-a">
        <h3>{head('travel', 3, 1)}</h3>
        <BodyImage asset={photo('travel-collect')} srcset={photo('travel-collect').srcset} box="uniform" />
        <p>Neither suits every family. Collecting means your puppy spends its first miles beside you after you have met us, while delivery saves you the drive north and back and brings the puppy to your own front door.</p>
        <p>Either way the puppy has been seen by you first, and collection is from our home in {TOWN}. If you collect, plan the day so that you have time with the puppy before the drive home.</p>
        <h4>{head('travel', 4, 1, 0)}</h4>
        <p>Yes. Visits here are by appointment only, so collection day is booked with you just as the viewing is.</p>
        <p><a href="/uk-locations/staffy-puppies-for-sale-liverpool/">Liverpool buyers</a> choose between the same two routes. <a href="/uk-locations/blue-staffy-puppies-south-yorkshire/">Our South Yorkshire page</a> covers the county to the east. <a href="/uk-locations/blue-staffies-newcastle-under-lyme/">Readers in Newcastle-under-Lyme</a> have a page of their own. <a href="/uk-locations/blue-staffy-puppies-for-sale-leeds/">Families in Leeds</a> do too. <a href="/uk-locations/blue-staffy-puppies-york/">York households</a> pay within the same band. <a href="/uk-locations/">Every other UK city on our list</a> is one click away.</p>
        <p><a href="#enquiry">Tell us whether you will collect or want delivery</a>, and we will plan the rest around your puppy.</p>
      </div>
    </div>
  </section>

  {/* ── paperwork (outline row 14, extra section 1) ── */}
  <section id="papers" data-section-label={label('papers')} class="mx-chapter">
    <CityOffsetSheet heading={label('papers')} asset={photo('papers-h2')}
      rows={[
        { t: 'In the folder', d: `${list(PAPERS.map((p, i) => (i ? lcFirst(p) : p)))}.` },
        { t: 'Also in writing', d: "A puppy purchase contract, and both parents' registration numbers." },
      ]}>
      <Fragment slot="lede">Each of our puppies leaves with a folder of its own records, the papers that show where it came from and what has been done for it so far. Below is what to expect in that folder, and what to ask any seller for.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('papers', 3, 0)}</h3>
        <BodyImage asset={photo('papers-checklist')} srcset={photo('papers-checklist').srcset} box="uniform"
          phone={papersPhone} />
        <p>Whoever you buy from, ask for both parents' registration numbers, the Kennel Club registration application form, the vaccination record, the microchip details and a written contract. Ours come with all five.</p>
        <p>Be wary of an advert that calls a puppy registered but cannot show you the parents' numbers: the numbers let you look up the pedigree yourself, and the application form lets you register the puppy in your name once it is home. The vaccination record matters too: it is the first thing your own vet will want to see.</p>
        <h4>{head('papers', 4, 0, 0)}</h4>
        <p>Because registering the puppy is your step to take: the form travels home with it so the registration is made in your name.</p>
        <h5>{head('papers', 5, 0, 0, 0)}</h5>
        <p>No. The parents are on the register, and each puppy leaves with the form it needs to join them.</p>
        <h6>{head('papers', 6, 0, 0, 0, 0)}</h6>
        <p>You do. Every puppy comes with its {lcFirst(sign('KC registration application form'))} so that you, the new owner, can register it yourself.</p>
      </div>
    </div>
  </section>

  {/* ── health (outline row 15, extra section 2) ── */}
  <section id="guarantee" data-section-label={label('guarantee')} class="mx-chapter">
    <CityOffsetSheet heading={label('guarantee')} asset={photo('guarantee-h2')}
      rows={[
        { t: 'What the breed is prone to', d: `${TEST_A} and ${TEST_B}, which run in families, and skin allergies.` },
        { t: guaranteeLabel(), d: 'In writing, with every puppy in this litter.' },
      ]}>
      <Fragment slot="lede">Mainly two inherited conditions and skin allergies, and our {GUARANTEE} is what we stand behind for every puppy in this litter. <a href="#health-tests">Both inherited conditions in the parents' screening</a> are covered further up, so this part turns to the skin.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('guarantee', 3, 0)}</h3>
        <BodyImage asset={photo('guarantee-itch')} srcset={photo('guarantee-itch').srcset} box="uniform" />
        <p>Usually because of their skin, which in this breed reacts readily to allergies; an itch that will not settle is worth a vet's opinion. <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC7510130/">Veterinary research on what Staffies are prone to</a> found higher odds of atopic dermatitis in the breed.</p>
        <h4>{head('guarantee', 4, 0, 0)}</h4>
        <p><a href="/blue-staffy-health-uk/">Our Blue Staffy health page</a> does, with the skin conditions Staffies see and what we look for in the parents.</p>
      </div>
      <div class="mx-a">
        <h3>{head('guarantee', 3, 1)}</h3>
        <BodyImage asset={photo('guarantee-cover')} srcset={photo('guarantee-cover').srcset} box="tall" />
        <p>Every puppy in this litter comes with it in writing. {guaranteeFact()}</p>
        <h4>{head('guarantee', 4, 1, 0)}</h4>
        <p>Yes, and we would like you to: the full terms go to anyone who asks, before any deposit is paid.</p>
      </div>
    </div>
  </section>

  <CityPostmarkedNote id="newsletter" data-section-label={label('newsletter')} area={AREA} puppy={VENNIE.name}
    photoAlt={frameAlt('newsletter', `/puppies/${VENNIE.slug}-${VENNIE.slug}.webp`)} />

  {/* ── G5 · life in a busy household (outline row 17) ── */}
  <section id="busy-household" data-section-label={label('busy-household')} class="mx-chapter">
    <CityOffsetSheet heading={label('busy-household')} asset={photo('household-h2')}
      rows={[
        { t: "On the government's list?", d: 'No. The Staffordshire Bull Terrier is not a banned breed.' },
        { t: 'Renting', d: 'Get the pet policy in writing before you sign.' },
      ]}>
      <Fragment slot="lede">Well, when someone has time for daily walks, training and company, because a Staffy is a people-focused dog rather than a guard. <a href="/blue-staffy-blog-guides/">Choosing the right puppy for your household</a> is where our guides begin.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('busy-household', 3, 0)}</h3>
        <BodyImage asset={photo('household-rented')} srcset={photo('household-rented').srcset} box="uniform" focal="50% 35%" />
        <p>It means the breed is not the obstacle. <a href="https://www.gov.uk/control-dog-public/banned-dogs">The dog types it is against the law to own in the UK</a> are listed by the government, and the Staffordshire Bull Terrier is not on that list. The list judges a dog by how it looks rather than by its breed name, so pedigree papers make the plainest case to a landlord.</p>
        <h4>{head('busy-household', 4, 0, 0)}</h4>
        <p>Yes, before you sign. A letting agent or housing association can still restrict a breed, and a written policy settles it.</p>
      </div>
      <div class="mx-a">
        <h3>{head('busy-household', 3, 1)}</h3>
        <BodyImage asset={photo('household-downsides')} srcset={photo('household-downsides').srcset} box="uniform" focal="50% 70%" />
        <p>A Staffy can be strong-willed and needs steady training, may chase small animals it did not meet young, and wants its people around for much of the day.</p>
        <p>None of those rules the breed out, but each asks something of a household: time to train, early introductions to the cat, and a routine that does not leave the dog alone for long stretches.</p>
        <h4>{head('busy-household', 4, 1, 0)}</h4>
        <p>Yes. Every litter grows up indoors with us and meets children, cats and older people before it leaves.</p>
      </div>
    </div>
  </section>

  {/* ── temperament (outline row 18, extra section 3) ── */}
  <section id="favourite-person" data-section-label={label('favourite-person')} class="mx-chapter">
    <CityOffsetSheet heading={label('favourite-person')} asset={photo('favourite-h2')}
      rows={[
        { t: 'Boy or girl', d: 'Upbringing shapes temperament more than sex does.' },
        { t: 'Who it bonds with', d: 'Often one main carer, and the whole family too.' },
      ]}>
      <Fragment slot="lede">Both, as a rule: a Staffordshire Bull Terrier often bonds closest with whoever feeds, walks and trains it, yet a well-socialised Staffy loves the whole house.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('favourite-person', 3, 0)}</h3>
        <BodyImage asset={photo('favourite-boisterous')} srcset={photo('favourite-boisterous').srcset} box="uniform" focal="50% 60%" />
        <p>Some are: boys can be more boisterous, girls a touch more independent, but upbringing and each puppy's own character count for more than sex, so meet the puppy rather than choose by the label alone.</p>
        <p>Every puppy in this litter has been raised the same way, in our home, so the difference you notice will be personality more than sex. <a href="#enquiry">Tell us whether you would like a boy or a girl</a>, and we will tell you which puppy fits.</p>
        <h4>{head('favourite-person', 4, 0, 0)}</h4>
        <p><a href="https://www.pdsa.org.uk/pet-help-and-advice/looking-after-your-pet/puppies-dogs/medium-dogs/staffordshire-bull-terrier">Staffordshire Bull Terrier exercise and care advice</a> from the PDSA puts an adult at an hour or more a day, ideally in two outings.</p>
      </div>
    </div>
  </section>

  {/* ── colour last (outline row 19) ── */}
  <section id="coat" data-section-label={label('coat')} class="mx-chapter">
    <CityOffsetSheet heading={label('coat')} asset={photo('coat-h2')}
      rows={[
        { t: 'In this litter', d: `${list(COATS).charAt(0).toUpperCase()}${list(COATS).slice(1)}, at one price per sex.` },
        { t: 'Lifespan', d: 'Twelve to fourteen years, whatever the coat.' },
      ]}>
      <Fragment slot="lede">Not by any figure we can give: the Royal Kennel Club breed standard lists blue, alone or with white, and states no rarity. <a href="https://www.royalkennelclub.com/search/breeds-a-to-z/breeds/terrier/staffordshire-bull-terrier/">The Kennel Club's Staffordshire Bull Terrier page</a> puts health and temperament before colour, so the coat comes last here.</Fragment>
    </CityOffsetSheet>
    <div class="mx-answers">
      <div class="mx-a">
        <h3>{head('coat', 3, 0)}</h3>
        <BodyImage asset={photo('coat-breed')} srcset={photo('coat-breed').srcset} box="uniform" focal="50% 60%" />
        <p>No. A blue coat makes no new breed: the dog is a Staffordshire Bull Terrier like every other colour. The Pit Bull Terrier is a different, banned type, and the AmStaff a separate, larger breed.</p>
        <h4>{head('coat', 4, 0, 0)}</h4>
        <p>The ancestors and the registry behind a dog, which is the surest way to tell English from American. Here that means Maggie's and Jones's papers.</p>
      </div>
      <div class="mx-a">
        <h3>{head('coat', 3, 1)}</h3>
        <BodyImage asset={photo('coat-years')} srcset={photo('coat-years').srcset} box="uniform" focal="50% 40%" />
        <p>The Staffordshire Bull Terrier Club puts a healthy, well cared for Staffy at twelve to fourteen years, and the coat plays no part in that.</p>
        <h4>{head('coat', 4, 1, 0)}</h4>
        <p>Food, daily exercise and regular visits to your own vet decide where in that range a dog lands.</p>
      </div>
    </div>
  </section>

  <CityThreePlates id="review-bottom" data-section-label={label('review-bottom')} name="Rachel L."
    photo="maggie-blue-staffy-dam-with-pups.webp" photoAlt={frameAlt('review-bottom', 'maggie-blue-staffy-dam-with-pups.webp')}
    side="start" credit="Photo: Maggie, our dam, with her pups" />

  <CityRowsBesideAPhoto id="faq-bottom" data-section-label={label('faq-bottom')} block={faqLife.key} heading={faqLife.heading}
    items={faqLife.items} side="end" photo="blue-staffy-puppy-preparation.webp"
    caption="A bed, a crate and two bowls, ready before a puppy comes home"
    lede="Everyday life with a Staffy, from time alone to a flat, in short answers.">
    <p><a href="/uk-staffordshire-bull-terrier-guide/">Our Staffordshire Bull Terrier guide for UK owners</a> goes further on each of these, from training to reputation.</p>
  </CityRowsBesideAPhoto>

  <CityPhotoAtTheEdge id="enquiry" data-section-label={enquiry} heading={enquiry}
    lede={`Tell us the puppy you have in mind, or simply a boy or a girl, and whether you would collect in ${TOWN} or want delivery. We confirm your puppy is still free before you pay anything.`}
    photo="lisa-bright-blue-staffy-breeder-carlisle.webp" photoAlt={frameAlt('enquiry', 'lisa-bright-blue-staffy-breeder-carlisle.webp')} />
</CityShell>
<style>
  /* The H3 answers under each body H2: page-local, on the site's tokens, at the city kit's type
     sizes for each tier (src/styles/city.css), so no heading is chunkier than the component's H2
     above it. Every body image sits in the uniform box straight after its heading (BodyImage). */
  .mx-answers { container-type: inline-size; max-width: 1160px; margin: 0 auto; padding: 0 var(--space-4) var(--space-7); }
  .mx-a { max-width: 760px; margin: 0 auto; padding-top: var(--space-6); border-top: 1px solid var(--color-border); }
  .mx-a + .mx-a { margin-top: var(--space-6); }
  .mx-a :is(h3, h4, h5, h6) { color: var(--color-brand); line-height: 1.25; text-wrap: balance; }
  .mx-a h3 { margin: 0 0 var(--space-4); font-family: var(--font-display); font-size: 19px; font-weight: 700; }
  .mx-a h4 { margin: var(--space-5) 0 var(--space-2); font-size: 17px; font-weight: 700; }
  .mx-a h5 { margin: var(--space-4) 0 var(--space-2); font-size: 16px; font-weight: 700; }
  .mx-a h6 { margin: var(--space-4) 0 var(--space-2); font-size: 15px; font-weight: 700; color: var(--color-ink-2); }
  .mx-a > p { margin: 0 0 var(--space-3); font-size: 16px; line-height: 1.6; max-inline-size: 65ch; text-wrap: pretty; color: var(--color-text); }
  .mx-a > :global(.bl-img), .mx-a > :global(.art-pic) { margin-bottom: var(--space-4); }
  .mx-a p a { color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; }
  .mx-a p a:hover { text-decoration-thickness: 2px; }
  .mx-a p a:focus-visible, .mx-cta:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .mx-a > :global(.city-photo-shelf) { margin: var(--space-4) 0; }
  .mx-act { margin: var(--space-4) 0 var(--space-5); }
  .mx-cta {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--space-6); border-radius: var(--btn-radius);
    background: var(--color-cta); color: var(--color-cta-ink); font-weight: 700; text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .mx-cta:hover { background: var(--color-cta-hover); }
  @container (width >= 640px) {
    .mx-a h3 { font-size: 20px; }
    .mx-a > p { font-size: 17px; }
  }
  @container (width >= 800px) {
    .mx-a h3 { font-size: 21px; }
  }
</style>
