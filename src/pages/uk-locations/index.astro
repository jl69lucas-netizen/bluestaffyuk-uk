---
import PageShell from '../../layouts/PageShell.astro';
import locationsJson from '../../../data/locations.json';
import { SITE, type LocationRow } from '../../lib/site';

const locations = locationsJson as LocationRow[];
/** Legacy Rank Math appended the brand to every title, in a few punctuation variants. */
const BRAND_SUFFIX = /\s*[|\-–]\s*(Blue\s*Staffy\s*UK|BlueStaffyUK)(:.*)?$/i;
const clean = (title: string) => {
  let t = title.trim();
  for (let next = t.replace(BRAND_SUFFIX, '').trim(); next !== t; next = t.replace(BRAND_SUFFIX, '').trim()) t = next;
  return t;
};
/** Small words stay lowercase unless they lead; tokens already in caps (UK) are left alone. */
const SMALL_WORDS = new Set(['for', 'in', 'of', 'and', 'the', 'a', 'an', 'at', 'to', 'on', 'with']);
const titleCase = (s: string) => s.replace(/\S+/g, (w, at: number) => {
  if (w === w.toUpperCase()) return w;
  if (at > 0 && SMALL_WORDS.has(w.toLowerCase())) return w.toLowerCase();
  return w.charAt(0).toUpperCase() + w.slice(1);
});
const label = (l: LocationRow) => titleCase(l.h1 || clean(l.title));

const sorted = [...locations].sort((a, b) =>
  a.city.localeCompare(b.city, 'en-GB') || a.slug.localeCompare(b.slug, 'en-GB'));

const description = 'Blue Staffy puppies for sale across the UK from Blue Staffy UK in Glasgow: home delivery by DEFRA-approved transport priced by distance, or collection in Glasgow.';
---
<PageShell title="Blue Staffy Puppies by UK Location | Blue Staffy UK" description={description} canonical="/uk-locations/">
  <section class="container container-text">
    <h1>Blue Staffy Puppies by UK Location</h1>
    <p>We are based in Glasgow. {SITE.delivery_note}, £{SITE.delivery_min_gbp} to £{SITE.delivery_max_gbp}, or collect from us in Glasgow after a refundable £{SITE.deposit_gbp} deposit. Choose your nearest area below.</p>
    <ul style="display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:8px 24px;list-style:none;padding:0">
      {/* `display:inline-block` with vertical padding is what lifts each link's box to 24px
          (`layout-tap-target-size`, blocking; WCAG 2.5.8): a bare link here is a 20px target
          with a neighbour well inside 24px of its centre, and at 375px the whole list is one
          column of them. */}
      {sorted.map((l) => <li><a href={`/uk-locations/${l.slug}/`} style="display:inline-block;padding-block:4px">{label(l)}</a></li>)}
    </ul>
  </section>
</PageShell>
