---
// src/pages/thank-you-blue-staffy-puppies-journey/index.astro — REBUILT from the approved
// board record (data/boards/thank-you-blue-staffy-puppies-journey.json, approved
// 2026-09-19). Hand-written and NOT regenerated by `npm run extract`: the slug is listed in
// data/facts/rebuilt.json, so `migration_parity.py` skips it and `facts_preserved_check.py`
// is its gate instead.
//
// Seven sections, in the record's order, each with the record's own id and heading. Five of
// them carry a style the breeder picked, and every one of those resolves through
// `pickedStyle()` → `boxClass()` — the same pair the board preview rendered them with, so
// the page cannot drift from the board they signed off. `while-you-wait` and `reach-us` are
// `standard` prose, which the record does not style.
//
// THE PROSE IS WRITTEN FRESH, in Lisa Bright's first person, from the record's outline. Not
// one sentence is pasted from the migrated body. Every fact in it comes from that body or
// from data/*.json: the confirmation itself, the 24-48 business hour reply window and the
// spam-or-junk-folder check, the reading list and its eight links, the £500 refundable
// deposit, the £200–£350 DEFRA-approved UK home delivery, the email address, the hours and
// Carlisle · Cumbria. What is NOT carried is in the record's `dropped`.
//
// TWO THINGS THE RECORD FORBIDS, AND THEY ARE ABSENT. There is no "come and meet the
// litter" step: neither the migrated body nor data/settings.json states a visit policy, so
// the page does not invent one (`brief.out_of_scope`, working rule 9). And no telephone
// number appears anywhere, because data/settings.json holds PHONE_PLACEHOLDER.
//
// H4-H6 ARE WRITTEN HERE, not in the record. The approved outline stops at the H3 the
// breeder read; the floor of five H5 and five H6 (rules/headings.md) is met by the page and
// `min-h5-h6` reads the built page for a rebuilt slug (spec §9 amendment 2). Levels descend
// with no skips, and the ladder sits in five of the seven sections. The H6 lines all open on
// the record's own `tuple.h6_prefixes` entry, "Next step:".
//
// EVERY HEADING RENDERS THROUGH `titleCase()` (spec §9 amendment 4b): the breeder approved
// the wording, and the case is presentation, fixed site-wide by rules/headings.md.
import PageShell from '../../layouts/PageShell.astro';
import Hero from '../../components/kit/Hero.astro';
import InfoCard from '../../components/kit/InfoCard.astro';
import PuppyCard from '../../components/kit/PuppyCard.astro';
import Testimonial from '../../components/kit/Testimonial.astro';
import Faq from '../../components/kit/Faq.astro';
import Button from '../../components/kit/Button.astro';
import { sectionsFromRecord } from '../../lib/sections';
import { pickedStyle, approvalInForce } from '../../lib/pickedStyle';
import { boxClass } from '../../lib/boardStyles';
import { titleCase as T } from '../../lib/headings';
import { loadFaq } from '../../lib/faq';
import { SITE, type PuppyRow } from '../../lib/site';
import puppiesJson from '../../../data/puppies.json';
import reviewsJson from '../../../data/reviews.json';
import record from '../../../data/boards/thank-you-blue-staffy-puppies-journey.json';

const path = '/thank-you-blue-staffy-puppies-journey/';
// The picked meta variants and H1, BY INDEX from the approval — never retyped here.
// `approvalInForce()`, not `record.approval`: these three are INDICES, and the record
// is back on the board for its hero and its counter (working rule 16) with its approval
// carried under `approval_previous`. What the page is called was never the question.
const approved = approvalInForce(record);
const title = record.meta_set.titles[approved.meta!.title];
const description = record.meta_set.descriptions[approved.meta!.description];
const h1 = record.h1.variants[approved.h1];

// The one image the migrated page carried, at its ORIGINAL path with its original alt
// (working rule 11). Both come from the record's `assets`, where the bake recorded them.
const family = record.assets.find((a) => a.slot === 'thank-you-family')!;

// The three FAQ rows this page owns, filtered by `source`: a row added to data/faq.json for
// another page can never appear here, and the three ids the record names cannot drift.
const faqs = loadFaq().filter(
  (r) => r.source === 'src/pages/thank-you-blue-staffy-puppies-journey/index.astro',
);

// The grid FILTERS on status rather than hard-coding a count (the approval's own note): all
// six rows are Available today, and the day one is reserved the grid is right without an edit.
const available = (puppiesJson as PuppyRow[]).filter((p) => p.status === 'Available');

// THE ONE REVIEW, BY THE NAME THE APPROVAL NAMES. The slot is `single` and the breeder chose
// data/reviews.json entry 1, The Victoria Family — the only one of the three that describes
// the process from first enquiry to bringing the puppy home, which is the stage this reader
// is at. Found by NAME rather than by index, so a row inserted above it cannot silently swap
// the quote, and `!` rather than a fallback because a review this page invented would be far
// worse than a build that stops. The slot is filled, so no REVIEW_PLACEHOLDER renders here.
const victoria = reviewsJson.find((r) => r.name === 'The Victoria Family')!;

const welcomeBox = boxClass(pickedStyle(record, 'welcome'));
const nextStepsBox = boxClass(pickedStyle(record, 'next-steps'));
// `owners` was picked S3, the reviews GRID arrangement — but the approval NOTE on that same
// section fixes the mode as `single` with one named review, and one review in a grid of one
// is a grid with nothing to compare. What S3 contributes is the bed and the column
// arrangement, and `boxClass` honours both; the MODE comes from the note, which is the
// sentence the breeder actually wrote.
const ownersBox = boxClass(pickedStyle(record, 'owners'));
const puppiesBox = boxClass(pickedStyle(record, 'puppies'));
const questionsBox = boxClass(pickedStyle(record, 'questions'));
// The `stats` counter is BOARDED and not yet BUILT. Working rule 16 put a counter strip on
// this record, and the page that renders it is the later task's; until then the section
// exists on the board and not in this body, and a dial link to an id the page does not
// carry is the dead anchor `nav-anchors-resolve` exists to block. The filter comes out in
// the same commit that adds the `<section id="stats">`.
const sections = sectionsFromRecord(record).filter((s) => s.id !== 'stats');
const email = SITE.email;
// "Mo-Su 09:00-23:00" as a sentence. The hours are data/settings.json's, not prose typed
// here, so a change to the setting reaches this line.
const hours = SITE.hours.replace('Mo-Su ', 'every day, ').replace('-', ' to ');
---
<PageShell
  title={title}
  description={description}
  canonical={path}
  ogType="article"
  robots="noindex, follow"
  sections={sections}
>
  {/* 01 — the confirmation. Hero in the picked style S3 (photo left of the copy, in a card),
      carrying the migrated photograph at its original path with its original alt. */}
  <section slot="hero" id="welcome" data-section-label="Thank you — we have your enquiry" class={welcomeBox}>
    <Hero
      as="h1"
      eyebrow={`Enquiry received · ${SITE.location_label}`}
      title={T(h1)}
      lede="Your message reached us, and I am glad you wrote. I am Lisa Bright, and every enquiry about a blue Staffy comes to me rather than to an inbox nobody reads."
      image={family.file}
      imageAlt={family.alt}
      imageWidth={family.w}
      imageHeight={family.h}
    />
    <p>
      I am writing your reply now. Below is what happens next, what is worth reading while
      you wait, and how to reach me if you need me sooner than that.
    </p>
  </section>

  {/* 02 — the four steps, in the picked style S3 (a rail of cards beside the heading). Each
      card is one node of the record's tree, and every figure in it is in the migrated body
      or in data/settings.json. */}
  <section id="next-steps" data-section-label="What happens next" class={nextStepsBox}>
    <div class="bl-head">
      <h2>{T('What happens next')}</h2>
      <p class="bl-lede">Four things happen next, in this order. The first is the one you are waiting on.</p>
    </div>
    <div class="bl-body">
      <div class="bl-cards">
        <InfoCard
          kind="fact"
          heading={T('We read and answer your message')}
          body="Every enquiry is read and answered personally, within 24-48 business hours. If nothing has arrived by the end of that window, look in your spam or junk folder before writing again — that is where a first reply usually is."
        />
        <InfoCard
          kind="fact"
          heading={T('We talk about your home')}
          body="My reply picks up whatever you have already told me about your household, and asks about the rest: your hours, your garden, children, and any other dog."
        />
        <InfoCard
          kind="fact"
          heading={T('A deposit reserves your puppy')}
          body="Once you have chosen, a refundable deposit of £500 holds that puppy for you and takes them off the list."
        />
        <InfoCard
          kind="fact"
          heading={T('Your puppy comes home')}
          body="Home delivery by DEFRA-approved transport, priced by distance, between £200 and £350."
        />
      </div>
      <h4>{T('The Four Steps Are in Order')}</h4>
      <p>The reply comes first, and nothing after it happens before it has.</p>
      <h5>{T('The Conversation Comes Before the Deposit')}</h5>
      <p>Step two is your home; step three is the £500 that reserves a puppy.</p>
      <h6>{T('Next step: Read the Reply, Then Answer It')}</h6>
      <p>It will ask about your household, which is where step two begins.</p>
    </div>
  </section>

  {/* 03 — the reading list. `standard` with no pick: prose is prose. The eight links are the
      record's own, carried over from the migrated body. */}
  <section id="while-you-wait" data-section-label="While you wait">
    <h2>{T('While you wait')}</h2>
    <p>Plenty here is worth reading while I write back.</p>

    <h3>{T('What to read first')}</h3>
    <p>
      The <a href="/uk-staffordshire-bull-terrier-guide/">Staffy breed guide</a> covers
      temperament and what the breed needs. The
      <a href="/blue-staffy-health-uk/">health and care of blue Staffies</a> sets out what
      stands behind a litter, and the
      <a href="/uk-blue-staffy-puppy-buying-guide/">puppy buying guide</a> walks through
      choosing well.
    </p>

    <h3>{T('Where to look next')}</h3>
    <p>
      The <a href="/blue-staffy-blog-guides/">blog guides for new owners</a> go further,
      <a href="/">the home page</a> gathers it all, and
      <a href="/uk-locations/blue-staffy-puppies-uk/">our UK puppy locations</a> show where
      our puppies have gone. Off site: the
      <a href="https://www.thekennelclub.org.uk/dog-breeding/dog-breeding-regulations/" target="_blank" rel="noopener noreferrer">responsible breeding guidelines from The Kennel Club</a>
      and <a href="https://www.gov.uk/bring-pet-to-great-britain" target="_blank" rel="noopener noreferrer">the official UK pet travel scheme</a>.
    </p>
    <h4>{T('Read Them in Any Order')}</h4>
    <p>The pages above stand on their own, and the reply is being written either way.</p>
    <h5>{T('Bring a Question Back With You')}</h5>
    <p>Anything one of those pages leaves open is worth putting in your next message.</p>
    <h6>{T('Next step: Note What You Want Asked')}</h6>
    <p>A written-down question is easier to answer than a remembered one.</p>
  </section>

  {/* 04 — one review, in the picked bed S3, mode `single` per the approval note. */}
  <section id="owners" data-section-label="From a family who waited too" class={ownersBox}>
    <div class="bl-head">
      <h2>{T('From a family who waited too')}</h2>
      <p class="bl-lede">One review, from a family who started where you are: an enquiry, and a wait.</p>
    </div>
    <div class="bl-body">
      <Testimonial mode="single" reviews={[victoria]} />
      <h3>{T('Why this one is here')}</h3>
      <p>
        Of the three reviews we hold, this is the one that describes the whole of it — the
        first message, the wait, and bringing her home.
      </p>
      <h4>{T('Three Reviews, Not Thirty')}</h4>
      <p>Three families have written to us, and all three are quoted on this site.</p>
      <h5>{T('Each One Is Named')}</h5>
      <p>This one is The Victoria Family, in Manchester; the other two name themselves too.</p>
      <h6>{T('Next step: Say What It Leaves Open')}</h6>
      <p>Whatever a review does not answer is a good line for your reply.</p>
    </div>
  </section>

  {/* 05 — the available puppies, in the picked style S3 (a scrolling rail on a band). The
      grid filters data/puppies.json on status. */}
  <section id="puppies" data-section-label="The puppies looking for a home" class={puppiesBox}>
    <div class="bl-head">
      <p class="bl-eyebrow">Available now</p>
      <h2>{T('The puppies looking for a home')}</h2>
      <p class="bl-lede">
        These are the puppies who are here today. If one of them is the reason you wrote,
        say so and I will tell you exactly where they stand.
      </p>
    </div>
    <div class="bl-body">
      <div class="bl-cards">
        {available.map((p) => <PuppyCard slug={p.slug} />)}
      </div>
      <p>
        Every one of them is on the page for anyone looking to
        <a href="/buy-blue-staffy-puppies-uk/">buy Staffy puppies in the UK</a>.
      </p>
      <h4>{T('A Card Is Not a Reservation')}</h4>
      <p>A puppy shown here is still available; a deposit is what changes that.</p>
      <h5>{T('Reserved Puppies Come Off This Grid')}</h5>
      <p>The list is the live one, so what you can see is what is left.</p>
      <h6>{T('Next step: Name the Puppy in Your Reply')}</h6>
      <p>It saves an exchange, and it tells me what you are drawn to.</p>
    </div>
  </section>

  {/* 06 — the fallback. `standard` with no pick. No telephone is rendered: data/settings.json
      holds PHONE_PLACEHOLDER, and a placeholder must never reach a page. */}
  <section id="reach-us" data-section-label="If you need us sooner">
    <h2>{T('If you need us sooner')}</h2>
    <p>Two ways, and both of them come to me.</p>

    <h3>{T('Where to write')}</h3>
    <p>
      Write straight to {email}, or use
      <a href="/uk-blue-staffy-breeders-contact/">the contact page</a> if you would rather
      send a form. Both of them reach me.
    </p>

    <h3>{T('When messages are read')}</h3>
    <p>
      We read messages {hours}, from {SITE.location_label}. Whatever you sent us is handled
      the way <a href="/privacy-policy-uk/">our privacy policy</a> describes, and nowhere else.
    </p>
    <p><Button kind="primary" href="/uk-blue-staffy-breeders-contact/" label="Write to us" /></p>
    <h4>{T('Writing Again Is Fine')}</h4>
    <p>Following up rather than waiting is fine, as the questions below say.</p>
    <h5>{T('Messages Are Read Late')}</h5>
    <p>The inbox is read until 23:00, seven days a week.</p>
    <h6>{T('Next step: Check Spam or Junk First')}</h6>
    <p>Look there before writing again, which is what the first step above asks.</p>
  </section>

  {/* 07 — the FAQ, in the picked style S3 (accordion in a card with a jump list beside it).
      The three rows are the ones data/faq.json sources to this page; the record names the
      same three ids. */}
  <section id="questions" data-section-label="Questions people ask after writing to us" class={questionsBox}>
    <div class="bl-head">
      <h2>{T('Questions people ask after writing to us')}</h2>
      <p class="bl-lede">
        Three things people write back to ask in the days after an enquiry, each of them
        answered above as well as here.
      </p>
    </div>
    <div class="bl-body">
      <Faq items={faqs} />
    </div>
    <aside class="bl-aside">
      <p class="bl-eyebrow">In this section</p>
      <ul>
        <li>How long a reply takes</li>
        <li>What to read while you wait</li>
        <li>How to follow up</li>
      </ul>
    </aside>
  </section>
</PageShell>
