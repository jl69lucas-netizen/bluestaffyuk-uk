const meta = {"title": "UK Blue Staffy Breeders Contact | #1 Perfect Link To BlueStaffyUK", "description": "Have questions about our KC-registered Blue Staffy puppies? Get in touch with trusted UK Blue Staffy breeders contact, BlueStaffyUK today.", "canonical": "/uk-blue-staffy-breeders-contact/", "robots": "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large", "ogType": "article", "h1": "UK Blue Staffy Breeders Contact: Speak to Glasgow’s Trusted Family Breeders", "schema": [{"@context": "https://schema.org", "@graph": [{"@type": "Place", "@id": "/#place", "geo": {"@type": "GeoCoordinates", "latitude": "55.89156009856655", "longitude": " 4.256577523749512"}, "hasMap": "https://www.google.com/maps/search/?api=1&amp;query=55.89156009856655, 4.256577523749512", "address": {"@type": "PostalAddress", "streetAddress": "40 Coltmuir Street", "addressRegion": "Glasgow", "postalCode": "G22 6LU", "addressCountry": "United Kingdom"}}, {"@type": "ImageObject", "@id": "/images/uk-blue-staffy-breeders-contact-form-support.webp", "url": "/images/uk-blue-staffy-breeders-contact-form-support.webp", "width": "200", "height": "200", "inLanguage": "en-GB"}, {"@type": "ContactPage", "@id": "/uk-blue-staffy-breeders-contact/#webpage", "url": "/uk-blue-staffy-breeders-contact/", "name": "UK Blue Staffy Breeders Contact | #1 Perfect Link To BlueStaffyUK", "datePublished": "2025-05-28T10:53:28+00:00", "dateModified": "2025-06-03T14:03:03+00:00", "primaryImageOfPage": {"@id": "/images/uk-blue-staffy-breeders-contact-form-support.webp"}, "inLanguage": "en-GB"}]}]};
const body = "<div class=\"wp-block-uagb-container uagb-block-fjehgnh6 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-image alignleft uagb-block-kq42hvzi wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-left\"><figure class=\"wp-block-uagb-image__figure\"><img alt=\"Staffy breeder in UK assisting a family with a blue puppy enquiry | UK Blue Staffy Breeders Contact\" decoding=\"async\" fetchpriority=\"high\" height=\"500\" loading=\"lazy\" sizes=\"(max-width: 800px) 100vw, 760px\" src=\"/images/uk-blue-staffy-breeders-contact-form-support.webp\" srcset=\"/images/uk-blue-staffy-breeders-contact-form-support.webp 500w\" width=\"500\"/></figure></div>\n<div class=\"wp-block-uagb-container uagb-block-lyttrqsu\">\n<div class=\"wp-block-uagb-info-box uagb-block-wsxushiv uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-top\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"><h1 class=\"uagb-ifb-title\"><strong>UK Blue Staffy Breeders Contact: Speak to Glasgow’s Trusted Family Breeders</strong></h1></div><div class=\"uagb-ifb-desc\">\n<p>Whether you’re ready to reserve a puppy or need more information, our family-run breeding team in Glasgow is here to help. Connect with <a href=\"/blue-staffy-uk-breeders/\" rel=\"noreferrer noopener\" target=\"_blank\">ethical UK Blue Staffy breeders</a> today.</p>\n</div></div></div>\n</div>\n</div></div>\n<div class=\"wp-block-uagb-container uagb-block-fhwwrn1o alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-info-box uagb-block-gyc5nlvr uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-top\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"><h2 class=\"uagb-ifb-title\">Get Expert Help &amp; Puppy Availability Updates: UK Blue Staffy Breeders Contact Form</h2></div></div></div>\n<div class=\"wp-block-uagb-container uagb-block-hv1jsrth\">\n<div class=\"wp-block-uagb-info-box uagb-block-phq7fmuh uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-top\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"></div><p class=\"uagb-ifb-desc\">We’re thrilled you’re considering a <strong>Blue Staffy</strong> for your family! Whether you have questions about our <strong>Staffordshire Bull Terrier breeding dogs</strong>, current <strong>puppy availability</strong>, or ethical breeding practices, we’re here to help. Reach out to our friendly team today – we’re always happy to chat!</p></div></div>\n<div class=\"wp-block-uagb-info-box uagb-block-hp3624eb uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-top\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"><h3 class=\"uagb-ifb-title\">Send Us a Message</h3></div><div class=\"uagb-ifb-desc\">\n<p>The easiest way to get in touch is by using our quick online form below. Please provide as much detail as possible so we can assist you effectively and help you find your perfect companion. We aim to respond to all emails and calls within <strong>24-48 business hours</strong>. Your patience is appreciated as we give every inquiry our full attention.</p>\n</div></div></div>\n</div>\n</div></div>\n<div class=\"wp-block-uagb-container uagb-block-0nilffsm alignfull uagb-is-root-container\" id=\"contact-now\"><div class=\"uagb-container-inner-blocks-wrap\"> <div class=\"wp-block-uagb-container alignfull uagb-is-root-container bsuk-contact-form-wrap\">\n<div class=\"bsuk-form-card\">\n<div class=\"bsuk-form-header\">\n<h2>🐾 Reserve Your Blue Staffy Puppy</h2>\n<p>Fill in your details below and we'll be in touch within 24 hours</p>\n</div>\n<div class=\"bsuk-form-body\">\n<div class=\"bsuk-form-notice\">⏰ <strong>Delivery Note:</strong> Delivery begins 24–48 hours after payment confirmation. Train station pickup is our default method (free).</div>\n</div>\n</div>\n</div>\n</div></div>\n<div class=\"wp-block-uagb-container uagb-block-jhvvdvfa alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\">\n<div class=\"wp-block-uagb-info-box uagb-block-anf4oxde uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-top\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"><h2 class=\"uagb-ifb-title\">Our Location (By Appointment Only)</h2></div><div class=\"uagb-ifb-separator\"></div></div></div>\n<div class=\"wp-block-uagb-container uagb-block-nbqqgskk\">\n<div class=\"wp-block-uagb-info-box uagb-block-ye8mo4vk uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-top\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"><p class=\"uagb-ifb-title\">While we don’t operate a walk-in facility, our <strong>Staffy breeding dogs</strong> are lovingly raised in a secure, family environment near <strong>Glasgow, Scotland</strong>. Visits are strictly by appointment only to ensure the safety and well-being of our puppies and adult dogs.</p></div><div class=\"uagb-ifb-desc\">\n<p>We proudly adhere to ethical breeding standards. You can learn more about our commitment and <strong><a href=\"/uk-locations/staffy-breeding-dogs-glasgow/\" rel=\"noreferrer noopener\" target=\"_blank\">meet our Blue Staffy breeders</a></strong> on our dedicated page. We can also discuss UK-wide and international puppy transport options, including compliant DEFRA pet transport solutions for safe delivery.</p>\n</div></div></div>\n<div class=\"wp-block-uagb-container uagb-block-rexv8auk\">\n<div class=\"wp-block-uagb-info-box uagb-block-y07fbkqc uagb-infobox__content-wrap uagb-infobox-icon-left-title uagb-infobox-left uagb-infobox-image-valign-middle\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-left-title-image\"><div class=\"uagb-ifb-icon-wrap\"><div class=\"uagb-iconbox-icon-wrap uagb-infobox-shape-circle\"><svg viewbox=\"0 0 448 512\" xmlns=\"https://www.w3.org/2000/svg\"><path d=\"M438.6 105.4C451.1 117.9 451.1 138.1 438.6 150.6L182.6 406.6C170.1 419.1 149.9 419.1 137.4 406.6L9.372 278.6C-3.124 266.1-3.124 245.9 9.372 233.4C21.87 220.9 42.13 220.9 54.63 233.4L159.1 338.7L393.4 105.4C405.9 92.88 426.1 92.88 438.6 105.4H438.6z\"></path></svg></div></div><div class=\"uagb-ifb-title-wrap\"><h3 class=\"uagb-ifb-title\">Looking for More Info?</h3></div></div><div class=\"uagb-ifb-desc\">\n<p>While you wait for our reply, explore our comprehensive resources to learn more about the <strong><a href=\"/uk-staffordshire-bull-terrier-guide/\" rel=\"noreferrer noopener\" target=\"_blank\">Staffordshire Bull Terrier breed guide</a></strong>, our rigorous <strong><a href=\"/blue-staffy-health-uk/\" rel=\"noreferrer noopener\" target=\"_blank\">Blue Staffy health information</a></strong>, and what it takes to welcome a Staffy into your home.</p>\n</div><div class=\"uagb-ifb-separator\"></div></div></div>\n<div class=\"wp-block-uagb-info-box uagb-block-kzmqrdk8 uagb-infobox__content-wrap uagb-infobox-icon-above-title uagb-infobox-image-valign-middle\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-title-wrap\"></div><div class=\"uagb-ifb-desc\">\n<p>Want to see who’s currently looking for a home? <strong><a href=\"/buy-blue-staffy-puppies-uk/\" rel=\"noreferrer noopener\" target=\"_blank\">Buy Blue Staffy Puppies UK</a></strong>.</p>\n</div><div class=\"uagb-ifb-separator\"></div></div></div>\n<div class=\"wp-block-uagb-info-box uagb-block-6aavuvw3 uagb-infobox__content-wrap uagb-infobox-icon-left-title uagb-infobox-left uagb-infobox-image-valign-middle\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-left-title-image\"><div class=\"uagb-ifb-title-wrap\"></div></div><div class=\"uagb-ifb-desc\">\n<p>Dive deeper into Staffy ownership tips and advice with our helpful <strong><a href=\"/blue-staffy-blog-guides/\" rel=\"noreferrer noopener\" target=\"_blank\">Blue Staffy blog guides</a></strong> for new owners.</p>\n</div><div class=\"uagb-ifb-separator\"></div></div></div>\n<div class=\"wp-block-uagb-info-box uagb-block-19fde792 uagb-infobox__content-wrap uagb-infobox-icon-left-title uagb-infobox-left uagb-infobox-image-valign-middle\"><div class=\"uagb-ifb-content\"><div class=\"uagb-ifb-left-title-image\"><div class=\"uagb-ifb-title-wrap\"></div></div><div class=\"uagb-ifb-desc\">\n<p>Learn about <a href=\"https://www.thekennelclub.org.uk/media-centre/2025/january/responsible-breeding-bolstered-by-new-registrations-structure/\" rel=\"noreferrer noopener\" target=\"_blank\">The Kennel Club Assured Breeder Scheme</a></p>\n<p>Your privacy is important to us. Rest assured, all information shared is handled with care. Read our <a href=\"/privacy-policy-uk/\" rel=\"noreferrer noopener\" target=\"_blank\">Privacy Policy</a> for full details.</p>\n</div><div class=\"uagb-ifb-separator\"></div></div></div>\n</div>\n</div>\n</div></div>\n";
