---
// src/pages/uk-blue-staffy-breeders-contact/index.astro — REBUILT from the approved board
// record (data/boards/uk-blue-staffy-breeders-contact.json, approved 2026-09-19).
// Hand-written and NOT regenerated by `npm run extract`: the slug is listed in
// data/facts/rebuilt.json, so `migration_parity.py` skips it and `facts_preserved_check.py`
// is its gate instead.
//
// THE RECORD HAS ELEVEN ENTRIES AND THE PAGE HAS EIGHT SECTIONS. The last three —
// `desktop-dial`, `mobile-sections`, `mobile-strip` — are not sections of this page at all:
// they are the chrome the breeder settled on this board for the whole rebuild (dial S2,
// sheet S2, strip S2), already baked into PageDial, SectionSheet and SectionStrip. They are
// filtered out of the dial's own list below, because a jump link to a section that does not
// exist is a dead anchor and `nav-anchors-resolve` is blocking.
//
// THE PROSE IS WRITTEN FRESH, in Lisa Bright's first person, from the record's outline. Not
// one sentence is pasted from the migrated body. Every fact comes from that body or from
// data/*.json: the one enquiry form and that it is the easiest route, "as much detail as
// possible", the 24-48 business hour reply window, the no-walk-in / by-appointment-only
// policy, the email address, the hours, Carlisle · Cumbria, the four social accounts, and
// the two links the migrated body made outward. What is NOT carried is in the record's
// `dropped`: the legacy Place schema's street, postcode and coordinates (they name a city
// the business has left — Known Issue 16), the link to that city's page, and the old form
// card's free-station-pickup notice, which no file on disk supports.
//
// NO TELEPHONE. data/settings.json holds PHONE_PLACEHOLDER, so no number is rendered here,
// the LocalBusiness node omits `telephone`, and `phone_in_footer` stays the site-wide
// project-6 baseline row it is on every other page.
//
// ONE FORM. `ContactFormKit` with its default `idPrefix`: the field contract
// (name, email, phone, location, puppy, message, the `_gotcha` honeypot and the two hidden
// fields) is what scripts/form_contract_audit.py measures, and a second form would be a
// second place an enquiry can be lost.
//
// H4-H6 ARE WRITTEN HERE, not in the record (spec §9 amendment 2): the approved outline
// stops at the H3 the breeder read, and the floor of five H5 and five H6 is met by the
// page, with the ladder in five of the eight sections. The H6 lines all open on the
// record's own `tuple.h6_prefixes` entry, "What to send:". Every heading renders through
// `titleCase()` (amendment 4b) — approved wording, site-wide case.
import PageShell from '../../layouts/PageShell.astro';
import Hero from '../../components/kit/Hero.astro';
import CounterStrip from '../../components/kit/CounterStrip.astro';
import InfoCard from '../../components/kit/InfoCard.astro';
import TrustStrip from '../../components/kit/TrustStrip.astro';
import Testimonial from '../../components/kit/Testimonial.astro';
import ContactFormKit from '../../components/kit/ContactFormKit.astro';
import Faq from '../../components/kit/Faq.astro';
import { sectionsFromRecord } from '../../lib/sections';
import { pickedStyle, approvalInForce } from '../../lib/pickedStyle';
import { boxClass } from '../../lib/boardStyles';
import { titleCase as T } from '../../lib/headings';
import { loadFaq } from '../../lib/faq';
import { countedFigures, type StatRow } from '../../lib/recordText';
import { SITE, abs } from '../../lib/site';
import reviewsJson from '../../../data/reviews.json';
import record from '../../../data/boards/uk-blue-staffy-breeders-contact.json';

const path = '/uk-blue-staffy-breeders-contact/';
// The picked meta variants and H1, BY INDEX from the approval — never retyped here.
// `approvalInForce()`, not `record.approval`: these three are INDICES, and the record
// is back on the board for its hero and its counter (working rule 16) with its approval
// carried under `approval_previous`. What the page is called was never the question.
const approved = approvalInForce(record);
const title = record.meta_set.titles[approved.meta!.title];
const description = record.meta_set.descriptions[approved.meta!.description];
const h1 = record.h1.variants[approved.h1];

// The one image the migrated page carried, at its ORIGINAL path with its original alt
// (working rule 11), from the record's `assets` where the bake recorded it.
const support = record.assets.find((a) => a.slot === 'contact-form-support')!;

// THE FOUR FAQ ROWS THE RECORD NAMES, BY ID. Not by `source`, which is how the thank-you
// and privacy pages select theirs: two of these four (`deposit`, `delivery`) are sourced to
// data/settings.json because the answer IS the setting, so a `source` filter would silently
// drop them. The record's `questions` tree names one id per row and the order below is the
// record's order.
const wanted = record.sections.find((s) => s.id === 'questions')!.tree.map((n) => n.heading);
const rows = loadFaq();
const faqs = wanted.map((id) => rows.find((r) => r.id === id)!);

// THE ONE REVIEW, BY THE NAME THE APPROVAL NAMES: data/reviews.json entry 3, Rachel L. of
// London — the only one of the three that names the communication, which is what a reader
// deciding whether to write to a stranger is weighing. Entry 1 is on the thank-you page and
// is deliberately not reused here. Found by NAME so a row inserted above it cannot swap the
// quote silently. The slot is filled, so no REVIEW_PLACEHOLDER renders on this page.
const rachel = reviewsJson.find((r) => r.name === 'Rachel L.')!;

// The three chrome entries are not sections of the page (see the note at the top).
const CHROME_SHAPES = ['dial', 'sheet', 'strip'];
const sections = sectionsFromRecord({
  sections: record.sections.filter((s) => !CHROME_SHAPES.includes(s.shape)),
});

// WORKING RULE 16 — the per-page hero and counter the breeder picked on 2026-09-22: H-UT1 (a
// small photo mosaic right of the copy, in a card) and C-UT1 (one flush line in a card beside
// the heading, labels above), the interior-utility family's own, resolved through
// `pickedStyle()` so the page mounts what the board rendered. The hero's ledge is `none`, and
// its tiles are the photographs the record's `top` names: one, so it degrades to the single
// photo just as the board drew it.
const topStyle = pickedStyle(record, 'top');
const topBox = boxClass(topStyle);
const topTiles = record.sections.find((s) => s.id === 'top')!.images.map((i) => {
  const a = record.assets.find((x) => x.slot === i.slot && x.file)!;
  return { src: a.file, alt: a.alt, w: a.w, h: a.h };
});
const statsStyle = pickedStyle(record, 'stats');
const statsBox = boxClass(statsStyle);
const statsSection = record.sections.find((s) => s.id === 'stats')!;

// THE COUNTER'S TWO FIGURES ARE DERIVED HERE, and the record's `n` is what each is checked
// against (`countedFigures()`, src/lib/recordText.ts). The hours are cut out of the setting
// the footer and the prose below both read; the reply window out of the data/faq.json answer
// the hero's own paragraph and the form's lede state in words. Two tiles and no more: no file
// holds a telephone figure or an appointment figure, so the page does not print one.
const hoursRange = /(\d{2}:\d{2})\s*-\s*(\d{2}:\d{2})/.exec(SITE.hours);
const replyAnswer = rows.find((r) => r.id === 'enquiry-reply-time');
const replyWindow = replyAnswer && /(\d+)\s*[-–]\s*(\d+) business hours/.exec(replyAnswer.a);
if (!hoursRange || !replyWindow) {
  throw new Error('uk-blue-staffy-breeders-contact: data/settings.json hours or data/faq.json '
    + 'enquiry-reply-time no longer states the range the counter reads out of it');
}
const COUNTED: Record<string, string> = {
  'data/settings.json#hours': `${hoursRange[1]}–${hoursRange[2]}`,
  'data/faq.json#[enquiry-reply-time].a': `${replyWindow[1]}–${replyWindow[2]}`,
};
const counterStats = (statsSection.stats as StatRow[])
  .map(countedFigures(COUNTED, 'uk-blue-staffy-breeders-contact'));
const whyWriteBox = boxClass(pickedStyle(record, 'why-write'));
const enquiryBox = boxClass(pickedStyle(record, 'enquiry'));
const ownersBox = boxClass(pickedStyle(record, 'owners'));
const questionsBox = boxClass(pickedStyle(record, 'questions'));

const email = SITE.email;
// "Mo-Su 09:00-23:00" as a sentence, from the setting rather than typed as prose.
const hours = SITE.hours.replace('Mo-Su ', 'every day, ').replace('-', ' to ');

// The record's schema plan: ContactPage + FAQPage (`brief.schema.types`). The FAQ node is
// built from the SAME four rows the accordion renders, so the markup and the page can never
// answer a question differently. No `dateModified` here on purpose — BaseLayout adds the
// WebPage node with the git-derived dates, and a second date on one page is worse than one.
const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${abs(path)}#contactpage`,
    url: abs(path),
    name: title,
    inLanguage: 'en-GB',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${abs(path)}#faq`,
    mainEntity: faqs.map((r) => ({
      '@type': 'Question',
      name: r.q,
      acceptedAnswer: { '@type': 'Answer', text: r.a },
    })),
  },
];
---
<PageShell
  title={title}
  description={description}
  canonical={path}
  ogType="article"
  schema={pageSchema}
  sections={sections}
>
  {/* 01 — the opening. Hero in the picked style H-UT1 (a small photo mosaic right of the
      copy, in a card), carrying the migrated photograph at its original path with its
      original alt. */}
  <section slot="hero" id="top" data-section-label="Contact Blue Staffy UK" class={topBox}>
    <Hero
      as="h1"
      eyebrow={`Enquiries · ${SITE.location_label}`}
      title={T(h1)}
      lede="I am Lisa Bright, and the form below comes straight to me."
      image={support.file}
      imageAlt={support.alt}
      imageWidth={support.w}
      imageHeight={support.h}
      layout={topStyle.layout.hero ?? 'split'}
      align={topStyle.layout.align ?? 'left'}
      media={topStyle.layout.media ?? 'right'}
      ledge={topStyle.layout.ledge ?? 'none'}
      mosaic={topTiles}
    />
    <p>
      This is the one place to write to us. Whether you are ready to reserve a puppy or only
      want more information, the form is the quickest route.
    </p>
    <p>
      Every enquiry is answered within 24-48 business hours, and it is answered by me rather
      than by an agency. If you would rather not use a form, the email address is a little
      further down the page.
    </p>
  </section>

  {/* 02 — the counter, in the picked style C-UT1 (one flush line in a card beside the
      heading, labels above). It prints the record's two sourced `stats` rows, each figure
      derived above from the file its row cites. */}
  <section id="stats" data-section-label="When you will hear back" class={statsBox}>
    <div class="bl-head">
      <h2>{T(statsSection.heading)}</h2>
      <p class="bl-lede">Two facts, both read from our own files: the hours I answer in, and how soon a reply follows.</p>
    </div>
    <div class="bl-body">
      <CounterStrip
        stats={counterStats}
        tiles={statsStyle.layout.tiles ?? 'inline'}
        label={statsStyle.layout.label ?? 'under'}
      />
    </div>
  </section>

  {/* 03 — the trust strip, in the picked style S1 (full width). The three claims are the
      kit's own and are backed on the site today; nothing is written here but the lede. */}
  <section id="why-write" data-section-label="What we can help with" class={whyWriteBox}>
    <div class="bl-head">
      <h2>{T('What we can help with')}</h2>
      <p class="bl-lede">
        The standing facts about our dogs, before you write. There is more on
        <a href="/blue-staffy-uk-breeders/">who we are</a>, and
        <a href="/blue-staffy-blog-guides/">our blog guides</a> go further into all of it.
      </p>
    </div>
    <div class="bl-body">
      <TrustStrip />
    </div>
  </section>

  {/* 04 — the one enquiry form, in the picked style S2 (form beside the reasons to write).
      ContactFormKit takes its default idPrefix: one form, one id space. */}
  <section id="enquiry" data-section-label="Send us a message" class={enquiryBox}>
    <div class="bl-head">
      <h2>{T('Send us a message')}</h2>
      <p class="bl-lede">
        This is the one enquiry form on the site. It reaches me directly, and a reply follows
        within 24-48 business hours.
      </p>
    </div>
    <div class="bl-body">
      <ContactFormKit />
      <h3>{T('One form, one inbox')}</h3>
      <p>
        There is no second form on this site, so an enquiry cannot be sent anywhere I do
        not read.
      </p>
      <h4>{T('Sending It Once Is Enough')}</h4>
      <p>Either way the reply comes within 24-48 business hours.</p>
      <h5>{T('Only Four Fields Are Required')}</h5>
      <p>Your name, your email, which puppy, and a message. The rest of the form is optional.</p>
      <h6>{T('What to send: As Much Detail as Possible')}</h6>
      <p>That is what the form asks for, and the next section says which detail.</p>
    </div>
    <aside class="bl-aside">
      <InfoCard
        kind="fact"
        heading={T('What the form does')}
        body="It reaches Lisa directly. There is no queue, no agency and no automated reply — the next message you get is one somebody wrote."
      />
    </aside>
  </section>

  {/* 05 — the direct channels. `standard` with no pick: prose is prose. */}
  <section id="reach-us" data-section-label="How to reach us">
    <h2>{T('How to reach us')}</h2>
    <p>Three channels, plainly.</p>

    <h3>{T('Email')}</h3>
    <p>
      Write to {email}. It comes to me, and is answered
      within 24-48 business hours. See
      <a href="/privacy-policy-uk/">how we handle what you send us</a>.
    </p>

    <h3>{T('When we answer')}</h3>
    <p>Messages are read {hours}.</p>

    <h3>{T('Where we are')}</h3>
    <p>
      {SITE.location_label}. No walk-in facility: the dogs live in a family home, so visits
      are by appointment only, arranged after we have talked. Read about
      <a href="https://www.thekennelclub.org.uk/media-centre/2025/january/responsible-breeding-bolstered-by-new-registrations-structure/" target="_blank" rel="noopener noreferrer">The Kennel Club Assured Breeder Scheme</a>.
    </p>

    <h3>{T('Where we post')}</h3>
    <p>
      We post the dogs on X, YouTube, Instagram and Facebook — places to see them, not a
      second enquiry channel.
    </p>
    <h4>{T('Both Routes Are the Same Route')}</h4>
    <p>Form or email, the reply comes within 24-48 business hours.</p>
    <h5>{T('No Telephone Number Yet')}</h5>
    <p>There is no number to publish, so none is printed here rather than a wrong one.</p>
    <h6>{T('What to send: One Channel Is Enough')}</h6>
    <p>The form and the email address reach the same inbox.</p>
  </section>

  {/* 06 — what each field is for. `standard` with no pick. The four sub-headings are the
      form's own field groups, so this section can never describe a field the form lacks. */}
  <section id="what-to-tell-us" data-section-label="What to tell us">
    <h2>{T('What to tell us')}</h2>
    <p>What each field is for.</p>

    <h3>{T('Your name and email')}</h3>
    <p>The two required fields: how the reply reaches you, and nothing else.</p>

    <h3>{T('Phone and your town or postcode')}</h3>
    <p>Both optional. A town lets me price delivery by distance from Carlisle before you ask.</p>

    <h3>{T('Which puppy, or the waiting list')}</h3>
    <p>
      The puppies available today, plus a waiting-list choice for the next litter. See
      <a href="/buy-blue-staffy-puppies-uk/">the puppies looking for a home</a> and
      <a href="/blue-staffy-pup-sale-uk/">what a puppy costs and how delivery works</a>.
    </p>

    <h3>{T('Your message')}</h3>
    <p>
      Your household, your hours, other dogs and children — and whatever
      <a href="/uk-staffordshire-bull-terrier-guide/">the Staffordshire Bull Terrier breed
      guide</a> or <a href="/blue-staffy-health-uk/">how we health test and raise them</a>
      left you wondering.
    </p>
    <h4>{T('Detail Is Not a Test')}</h4>
    <p>The fields above are there so the first reply can answer properly.</p>
    <h5>{T('A Short Message Is Still Answered')}</h5>
    <p>Every enquiry is answered, whatever length it arrives at.</p>
    <h6>{T('What to send: Your Town, if Nothing Else')}</h6>
    <p>Delivery is priced by distance, so a town is what makes that answerable.</p>
  </section>

  {/* 07 — one review, in the picked style S1 (one review given room). */}
  <section id="owners" data-section-label="What it is like to deal with us" class={ownersBox}>
    <div class="bl-head">
      <h2>{T('What it is like to deal with us')}</h2>
      <p class="bl-lede">One review, chosen because it names the communication rather than the puppy.</p>
    </div>
    <div class="bl-body">
      <Testimonial mode="single" reviews={[rachel]} />
      <h3>{T('Why this one is on this page')}</h3>
      <p>
        You are deciding whether to write to somebody you have never met. Whether they answer
        is the part worth knowing first.
      </p>
      <h4>{T('Three Reviews, All Real')}</h4>
      <p>We hold three, sent to us by the families who wrote them. There are no others.</p>
      <h5>{T('The Other Two Are Elsewhere')}</h5>
      <p>This one is Rachel L., in London; the other two sit on other pages.</p>
      <h6>{T('What to send: The Thing One Review Cannot Tell You')}</h6>
      <p>Ask it in the form above; that is what the message box is for.</p>
    </div>
  </section>

  {/* 08 — the FAQ, in the picked style S3 (accordion in a card with a jump list beside it).
      The four rows are the ones the record names, in the record's order. */}
  <section id="questions" data-section-label="Before you write" class={questionsBox}>
    <div class="bl-head">
      <h2>{T('Before you write')}</h2>
      <p class="bl-lede">
        Four things people ask on the way to the form. Each answer is one the page above or
        our own settings already state.
      </p>
    </div>
    <div class="bl-body">
      <Faq items={faqs} />
      <h4>{T('None of These Need Asking Twice')}</h4>
      <p>If an answer here is enough, your message can be about your household instead.</p>
      <h5>{T('Anything Missing Is Worth Asking')}</h5>
      <p>Four rows is not the whole of what we can tell you.</p>
      <h6>{T('What to send: The Question These Miss')}</h6>
      <p>Put it in the message rather than waiting for the reply to invite it.</p>
    </div>
    <aside class="bl-aside">
      <p class="bl-eyebrow">In this section</p>
      <ul>
        <li>The deposit</li>
        <li>Delivery to your home</li>
        <li>Visiting by appointment</li>
        <li>What to put in a message</li>
      </ul>
    </aside>
  </section>
</PageShell>
