---
import { crumbs } from '../lib/site';
interface Props { path: string; title: string }
const { path, title } = Astro.props;
const trail = crumbs(path, title);
// EVERY CRUMB LINK IS AT LEAST 24px TALL (`layout-tap-target-size`, blocking; WCAG 2.5.8).
// A 14px link is a 17px box, and the check forgives a small target only while nothing else
// sits within 24px of its centre. That exemption held while the legacy header left the trail
// alone in its band; the kit header is a different height, and the moment a hub moved onto
// it the four crumb links on those pages started failing. `.tap-24` is the shared rule in
// src/styles/kit.css — the locations hub needs exactly the same thing.
//
// 8px EACH SIDE OF THE › (the design-polish pick 4(a), the user in chat 2026-09-30; preview
// docs/artifacts/bsuk-design-polish-preview.html, item 4). The › and the crumb share one <li>, and
// Astro's compressed output drops the space between the two expressions, so the <ol>'s gap fell
// only between whole items: 8px before each ›, 0px after it. Each <li> is a flex row with the same
// 8px gap. It is a stylesheet rule, not a `style` attribute, so the built markup is unchanged; the
// kit's own trail (PageNav's `.crumbs`) is not this nav and keeps its own rule. Held by
// tests/render/checks/nav.ts::nav-breadcrumb-separator-spaced.
---
{trail.length > 1 && <nav aria-label="Breadcrumb" class="container" style="font-size:14px;padding-top:12px"><ol style="display:flex;gap:8px;list-style:none;padding:0;margin:0;flex-wrap:wrap">
  {trail.map((c, i) => <li>{i > 0 && <span aria-hidden="true">›</span>} {i === trail.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href} class="tap-24">{c.label}</a>}</li>)}
</ol></nav>}
<style is:global>
  @layer components {
    /* ONE BASELINE FOR THE WHOLE TRAIL (visual-intelligence audit 2026-10-04, rec 8). D3's crumb
       links are 44px boxes with their text centred; the current crumb is a <span>, and a stretched
       <ol> left its <li>'s text at the top of the row, about 10px above the links' text. Aligning
       the <ol>'s items on their baselines puts the current crumb and its › on the links' line; the
       44px targets and the 8px either side of each › are untouched. Held by
       tests/render/checks/nav.ts::nav-breadcrumb-baseline-aligned. */
    nav[aria-label="Breadcrumb"].container > ol { align-items: baseline; }
    nav[aria-label="Breadcrumb"].container > ol > li { display: flex; align-items: baseline; gap: 8px; }
    /* EVERY CRUMB LINK IS A 44x44 TARGET (impeccable D3, the breeder's yes on every page,
       2026-10-03 q04). `.tap-24` gave a 31px line; the link is now a 44px-tall flex box, and it
       reaches 44px wide by 8px of padding each side cancelled by an 8px negative margin, so the
       box grows and the TEXT stays exactly where it was: the 8px either side of each › holds
       (nav-breadcrumb-separator-spaced; a plain min-width pushed the › 9px right of "Home"). Two
       neighbours' boxes stay apart: 8px + the › + 8px between their texts is wider than the 16px
       they reach into it. Size only: no colour, weight or separator moves. */
    nav[aria-label="Breadcrumb"].container > ol > li > a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 8px; margin-inline: -8px; }
  }
</style>
