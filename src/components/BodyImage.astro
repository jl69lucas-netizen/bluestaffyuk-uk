---
// src/components/BodyImage.astro — one migrated photograph, in the body of a rebuilt page.
//
// WHY IT IS A COMPONENT. Working rule 11 says every image a rebuilt page renders is one the
// migrated site already served, at its ORIGINAL public path with its ORIGINAL alt text and its
// measured intrinsic size — and `src/lib/assets.ts` already hands the page a row carrying all
// four. What each page then wrote was nine identical lines of `<img>` per photograph: sixteen
// copies on /uk-blue-staffy-puppy-buying-guide/ alone, ten on the breed guide, and the same
// again on the health and about pages. Nine lines repeated sixteen times is not a style
// problem: `sizes`, `loading` and `decoding` are all measured decisions that `img-sizes-
// matches-box`, `img-no-lazy-hero` and `img-srcset-within-2x` judge, and a decision spelled
// forty times is a decision that can be changed thirty-nine times.
//
// NOT IN THE KIT, DELIBERATELY. `src/components/kit/` is project 3's component set: eighteen
// rows in data/design/components.json, a measured height in data/design/canvas-heights.json,
// a `@dsCard` preview folder in the published design system and a specimen on /kit-preview/,
// all of which `tests/py/test_design_system_build.py` holds to each other. A nine-line `<img>`
// wrapper earns none of that, and adding it would mean re-publishing the design system to
// document a tag. It sits beside `Breadcrumb.astro` and `Schema.astro` instead — the
// site-level components that were never kit rows — so the kit's registry, its canvas and its
// hex gate are all untouched.
//
// IT TAKES THE ASSET ROW WHOLE rather than four props, because the row is the unit
// `bakedAssets()` returns and splitting it at every call site is how a width and a height
// drift apart from the file they measure.
//
// THE BOX (rules/images.md `uniform-inbody-image-sizing`, 2026-09-26). `natural` is the
// twelve built pages' `.bl-img`: natural ratio, 420px beside the prose. `uniform` is the
// project 5 box: `.bl-img.sec-img`, 760px at 1408:768, cropped with `object-fit: cover`.
// `tall` is that box for a portrait, which turns 4:5 below 900px held upright (`.og-tall`). Every
// body image keeps `.bl-img`, so a check that looks for in-body images reads one class.
import type { FilledAsset } from '../lib/assets';
import { BODY_SIZES, TALL_SIZES, UNIFORM_SIZES } from '../lib/assets';

/** A phone-only art-directed file (an infographic's phone layout): served below 640px
 *  through `<picture>`, at its own intrinsic size, and never cropped by the uniform box. */
export interface PhoneSource {
  src: string; w: number; h: number;
  /** Its own candidate list (`w` descriptors), read against `sizes`. Omitted
   *  renders the single file, as before. */
  srcset?: string;
  /** A display crop of the phone file, in the FILE's pixels: `top` and `bottom` rows hidden by
   *  the box (London final fixes M1, answer board 2026-10-05 q04 (a): the AmStaff phone file's
   *  title band repeats its H3 word for word). The file is untouched and keeps its URL (working
   *  rule 11); the box takes the cropped ratio before and after the file loads. */
  crop?: { top: number; bottom: number };
}
/** The row a page hands BodyImage and the city components: the baked row, its candidate list
 *  and, for an infographic, its phone layout. */
export type BodyAsset = FilledAsset & { srcset?: string; phone?: PhoneSource };

interface Props {
  /** The record's baked row: original path, original alt, measured intrinsic size. */
  asset: FilledAsset;
  /** Candidate list, for a master wide enough to need one. Omitted renders no `srcset`. */
  srcset?: string;
  /** The box the photo paints, for a page whose prose column is not `PageShell`'s. */
  sizes?: string;
  /** Which box: the built pages' natural `.bl-img`, or project 5's uniform box. */
  box?: 'natural' | 'uniform' | 'tall';
  /**
   * The crop's focal point, as `object-position` percentages ("50% 30%"). It matters for the
   * tall box (the 4:5 strip of a 16:9 file) and for a source that is not 16:9; a 1408x768
   * file in the uniform box fills it exactly and has nothing to move. Anything that is not
   * two percentages is ignored, and the natural box never takes one.
   */
  focal?: string;
  /** Extra classes on the `<img>` (a city component's crop classes, `focus fx-NN fy-NN`). */
  class?: string;
  /** An art-directed phone file (below 640px). Omitted, the `<img>` renders alone, as before. */
  phone?: PhoneSource;
}
const FOCAL = /^\d{1,3}% \d{1,3}%$/;
const { asset, srcset, box = 'natural', focal, class: extra, phone } = Astro.props;
const sizes = Astro.props.sizes ?? (box === 'tall' ? TALL_SIZES : box === 'uniform' ? UNIFORM_SIZES : BODY_SIZES);
const crop = phone?.crop;
if (crop && (crop.top < 0 || crop.bottom < 0 || crop.top + crop.bottom >= phone!.h)) {
  throw new Error(`BodyImage: ${phone!.src} crop ${crop.top}/${crop.bottom} leaves nothing of a ${phone!.h}px file`);
}
const cls = ['bl-img', box !== 'natural' && 'sec-img', box === 'tall' && 'og-tall', phone && 'art-phone', crop && 'art-crop', extra];
// The crop is two custom properties, read only below 640px (board-styles.css `.art-crop`): the
// box's ratio is the file less the cropped rows, and `object-position` puts the hidden rows'
// split (top against bottom) where `object-fit: cover` cuts them.
const cropStyle = crop
  ? `--art-crop-ratio: ${phone!.w} / ${phone!.h - crop.top - crop.bottom}; --art-crop-y: ${+(100 * crop.top / (crop.top + crop.bottom || 1)).toFixed(4)}%`
  : undefined;
const style = [box !== 'natural' && focal && FOCAL.test(focal) ? `object-position: ${focal}` : undefined, cropStyle]
  .filter(Boolean).join('; ') || undefined;
---
{/* `loading="lazy"` and `decoding="async"` are right for every in-body photograph and wrong
    for a hero: the hero is the LCP element and is eager with `fetchpriority="high"`, which is
    `Hero.astro`'s own business. This component is for the body only, which is why neither is
    a prop. */}
{phone ? (
<picture>
  <source media="(max-width: 639px)" srcset={phone.srcset ?? phone.src} sizes={phone.srcset ? sizes : undefined}
    width={phone.w} height={phone.h} />
  <img class:list={cls} style={style} src={asset.file} alt={asset.alt} width={asset.w} height={asset.h}
    srcset={srcset} sizes={sizes} loading="lazy" decoding="async"
    data-art-crop={crop ? `${phone.w}x${phone.h - crop.top - crop.bottom}` : undefined} />
</picture>
) : (
<img
  class:list={cls}
  style={style}
  src={asset.file}
  alt={asset.alt}
  width={asset.w}
  height={asset.h}
  srcset={srcset}
  sizes={sizes}
  loading="lazy"
  decoding="async"
/>
)}
