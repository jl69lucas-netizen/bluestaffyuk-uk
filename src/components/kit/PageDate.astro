---
// src/components/kit/PageDate.astro — the page's real last-updated date, rendered.
//
// WHY A PAGE EVER SHOWS ONE. Freshness normally lives in the schema and nowhere else
// (`no_visible_date`, blog profile), because a visible "updated" stamp on a sales page is a
// recency signal dressed as information. A privacy policy is the exception the rule was
// never about: its own copy tells the reader that the version they are reading is the one
// with the current date on it, and four sentences of that page lean on a date that was not
// on the page at all. Either those sentences go or the date is real; the date is real.
//
// IT IS THE SAME NUMBER THE SCHEMA CARRIES. `data/page-dates.json` is written by
// scripts/generate_page_dates.py from committed git history and regenerated by `prebuild`,
// and BaseLayout reads that same row for the WebPage node's `dateModified`. So the sentence
// a reader sees and the date a crawler reads cannot disagree — which is the whole reason
// this is a component over the data file rather than a date typed into a page.
//
// A route with no row renders NOTHING rather than today's date: a page that has never been
// committed has no honest last-updated date, and `new Date()` would tell every reader the
// policy changed the moment they loaded it.
import pageDates from '../../../data/page-dates.json';

interface Props {
  /** The route, exactly as `data/page-dates.json` keys it — the page's own canonical. */
  path: string;
  /** The words before the date. */
  label?: string;
}
const { path, label = 'Last updated' } = Astro.props;

const row = (pageDates.routes as Record<string, { datePublished: string; dateModified: string }>)[path];
const iso = row?.dateModified?.slice(0, 10);
// en-GB long form: "20 September 2026". Fixed locale, not the reader's: the date is a fact
// about this document, and a build that rendered it as 09/20/2026 for one visitor and
// 20/09/2026 for another would be two documents.
const human = iso
  ? new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB',
      { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
---
{iso && <p class="kit-pagedate">{label}: <time datetime={iso}>{human}</time></p>}
<style>
  @layer components {
    .kit-pagedate {
      margin: var(--space-4) 0 0;
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
  }
</style>
