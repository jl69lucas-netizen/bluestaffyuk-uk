---
// src/components/kit/CityPhotoShelf.astro — Manchester's table (pick: manchester/tables/a, "Photo
// shelf"; frozen 355d5e43). The outline's litter table (row 10, under its H4) in one raised card
// on the bone page: each row led by that puppy's own photograph, a rounded square on a bone mat,
// with the name in the display face and its status under it, so the litter reads as a shelf of
// portraits with their facts beside them (Known Issue 100: the pup photos the breeder missed on
// London's cards). Airy rows, hairline dividers, the price in lining tabular figures. Built from
// design/city-canvas/manchester/tables/a.html as the visual spec only; it imports no London
// component (rules/design.md own-components-per-page).
//
// IT STACKS BELOW A 640px BOX (working rule 13): `.stack-table` stays on the table, every row is
// `display: block` (what `layout-table-stacks-on-mobile` reads), and each becomes a small portrait
// card, two to a line: the photo across its top, the name and status, then Sex, Coat and Price as
// labelled lines (each `<td>`'s `data-label`), with no sideways scroll. Explicit ARIA table roles
// keep the table's semantics through the `display: block` stack. From a 640px box it is a table,
// whatever the viewport (the site's `.stack-table` edge is the viewport's 640, which INCLUDES 640).
//
// EVERY FACT IS DATA (working rule 9): the rows are data/puppies.json's available puppies in file
// order (the outline: "6, one per puppy, status Available only"), each with its own status; the
// price is data/price-matrix.json's by sex (src/lib/cityKit.ts `priceFor`, which stops the build
// if a puppy's own price disagrees). The heading and caption are the outline's, passed in.
//
// THE PHOTOS AND THEIR ALTS (working rule 11): a pup whose card photo the page already showed
// above (`shownAbove`, by name) is a repeat and takes a new alt (`puppyAlt`, `repeatAlt`: the
// hero and the counter above it spend the served and the short alts on Manchester, so the shelf's
// repeats say what the photo shows, 'scene'); any other is the photo's first use on the page and
// keeps the alt the site serves for it (`servedPuppyAlt`). No two alts on a page are the same.
import '../../styles/city.css';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { puppyImage } from '../../lib/puppyImages';
import { focusClassFor, puppyAlt, servedPuppyAlt } from '../../lib/imageFocus';
import { availablePuppies, citySizes, priceFor, sexWord, BOY_PRICE, GIRL_PRICE, type CityFit } from '../../lib/cityKit';
import { numberWord } from '../../lib/recordText';

type Props = HTMLAttributes<'section'> & {
  /** The outline's heading over the table, word for word. */
  heading: string;
  /** Its level in the page's outline (Manchester sets the table under an H4). */
  as?: 'h2' | 'h3' | 'h4';
  /** The outline's caption, word for word. */
  caption: string;
  /** The page's city, from data/locations.json `city`. */
  city: string;
  /** Puppies whose card photo a component above this one already painted, by name. */
  shownAbove?: string[];
  /** The new alt a repeat takes (src/lib/imageFocus.ts `puppyAlt`). */
  repeatAlt?: 'short' | 'scene';
  /** Where the section sits from 1024px, for its photos' `sizes` (src/lib/cityKit.ts `CityFit`). */
  fit?: CityFit;
};
const { heading, as: H = 'h4', caption, city, shownAbove = [], repeatAlt = 'scene', fit = 'column', class: cls, ...rest } = Astro.props;

const pups = availablePuppies();
if (!pups.length) throw new Error('CityPhotoShelf: data/puppies.json has no available puppy to list');
const COLUMNS = ['Puppy', 'Sex', 'Coat', 'Price'] as const;
const list = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}` : names[0]);
const of = (sex: 'male' | 'female') => pups.filter((p) => p.sex === sex).map((p) => p.name);
const boys = of('male');
const girls = of('female');
const groups = [
  ...(boys.length ? [`${list(boys)} ${boys.length === 1 ? 'is our boy at' : 'are our boys at'} ${BOY_PRICE}${boys.length === 1 ? '' : ' each'}`] : []),
  ...(girls.length ? [`${list(girls)} ${girls.length === 1 ? 'is our girl at' : 'are our girls at'} ${GIRL_PRICE}${girls.length === 1 ? '' : ' each'}`] : []),
];
const all = pups.length === 1 ? 'our one puppy' : `all ${numberWord(pups.length)}`;
const alt = (p: (typeof pups)[number]) => (shownAbove.includes(p.name) ? puppyAlt(p, repeatAlt) : servedPuppyAlt(p));
// An 80px square in the row from a 640px box; below it, half the card grid (the box less its 16px
// gutters and the 12px gap between the two cards).
const sizes = citySizes(fit, {
  phone: (B) => `calc((${B} - 44px) / 2)`,
  tablet: () => '80px',
  desktop: () => '80px',
});
---
<section {...rest} class:list={['city-kit', 'city-photo-shelf', cls]}>
  <div class="in">
    <H class="h">{heading}</H>
    <p class="lede">{groups.join(', and ')}; in this litter the price follows the sex, never the coat, and {all} can come home to {city}.</p>
    <div class="card">
      <table class="stack-table" data-table role="table">
        <caption>{caption}</caption>
        <thead role="rowgroup">
          <tr role="row">{COLUMNS.map((c) => <th role="columnheader" scope="col" class:list={[{ num: c === 'Price' }]}>{c}</th>)}</tr>
        </thead>
        <tbody role="rowgroup">
          {pups.map((p) => (
            <tr role="row" data-pup>
              <th role="rowheader" scope="row"><span class="who">
                <Image src={puppyImage(p.card_photo)} alt={alt(p)} widths={[80, 160, 240, 330]} sizes={sizes}
                  class={focusClassFor(p.card_photo, 3 / 2)} loading="lazy" decoding="async" />
                <span class="id">
                  <span class="nm">{p.name}</span>
                  <span class="st">{p.status === 'Available' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>}{p.status}</span>
                </span>
              </span></th>
              <td role="cell" data-label="Sex">{sexWord(p)}</td>
              <td role="cell" data-label="Coat">{p.colour}</td>
              <td role="cell" data-label="Price" class="num">{priceFor(p)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
<style>
  @layer components {
    /* An in-body container (src/styles/city.css): no inline padding on the root; the inner
       column's own width is its gutter. */
    .city-photo-shelf { background: var(--color-surface); padding: var(--space-6) 0; }
    .in { width: calc(100% - 2 * var(--space-4)); max-width: 880px; margin: 0 auto; }
    /* An H4 in the page's outline, set a step under the tier's H3 cap. */
    .h {
      margin: 0 0 var(--space-2); font-size: var(--city-h3); line-height: 1.25; font-weight: 700;
      color: var(--color-brand); text-wrap: balance; max-inline-size: 30ch;
    }
    .lede { margin: 0 0 var(--space-5); color: var(--color-text); max-inline-size: 62ch; }
    .card {
      background: var(--color-surface-raised); border: var(--card-border); border-radius: var(--card-radius);
      box-shadow: var(--shadow-card); padding: var(--space-4) var(--space-3);
    }
    table { width: 100%; border-collapse: collapse; color: var(--color-text); }
    caption {
      caption-side: top; text-align: left; padding: 0 var(--space-1) var(--space-3);
      font-family: var(--font-display); font-weight: 600; font-size: var(--text-base); line-height: 1.3; color: var(--color-brand);
    }
    thead th {
      padding: 0 var(--space-4) var(--space-3); font-size: var(--text-sm); font-weight: 600; text-align: left;
      color: var(--color-ink-2); border-bottom: 1px solid var(--color-border);
    }
    tbody th, tbody td { padding: var(--space-4); text-align: left; vertical-align: middle; border-bottom: 1px solid var(--color-border); }
    tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
    .who { display: flex; align-items: center; gap: var(--space-4); }
    /* The photo on a bone mat; bone behind it while it loads, never grey. */
    .who :global(img) {
      flex: none; display: block; width: 80px; height: 80px; aspect-ratio: 1 / 1; object-fit: cover;
      border-radius: var(--radius-md); background: var(--color-bone-50); border: 4px solid var(--color-bone-50);
    }
    .id { display: block; }
    .nm { display: block; overflow-wrap: anywhere; font-family: var(--font-display); font-size: var(--city-h3); font-weight: 600; line-height: 1.2; color: var(--color-brand); }
    .st { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--space-1); font-size: var(--text-sm); font-weight: 400; color: var(--color-ink-2); }
    .st svg { width: 14px; height: 14px; color: var(--color-ok); }
    /* Element-qualified, so the price column sits right over the scoped `tbody td` rule. Lining,
       tabular figures, so the six prices line up digit for digit. */
    thead th.num, tbody td.num { text-align: right; white-space: nowrap; }
    tbody td.num { font-feature-settings: 'lnum', 'tnum'; font-weight: 700; font-size: var(--text-lg); color: var(--color-brand); }

    /* Rule 13: below a 640px BOX each row is a small portrait card, two to a line. */
    @container (width < 640px) {
      .card { background: transparent; border: 0; box-shadow: none; padding: 0; }
      table, thead, tbody, tr, th, td, caption { display: block; }
      caption { padding: 0 0 var(--space-3); }
      thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      tbody { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
      tbody tr {
        display: block; background: var(--color-surface-raised); border: var(--card-border);
        border-radius: var(--radius-md); overflow: hidden;
      }
      tbody th, tbody td, tbody tr:last-child th, tbody tr:last-child td { border: 0; padding: 0; }
      .who { display: block; }
      .who :global(img) { width: 100%; height: auto; aspect-ratio: 3 / 2; border: 0; border-radius: 0; }
      .id { padding: var(--space-2) var(--space-3); }
      .st { margin-top: 2px; font-size: var(--text-xs); }
      /* Each value on its own labelled line: the label left, the value right. The site's
         `.stack-table` prefix ("Sex: ") is replaced by the label alone, set apart by the layout. */
      tbody td, tbody tr:last-child td {
        display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2);
        padding: 6px var(--space-3); border-top: 1px solid var(--color-border);
        font-size: var(--text-sm); line-height: 1.35; text-align: right; overflow-wrap: anywhere;
      }
      tbody td::before {
        content: attr(data-label); flex: none; font-size: var(--text-xs); font-weight: 600;
        color: var(--color-ink-2); text-align: left;
      }
      /* The price is pinned to the card's foot, so two cards side by side keep their prices on one
         line when one coat wraps ("Blue with white blaze", Cheryl at 375; frontend-design Task 30).
         The row stays `display: block`; the card's bottom padding is the price line's room. */
      tbody tr { position: relative; padding-bottom: 40px; }
      tbody td.num, tbody tr:last-child td.num {
        position: absolute; inset-inline: 0; bottom: 0; min-height: 40px; align-items: center;
        font-size: var(--text-base); padding-block: 0;
      }
    }
    /* From a 640px box the table is a table, whatever the viewport (see the header). */
    @container (width >= 640px) {
      table { display: table; }
      caption { display: table-caption; }
      thead { display: table-header-group; position: static; }
      tbody { display: table-row-group; }
      tr { display: table-row; border-bottom: 0; padding: 0; }
      th, td { display: table-cell; }
      tbody td[data-label]::before { content: none; }
    }
    @container (width >= 800px) {
      .city-photo-shelf { padding: var(--space-10) 0; }
      .in { width: calc(100% - 2 * var(--space-5)); }
      .card { padding: var(--space-5) var(--space-5) var(--space-3); }
    }
  }
</style>
