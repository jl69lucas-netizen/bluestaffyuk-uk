---
// src/components/kit/SiteHeaderKit.astro — the site header (spec §5 #1). Picked 2026-09-18:
// the bone bar — logo left, nav right, search pill, call-to-action. It replaces
// SiteHeader.astro in project 4.
//
// SPEC §11 AMENDMENT 3b:
// (1) LOGO ONLY. There is no wordmark text; the brand link is the badge mark and its
//     `aria-label` is the accessible name.
// (2) A SEARCH PILL between the nav and the CTA (direction S1), and the same form
//     full-width inside the mobile drawer. It is a real GET form to /search/, so pressing
//     Enter works with no script at all; the script only adds the instant result list.
//
// The index is `public/search-index.json`, written at build time by
// scripts/build_search_index.py from this repo's own data. No third-party search service is
// contacted, at build time or in the browser.
//
// The drawer is the MOBILE behaviour: below 768px the inline nav and the bar's search pill
// are hidden and the <details> arrives. Both navs are in the DOM, but only ever one at a
// time is in the accessibility tree — the hidden one is `display: none`, which removes it
// rather than duplicating the landmark.
//
// The bar takes `color` from the surface and the links inherit it; nothing here spells
// `--color-brand` for text. The mark is the only branding SVG; the icons are inline stroke
// paths, never an icon font.
import type { HTMLAttributes } from 'astro/types';
import { SITE, NAV } from '../../lib/site';
import Mark from './Mark.astro';
import Button from './Button.astro';
type Props = HTMLAttributes<'header'>;
const { class: cls, ...rest } = Astro.props;
const here = Astro.url.pathname;
---
<header {...rest} class:list={['kit-hdr', cls]}>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.site_name} home`}>
      <Mark size={40} title="" />
    </a>
    <nav aria-label="Main" class="nav">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <form role="search" action="/search/" method="get" class="site-search">
      <label class="vh" for="site-search-q">Search the site</label>
      <input id="site-search-q" type="search" name="q" autocomplete="off"
        placeholder="Search the site…" aria-describedby="site-search-hint" />
      <button type="submit" class="go">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
        <span class="vh">Search</span>
      </button>
      <p id="site-search-hint" class="vh">Results appear below as you type; press Enter for the full results page.</p>
      <ul id="site-search-results" class="results" hidden aria-live="polite"></ul>
    </form>
    <Button kind="primary" href="/available-puppies/" label="Available puppies" class="cta" />
    <details class="drawer">
      {/* Two spans rather than a toggled aria-label: the summary's accessible name comes
          from its own text, so `details[open]` swapping which span is displayed renames
          the control with no script and no attribute to keep in sync. */}
      <summary>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="lbl when-shut">Open menu</span>
        <span class="lbl when-open">Close menu</span>
      </summary>
      <div class="panel">
        <form role="search" action="/search/" method="get" class="site-search site-search--wide">
          <label class="vh" for="site-search-q-drawer">Search the site</label>
          <input id="site-search-q-drawer" type="search" name="q" autocomplete="off" placeholder="Search the site…" />
          <button type="submit" class="go">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
            <span class="vh">Search</span>
          </button>
          <ul id="site-search-results-drawer" class="results" hidden aria-live="polite"></ul>
        </form>
        <nav aria-label="Main">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>
<script>
  // The instant-results layer. The form works without it: it is a GET to /search/, so Enter
  // submits and /search/ renders the same list from the same index. The fetch, the cache,
  // the matching and the grouping are src/lib/search.ts, shared with that page.
  import { loadIndex, matchRows, renderInto } from '../../lib/search';

  const MIN_CHARS = 2;
  const MAX = 8;

  for (const form of document.querySelectorAll<HTMLFormElement>('form.site-search')) {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]');
    const list = form.querySelector<HTMLUListElement>('ul.results');
    if (!input || !list) continue;
    const clear = () => {
      list.hidden = true;
      list.textContent = '';
    };
    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (q.length < MIN_CHARS) return clear();
      loadIndex().then((rows) => {
        // The field may have changed again while the index was in flight.
        const now = input.value.trim();
        if (now.length < MIN_CHARS) return;
        renderInto(list, matchRows(rows, now), now, MAX);
      });
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') clear();
    });
  }
</script>
<style>
  @layer components {
    .kit-hdr { position: sticky; top: 0; z-index: 50; background: var(--hdr-bg); border-bottom: 1px solid var(--color-border); min-height: var(--hdr); color: var(--color-text); }
    .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: var(--hdr); flex-wrap: wrap; }
    .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; color: inherit; }
    .brand:focus-visible, .nav a:focus-visible, .drawer summary:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .nav ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
    .nav a { color: inherit; text-decoration: none; font-weight: 600; font-size: var(--text-sm); padding: var(--space-3) 0; display: inline-block; min-height: 44px; line-height: 20px; }
    .nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--color-cta); }

    /* Visually hidden, still announced: the search field's own label, the button's name and
       the hint. Scoped here rather than in kit.css because search is the first component in
       the kit that needs it (convention 9 moves it out on the SECOND). */
    .vh { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

    /* The search pill (S1). `position: relative` so the result list hangs off the field
       rather than pushing the bar taller as the reader types. */
    .site-search { position: relative; display: flex; align-items: center; gap: var(--space-1); background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-pill); padding-inline: var(--space-3); min-height: 44px; flex: 0 1 240px; }
    .site-search input { flex: 1 1 auto; min-width: 0; border: 0; background: none; color: inherit; font: inherit; font-size: var(--text-sm); padding-block: 10px; }
    .site-search input::placeholder { color: var(--color-text-muted); opacity: 1; }
    .site-search input:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
    .go { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-right: calc(var(--space-3) * -1 + 2px); border: 0; background: none; color: inherit; cursor: pointer; border-radius: 50%; }
    .go:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    /* The result list is its own bone panel: a result title is body text, and body text
       belongs on the reading surface. */
    .results { position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 60; margin: 0; padding: var(--space-2); list-style: none; background: var(--color-surface-raised); color: var(--color-text); border: var(--card-border); border-radius: var(--card-radius); box-shadow: var(--shadow-lift); max-height: 60vh; overflow: auto; min-width: 260px; }
    .results .group { font-size: var(--text-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-muted); padding: var(--space-2) var(--space-3) var(--space-1); }
    .results a { display: block; padding: var(--space-2) var(--space-3); color: var(--color-link); text-decoration: none; font-size: var(--text-sm); border-radius: var(--radius-sm); }
    .results a:hover { background: var(--color-brand-soft); }
    .results a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: -2px; }
    .results .empty { padding: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }

    /* Mobile: the inline nav and the bar's search go, the drawer arrives. */
    .drawer { position: relative; display: none; }
    @media (max-width: 767px) {
      .nav { display: none; }
      .bar > .site-search { display: none; }
      .drawer { display: block; }
    }
    .lbl { font-size: var(--text-sm); font-weight: 600; }
    .drawer:not([open]) .when-open, .drawer[open] .when-shut { display: none; }
    .drawer summary { list-style: none; cursor: pointer; display: inline-flex; gap: var(--space-2); padding: 10px; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }
    .drawer summary::-webkit-details-marker { display: none; }
    /* The open panel is its own dark band, so it names the on-inverse text and ring rather
       than inheriting the bone bar's near-black `color` onto a steel background. */
    .drawer[open] .panel { position: absolute; right: 0; top: 100%; min-width: 280px; background: var(--color-surface-inverse); color: var(--color-text-on-inverse); --kit-ring: var(--color-focus-on-inverse); padding: var(--space-5); border-radius: 0 0 var(--card-radius) var(--card-radius); box-shadow: var(--shadow-lift); display: grid; gap: var(--space-4); }
    /* Full width inside the drawer, which is what amendment 3b asks for. */
    .site-search--wide { flex: 1 1 auto; width: 100%; }
    .drawer nav a:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .drawer nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
    .drawer nav a { color: inherit; text-decoration: none; font-weight: 600; display: block; padding: var(--space-2) 0; min-height: 44px; }
    .drawer nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--color-cta); }
  }
</style>
