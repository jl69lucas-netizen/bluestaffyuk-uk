---
// src/components/kit/SiteHeaderKit.astro — spec §5 #1. Replaces SiteHeader.astro in project 4.
// a bone bar, left logo, right nav + CTA · b inverse bar, centred nav · c bone bar, centred logo, nav below
// d inverse bar, logo left, CTA only (nav in a drawer) · e slim bone bar, nav left of CTA, strapline visible
//
// The drawer is the MOBILE behaviour of all five variants, not a trait of d: below 768px
// every variant hides the inline nav and shows the <details>. What distinguishes d is that
// it keeps the drawer at desktop too and never renders an inline nav at all. Both navs are
// in the DOM for the other four, but only ever one at a time is in the accessibility tree —
// the hidden one is `display: none`, which removes it rather than duplicating the landmark.
//
// Variants b and d paint their own steel band, so they carry `data-surface="inverse"`: the
// global rule flips `--kit-ring` to the on-inverse focus colour and sets the inverse text
// colour for everything inside, rather than each child naming a dark-band colour of its own.
// Nothing here spells `--color-brand` for text; the bar takes `color` from the surface and
// the links inherit it.
//
// The mark is the only branding SVG; the icons are inline stroke paths, never an icon font.
import type { HTMLAttributes } from 'astro/types';
import type { Variant } from './_variant';
import { SITE, NAV } from '../../lib/site';
import Mark from './Mark.astro';
import Button from './Button.astro';
type Props = HTMLAttributes<'header'> & { variant?: Variant; markVariant?: Variant };
const { variant = 'a', markVariant = 'a', class: cls, ...rest } = Astro.props;
const inverse = variant === 'b' || variant === 'd';
const here = Astro.url.pathname;
---
<header
  {...rest}
  class:list={['kit-hdr', `kit-hdr-${variant}`, cls]}
  data-surface={inverse ? 'inverse' : undefined}
  data-variant={variant}
>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.site_name} home`}>
      <Mark variant={markVariant} size={40} title="" />
      <span class="word">
        {SITE.site_name}
        {variant === 'e' && <small>{SITE.location_label}</small>}
      </span>
    </a>
    {variant !== 'd' && (
      <nav aria-label="Main" class="nav">
        <ul>
          {NAV.map((n) => (
            <li><a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    {variant !== 'c' && (
      <Button variant="a" href="/available-puppies/" label="Available puppies" class="cta" />
    )}
    <details class="drawer">
      {/* Two spans rather than a toggled aria-label: the summary's accessible name comes
          from its own text, so `details[open]` swapping which span is displayed renames
          the control with no script and no attribute to keep in sync. */}
      <summary>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="lbl when-shut">Open menu</span>
        <span class="lbl when-open">Close menu</span>
      </summary>
      <nav aria-label="Main">
        <ul>
          {NAV.map((n) => (
            <li><a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  @layer components {
    .kit-hdr { position: sticky; top: 0; z-index: 50; background: var(--hdr-bg); border-bottom: 1px solid var(--color-border); min-height: var(--hdr); color: var(--color-text); }
    .kit-hdr[data-surface="inverse"] { background: var(--color-surface-inverse); border-bottom-color: transparent; }
    .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: var(--hdr); flex-wrap: wrap; }
    .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; color: inherit; }
    .brand:focus-visible, .nav a:focus-visible, .drawer summary:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .word { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); line-height: 1; display: flex; flex-direction: column; }
    /* The strapline is the one place the header names a colour, and on the slim bone bar
       only: steel-500 is 4.6:1 on bone, and variant e is the only variant that shows it. */
    .word small { font-family: var(--font-body); font-weight: 600; font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--color-brand-mid); margin-top: 4px; }
    .nav ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
    .nav a { color: inherit; text-decoration: none; font-weight: 600; font-size: var(--text-sm); padding: var(--space-3) 0; display: inline-block; min-height: 44px; line-height: 20px; }
    .nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--color-cta); }
    .kit-hdr-b .bar { justify-content: center; }
    .kit-hdr-b .brand { margin-right: auto; }
    .kit-hdr-b .cta { margin-left: auto; }
    .kit-hdr-c .bar { flex-direction: column; gap: var(--space-2); padding-block: var(--space-3); }
    .kit-hdr-c .brand { flex-direction: column; text-align: center; }
    .kit-hdr-e { min-height: 56px; }
    .kit-hdr-e .bar { min-height: 56px; }
    /* Mobile: the inline nav goes, the drawer arrives — for every variant. */
    .drawer { position: relative; display: none; }
    .kit-hdr-d .drawer { display: block; }
    @media (max-width: 767px) {
      .nav { display: none; }
      .drawer { display: block; }
    }
    .lbl { font-size: var(--text-sm); font-weight: 600; }
    .drawer:not([open]) .when-open, .drawer[open] .when-shut { display: none; }
    .drawer summary { list-style: none; cursor: pointer; display: inline-flex; gap: var(--space-2); padding: 10px; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }
    .drawer summary::-webkit-details-marker { display: none; }
    /* The open panel is its own dark band, so it names the on-inverse text and ring rather
       than inheriting the bone bar's near-black `color` onto a steel background. */
    .drawer[open] nav { position: absolute; right: 0; top: 100%; min-width: 240px; background: var(--color-surface-inverse); color: var(--color-text-on-inverse); --kit-ring: var(--color-focus-on-inverse); padding: var(--space-5); border-radius: 0 0 var(--card-radius) var(--card-radius); box-shadow: var(--shadow-lift); }
    .drawer nav a:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .drawer nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
    .drawer nav a { color: inherit; text-decoration: none; font-weight: 600; display: block; padding: var(--space-2) 0; min-height: 44px; }
    .drawer nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--color-cta); }
  }
</style>
