---
// src/components/kit/SiteHeaderKit.astro — the site header (spec §5 #1). Picked 2026-09-18:
// the bone bar — logo left, nav right, search pill, call-to-action. It replaces
// SiteHeader.astro in project 4.
//
// SPEC §11 AMENDMENT 3b:
// (1) LOGO ONLY. There is no wordmark text; the brand link is the badge mark and its
//     `aria-label` is the accessible name.
// (2) A SEARCH PILL between the nav and the CTA (direction S1), and the same form
//     full-width when the mobile drawer is open. It is a real GET form to /search/, so
//     pressing Enter works with no script at all; the script only adds the instant list.
//
// ONE FORM, NOT TWO. The drawer used to carry its own copy of the search form, which meant
// two inputs, two result lists and two ids for one search on one page — and the duplicated
// `-drawer` id is exactly the kind of thing a reader using a screen reader hits and nobody
// using a mouse ever sees. There is a single `<form class="site-search">` in the bar now,
// and below 768px CSS gives it the full width of a second bar row when the drawer is open.
// One input, one `#site-search-results`, one hint.
//
// THE PILL IS A COMBOBOX, and is marked up as one: `role="combobox"` with
// `aria-expanded`, `aria-controls` and `aria-activedescendant` on the input, `role="listbox"`
// on the list and `role="option"` on each result (src/lib/search.ts writes those). The
// arrow keys, Home, End, Enter and Escape move and choose; focusout dismisses. Without that
// the list was a div a mouse could reach and a keyboard could not.
//
// The list is NOT an aria-live region. A live region that also holds the active option gets
// re-announced on every keystroke AND on every arrow press, which is how an instant-search
// box becomes unusable with a screen reader. The count is announced once per render from a
// separate polite status line instead.
//
// The index is `public/search-index.json`, written at build time by
// scripts/build_search_index.py from this repo's own data. No third-party search service is
// contacted, at build time or in the browser.
//
// The bar takes `color` from the surface and the links inherit it; nothing here spells
// `--color-brand` for text. The mark is the only branding SVG (a `<use>` at the document's
// sprite); the icons are inline stroke paths, never an icon font.
import type { HTMLAttributes } from 'astro/types';
import { SITE, NAV } from '../../lib/site';
import Mark from './Mark.astro';
import Button from './Button.astro';
type Props = HTMLAttributes<'header'>;
const { class: cls, ...rest } = Astro.props;
const here = Astro.url.pathname;
---
<header {...rest} class:list={['kit-hdr', cls]}>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.site_name} home`}>
      <Mark size={40} title="" />
    </a>
    <nav aria-label="Main" class="nav">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <form role="search" action="/search/" method="get" class="site-search">
      <label class="vh" for="site-search-q">Search the site</label>
      <input id="site-search-q" type="search" name="q" autocomplete="off"
        placeholder="Search the site…"
        role="combobox" aria-expanded="false" aria-controls="site-search-results"
        aria-autocomplete="list" aria-describedby="site-search-hint" />
      <button type="submit" class="go">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
        <span class="vh">Search</span>
      </button>
      <p id="site-search-hint" class="vh">Results appear below as you type. Use the up and
      down arrow keys to move through them, Enter to open one, Escape to dismiss the list,
      or Enter with nothing highlighted for the full results page.</p>
      <ul id="site-search-results" class="results" hidden></ul>
      {/* The count, announced once per render. Separate from the list on purpose: a live
          region that also holds the active option is re-announced on every arrow press. */}
      <p id="site-search-status" class="vh" role="status" aria-live="polite"></p>
    </form>
    {/* No `class="cta"`: nothing styles it. It was a hook one of the pruned header options
        used, and a class no rule matches is what `css-class-resolves` is for. */}
    <Button kind="primary" href="/available-puppies/" label="Available puppies" />
    <details class="drawer">
      {/* Two spans rather than a toggled aria-label: the summary's accessible name comes
          from its own text, so `details[open]` swapping which span is displayed renames
          the control with no script and no attribute to keep in sync. */}
      <summary>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="lbl when-shut">Open menu</span>
        <span class="lbl when-open">Close menu</span>
      </summary>
      <div class="panel">
        <nav aria-label="Main">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>
<script>
  // The instant-results layer. The form works without it: it is a GET to /search/, so Enter
  // submits and /search/ renders the same list from the same index. The fetch, the cache,
  // the matching and the grouping are src/lib/search.ts, shared with that page.
  import { loadIndex, matchRows, renderInto, optionsIn } from '../../lib/search';

  const MIN_CHARS = 2;
  const MAX = 8;

  for (const form of document.querySelectorAll<HTMLFormElement>('form.site-search')) {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]');
    const list = form.querySelector<HTMLUListElement>('ul.results');
    const status = form.querySelector<HTMLParagraphElement>('[role="status"]');
    if (!input || !list) continue;

    let active = -1;

    /** The option elements currently rendered, in reading order. */
    const options = () => optionsIn(list);

    const paint = () => {
      const opts = options();
      opts.forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
      const current = active >= 0 ? opts[active] : null;
      if (current) {
        input.setAttribute('aria-activedescendant', current.id);
        // The panel scrolls at 60vh, so an option moved to off the bottom has to be brought
        // back: the pointer user scrolls, the keyboard user cannot.
        current.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    };

    const close = () => {
      active = -1;
      list.hidden = true;
      list.textContent = '';
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    };

    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (q.length < MIN_CHARS) {
        close();
        // Clearing the status is NOT part of close(): Escape dismisses the panel while the
        // query — and therefore its count — is still on screen and still true. A query that
        // has dropped below MIN_CHARS has no count at all, and a stale "3 results." left
        // behind would be read out again the next time the region changed.
        if (status) status.textContent = '';
        return;
      }
      loadIndex().then((rows) => {
        // The field may have changed again while the index was in flight.
        const now = input.value.trim();
        if (now.length < MIN_CHARS) return;
        const written = renderInto(list, matchRows(rows, now), now, MAX,
                                   { optionIdPrefix: 'site-search-option' });
        active = -1;
        // `aria-expanded` describes the PANEL, so the panel and the attribute are decided
        // together and can never disagree. With nothing to show there is no panel: an
        // expanded combobox whose listbox holds no options promises a reader somewhere to
        // arrow into and hands them an empty box. The sentence goes to the polite status
        // line instead, which is where every other count already goes.
        if (written === 0) {
          close();
          if (status) status.textContent = `No results for ${now}.`;
          return;
        }
        input.setAttribute('aria-expanded', 'true');
        paint();
        if (status) status.textContent = `${written} result${written === 1 ? '' : 's'}.`;
      });
    });

    input.addEventListener('keydown', (e) => {
      const opts = options();
      const open = !list.hidden && opts.length > 0;
      if (e.key === 'Escape') {
        close();
        if (status) status.textContent = '';
        return;
      }
      if (!open) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        active = active + 1 >= opts.length ? 0 : active + 1;
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        active = active - 1 < 0 ? opts.length - 1 : active - 1;
      } else if (e.key === 'Home') {
        e.preventDefault();
        active = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        active = opts.length - 1;
      } else if (e.key === 'Enter') {
        // Only when something is highlighted. With nothing highlighted the form submits
        // and /search/ shows the whole list, which is the no-script behaviour too.
        const link = active >= 0 ? opts[active].querySelector('a') : null;
        if (!link) return;
        e.preventDefault();
        link.click();
        return;
      } else {
        return;
      }
      paint();
    });

    // Keeping the focus where it is, is what makes a MOUSE-chosen result survive. A pointer
    // going down inside the panel would otherwise move focus off the input, and the focusout
    // that follows empties the list — out from under the click that was on its way to the
    // anchor. `preventDefault()` on pointerdown suppresses the focus move (and the
    // compatibility mousedown) while leaving the anchor's own click to fire and navigate.
    list.addEventListener('pointerdown', (e) => e.preventDefault());

    // Dismiss when focus leaves the form entirely.
    //
    // SAFARI: `relatedTarget` is null on the focusout Safari fires when a pointer goes down
    // on a non-focusable element, so "did focus stay inside the form?" is a question the
    // event cannot answer — a null reads as "it left", close() empties the list, and the
    // result the reader clicked is gone before the click lands. The decision is therefore
    // deferred by one tick and asked of the DOCUMENT, which by then knows where focus
    // actually ended up, rather than of an event that only guessed.
    form.addEventListener('focusout', () => {
      setTimeout(() => {
        if (form.contains(document.activeElement)) return;
        close();
      }, 0);
    });
  }
</script>
<style>
  @layer components {
    .kit-hdr { position: sticky; top: 0; z-index: 50; background: var(--hdr-bg); border-bottom: 1px solid var(--color-border); min-height: var(--hdr); color: var(--color-text); }
    .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: var(--hdr); flex-wrap: wrap; }
    /* A 44x44 target (impeccable D3, the breeder's yes on every page, 2026-10-03 q04): the mark is
       40px, so the link is held to 44px and centres it; nothing moves but the link's own box. */
    .brand { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-3); min-width: 44px; min-height: 44px; text-decoration: none; color: inherit; }
    .brand:focus-visible, .nav a:focus-visible, .drawer summary:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .nav ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
    /* Every link at least 44px wide as well as tall (impeccable D3's chrome target, the breeder's yes
       on every page, 2026-10-03 q04; "Blog" was 29px, "Home" 38px, "Health" 43px; the London Harden
       pass 2026-10-05, F2): 8px of padding each side, cancelled by an 8px negative margin, so no
       word moves. The current-page rule is drawn as a 2px background band sized to the old box
       (100% less the 16px of padding), so it does not widen either. */
    .nav a { color: inherit; text-decoration: none; font-weight: 600; font-size: var(--text-sm); padding: var(--space-3) 8px; margin-inline: -8px; display: inline-block; min-height: 44px; line-height: 20px; }
    .nav a[aria-current="page"] { background: linear-gradient(var(--color-cta), var(--color-cta)) center bottom / calc(100% - 16px) 2px no-repeat; }

    /* Visually hidden, still announced: the search field's own label, the button's name,
       the hint and the status line. Scoped here rather than in kit.css because search is
       the first component in the kit that needs it (convention 9 moves it out on the
       SECOND). */
    .vh { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

    /* The search pill (S1). `position: relative` so the result list hangs off the field
       rather than pushing the bar taller as the reader types. */
    .site-search { position: relative; display: flex; align-items: center; gap: var(--space-1); background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-pill); padding-inline: var(--space-3); min-height: 44px; flex: 0 1 240px; }
    .site-search input { flex: 1 1 auto; min-width: 0; border: 0; background: none; color: inherit; font: inherit; font-size: var(--text-sm); padding-block: 10px; }
    .site-search input::placeholder { color: var(--color-text-muted); opacity: 1; }
    .site-search input:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
    .go { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-right: calc(var(--space-3) * -1 + 2px); border: 0; background: none; color: inherit; cursor: pointer; border-radius: 50%; }
    .go:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    /* The result list is its own bone panel: a result title is body text, and body text
       belongs on the reading surface. */
    .results { position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 60; margin: 0; padding: var(--space-2); list-style: none; background: var(--color-surface-raised); color: var(--color-text); border: var(--card-border); border-radius: var(--card-radius); box-shadow: var(--shadow-lift); max-height: 60vh; overflow: auto; min-width: 260px; }
    .results .group { font-size: var(--text-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-muted); padding: var(--space-2) var(--space-3) var(--space-1); }
    .results a { display: block; padding: var(--space-2) var(--space-3); color: var(--color-link); text-decoration: none; font-size: var(--text-sm); border-radius: var(--radius-sm); }
    .results a:hover { background: var(--color-brand-soft); }
    .results a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: -2px; }
    /* The keyboard's highlight. `aria-selected` is the state, so the paint follows the
       attribute rather than a second class the script has to keep in step with it. */
    .results [role="option"][aria-selected="true"] > a { background: var(--color-brand-soft); }
    /* No `.empty` rule here: with no matches this panel is HIDDEN and the sentence is spoken
       from the status line, so the empty row src/lib/search.ts writes for /search/ is never
       painted in the pill. */

    /* Mobile: the inline nav goes and the drawer arrives. The ONE search form goes with the
       nav while the drawer is shut, and comes back as a full-width second row of the bar
       while it is open — the same form element, moved by CSS, never a second copy. */
    .drawer { position: relative; display: none; }
    @media (max-width: 767px) {
      .bar { position: relative; }
      .nav { display: none; }
      .bar > .site-search { display: none; }
      .bar:has(.drawer[open]) > .site-search { display: flex; flex: 1 1 100%; order: 10; margin-bottom: var(--space-3); }
      /* :has() IS THE WHOLE MECHANISM, and there is no sibling combinator that can stand in
         for it: `<details class="drawer">` comes AFTER the form in the DOM (the form is in
         the tab order where a reader expects it, between the nav and the call to action),
         and `~` only ever looks forwards. So `.drawer[open] ~ .site-search` matches nothing
         no matter which browser reads it, and the fallback cannot be a selector — it has to
         be the absence of the rule that hides the form.
         THE TRADE: without :has(), the search pill stays visible as its own full-width row
         below 768px whether the drawer is open or not. That is one bar row the reader did
         not ask for, against a search box they could not reach at all — and it is the half
         of the failure that still works. */
      @supports not selector(:has(*)) {
        .bar > .site-search { display: flex; flex: 1 1 100%; order: 10; margin-bottom: var(--space-3); }
      }
      .drawer { display: block; position: static; }
    }
    .lbl { font-size: var(--text-sm); font-weight: 600; }
    .drawer:not([open]) .when-open, .drawer[open] .when-shut { display: none; }
    .drawer summary { list-style: none; cursor: pointer; display: inline-flex; gap: var(--space-2); padding: 10px; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }
    .drawer summary::-webkit-details-marker { display: none; }
    /* ONE ROW ON A PHONE (frontend-design FD-D1 on London, the breeder's yes with her addition,
       answer board 2026-10-06-london-harden-calls q04 (a): "logo left, 'Available puppies' and menu
       icon right on phone"). Below 640px the summary's "Open menu" / "Close menu" word is visually
       hidden, never removed: the shown span is still the summary's text, so it is announced "Open
       menu" (and "Close menu" when open) and the icon stays a 44x44 target. The brand link and the
       summary are both 44px wide, so space-between sets the pill in the exact centre of the row.
       The bar is --hdr tall (72px below 640px on a kit page, global.css). Under 360px the row is
       too narrow for the pill's 24px side padding plus the two gaps (320px: 272px of row for
       297px), so below 640px the row's gap is 8px, and under 360px the pill's padding is 16px
       (the unlayered rule at the end, which the Tailwind px-6 utility would otherwise beat). */
    @media (width < 640px) {
      .bar { gap: var(--space-2); }
      .drawer summary .lbl { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
    }
    /* The open panel is its own dark band, so it names the on-inverse text and ring rather
       than inheriting the bone bar's near-black `color` onto a steel background. */
    .drawer[open] .panel { position: absolute; right: 0; top: 100%; min-width: 280px; background: var(--color-surface-inverse); color: var(--color-text-on-inverse); --kit-ring: var(--color-focus-on-inverse); padding: var(--space-5); border-radius: 0 0 var(--card-radius) var(--card-radius); box-shadow: var(--shadow-lift); display: grid; gap: var(--space-4); }
    .drawer nav a:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .drawer nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
    .drawer nav a { color: inherit; text-decoration: none; font-weight: 600; display: block; padding: var(--space-2) 0; min-height: 44px; }
    .drawer nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--color-cta); }
  }
  /* Unlayered on purpose: the pill's side padding is the Tailwind px-6 utility, and the utilities
     layer beats @layer components. Under 360px only (FD-D1, see the phone-row note above). */
  @media (width < 360px) {
    .bar > :global(.kit-btn) { padding-inline: var(--space-4); }
  }
</style>
