---
// src/components/kit/CityLookListenChecklist.astro — city component 18, the video-call checklist
// (London board revision, answer board 2026-10-03-london-board-revision q03 (b): checklist style
// B, "Look and listen"; preview docs/artifacts/london-board-revision-preview.html). Two panes,
// what you ask to SEE on camera and what you ask to HEAR out loud, each a list of native
// checkboxes inside their labels. No script and nothing saved: a tick lasts as long as the tab.
// Side by side from a 640px box, stacked below it.
//
// TIGHT SPACING (London final fixes W2, the breeder's yes, answer board 2026-10-05 q01 (a),
// docs/reference/answer-board/answers/2026-10-05-london-final-fixes-2026-10-05.md): its answer
// ran 34px over the per-answer height cap at 375 and 8px at 1280, all of it spacing. Tick rows
// 10px to 8px, the list's inner padding 4/8px to 2/4px, the pane header 11px to 9px and the gap
// under the checklist 24px to 16px. No word moves; the label stays a 44px-plus tap target.
//
// THE ITEMS ARE THE CALLER'S, word for word from the board record (subcomponents[video-call-
// checklist].items), with every figure, clause and guarantee wording interpolated by the caller
// from data/settings.json and data/puppies.json. The component types no fact. It adds no link and
// no heading: the pane titles are labels, so the page's outline is unchanged. Conventions 2, 4, 6.
//
// A STATEMENT LABEL (London close proposals q02 (a), answer board 2026-10-05): an item may carry
// `stmt`, a kind and a note, set on its own line under the item's text by StatementLine.astro.
import '../../styles/city.css';
import type { HTMLAttributes } from 'astro/types';
import StatementLine from './StatementLine.astro';
import type { Statement } from '../../lib/statement';

export interface CheckItem { label: string; detail: string; stmt?: Statement }
export interface CheckPane { title: string; hint: string; icon: 'look' | 'listen'; items: CheckItem[] }
type Props = HTMLAttributes<'div'> & { panes: CheckPane[] };
const { panes, class: cls, ...rest } = Astro.props;
if (panes.length !== 2) throw new Error(`CityLookListenChecklist: ${panes.length} panes; the style is one to look and one to listen`);
const empty = panes.filter((p) => !p.items.length).map((p) => p.title);
if (empty.length) throw new Error(`CityLookListenChecklist: no items under ${empty.join(', ')}`);
---
<div {...rest} class:list={['city-kit', 'city-look-listen', cls]} data-call-checklist>
  <div class="panes">
    {panes.map((p) => (
      <div class="pane" data-pane={p.icon}>
        <p class="pane-hd">
          {p.icon === 'look'
            ? <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
            : <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v10H9l-5 4z" /><path d="M8 9.5h8M8 12h5" /></svg>}
          <span><b>{p.title}</b><small>{p.hint}</small></span>
        </p>
        <ul>
          {p.items.map((it) => (
            <li>
              <label>
                <input type="checkbox" />
                <span><span class="t">{it.label}</span><span class="d">{it.detail}</span>{it.stmt && <StatementLine as="span" space="above" kind={it.stmt.kind} note={it.stmt.note} />}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
<style>
  @layer components {
    .city-look-listen { margin: var(--space-4) 0 var(--space-4); }
    .panes { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
    .pane { background: var(--color-white); border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden; min-width: 0; }
    .pane-hd {
      margin: 0; display: flex; align-items: center; gap: 10px; padding: 9px 16px;
      background: var(--color-brand); color: var(--color-text-on-inverse);
    }
    .pane-hd svg { flex: none; fill: none; stroke: var(--color-link-on-inverse); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .pane-hd b { display: block; font-family: var(--font-display); font-weight: 650; font-size: 17px; line-height: 1.2; }
    .pane-hd small { display: block; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.04em; color: var(--color-link-on-inverse); }
    ul { list-style: none; margin: 0; padding: 2px 16px 4px; }
    li { margin: 0; }
    li + li { border-top: 1px solid var(--color-border); }
    label { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; align-items: start; cursor: pointer; padding: 8px 0; }
    input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--color-brand); cursor: pointer; }
    input:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    .t { display: block; font-weight: 700; font-size: 16px; line-height: 1.35; color: var(--color-text); }
    .d { display: block; margin-top: 2px; font-size: 15px; line-height: 1.5; color: var(--color-ink-2); }
    label:has(input:checked) .t {
      text-decoration: line-through; text-decoration-color: var(--color-brass-500); text-decoration-thickness: 2px;
    }
    @container (width >= 640px) { .panes { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; } }
  }
</style>
