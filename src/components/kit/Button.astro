---
// src/components/kit/Button.astro — the five button treatments (spec §5 #3).
// a pill/cta · b pill/outline · c pill/inverse · d form submit (md radius) · e text link with arrow
//
// Brass (`--color-cta`) is 2.1:1 on the bone surface, so it is only ever a FILL carrying
// `--color-cta-ink` text (a, d) — never the colour of the label itself.
//
// The focus ring reads `--kit-ring` (global.css), which the surface sets. Variant c paints
// its own dark band, so it sets `--kit-ring` on itself: the ring sits partly on the button's
// steel fill, where the steel `--color-focus` would be 1:1 and invisible.
import type { HTMLAttributes } from 'astro/types';
import type { Variant } from './_variant';
type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & { variant?: Variant; label: string };
const { variant = 'a', label, class: cls, ...rest } = Astro.props as Props & { class?: string };
const base = 'kit-btn inline-flex items-center justify-center gap-2 font-semibold no-underline transition-colors';
const byVariant: Record<Variant, string> = {
  a: 'rounded-[var(--btn-radius)] bg-cta text-cta-ink px-6 py-3 text-base hover:bg-cta-hover',
  b: 'rounded-[var(--btn-radius)] border-2 border-brand text-brand px-6 py-[10px] text-base hover:bg-brand-soft',
  c: 'rounded-[var(--btn-radius)] bg-surface-inverse text-text-on-inverse px-6 py-3 text-base hover:bg-surface-deep',
  d: 'rounded-[var(--btn-form-radius)] bg-cta text-cta-ink px-5 py-3 text-base w-full hover:bg-cta-hover',
  e: 'text-link underline-offset-4 hover:underline px-0 py-2 text-base',
};
// `class:list` drops empty entries, so a caller that passes no `class` gets no trailing space.
const classes = [base, byVariant[variant], cls];
// Variant c is the only one that carries its own inverse surface with it.
const ringStyle = variant === 'c' ? '--kit-ring: var(--color-focus-on-inverse);' : undefined;
const href = 'href' in rest ? (rest as { href?: string }).href : undefined;
// Pulled out of `rest`, not defaulted in the tag: Astro emits a spread attribute and a
// literal attribute of the same name side by side (`type="button" type="submit"`).
const { type: restType, ...attrs } = rest as { type?: 'button' | 'submit' };
const buttonType = restType ?? 'button';
const arrow = '<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
{href
  ? <a {...attrs as HTMLAttributes<'a'>} class:list={classes} style={ringStyle} data-variant={variant}>{label}{variant === 'e' && <Fragment set:html={arrow} />}</a>
  : <button {...attrs as HTMLAttributes<'button'>} type={buttonType} class:list={classes} style={ringStyle} data-variant={variant}>{label}{variant === 'e' && <Fragment set:html={arrow} />}</button>}
<style>
  @layer components {
    .kit-btn { transition-duration: var(--dur-base); transition-timing-function: var(--ease-out); min-height: 44px; }
    .kit-btn:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
  }
</style>
