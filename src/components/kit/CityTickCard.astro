---
// src/components/kit/CityTickCard.astro — Manchester's key takeaways (pick:
// manchester/key-takeaways/c, "Tick card"; frozen 355d5e43; a pool copy of London's tick card,
// refreshed on LAYOUT). One raised card on the bone page: a served photograph across its top,
// then the card's title and its short answer side by side, then the outline's five facts as brass
// ticks two to a row, the odd last one across both columns, and one brass pill. Outline row 5
// carries no heading, so the title is a line of type, never an h2. Built from
// design/city-canvas/manchester/key-takeaways/c.html as the visual spec only; it imports no
// London component (rules/design.md own-components-per-page).
//
// AN IN-BODY COMPONENT FOLLOWS ITS OWN BOX (src/styles/city.css): its tiers are container
// queries on the root, so in the 656px column beside the dial at 1024 it lays out as it does on
// a 656px preview. The canvas's 768px viewport edge is the 640px box edge here.
//
// EVERY FACT IS DATA (working rule 9; outline row 5's note): the two prices, the deposit ruling,
// the transport, the band and how it is priced, the town, the two DNA tests (named, never a
// result, certificates on request: Known Issue 98) and the guarantee's label and cover, all
// through src/lib/cityKit.ts. Only the page's city is passed in (`city`, data/locations.json).
//
// THE PHOTO is a served file (working rule 11): its original path and its served alt, word for
// word, on what is its first use on the page; its crop is solved for the card's 2:1 box
// (src/lib/imageFocus.ts focusClassFor), so both faces stay whole.
import '../../styles/city.css';
import type { HTMLAttributes } from 'astro/types';
import { focusClassFor, servedPhoto } from '../../lib/imageFocus';
import {
  availablePuppies, citySizes, keepRuns, depositFact, guaranteeFact, transportName, pricedBy,
  BOY_PRICE, GIRL_PRICE, DELIVERY_BAND, DEPOSIT, TOWN, PARENT_DNA_TESTS, type CityFit,
} from '../../lib/cityKit';
import { numberWord } from '../../lib/recordText';

type Props = HTMLAttributes<'section'> & {
  /** The page's city, from data/locations.json `city`. */
  city: string;
  /** A served /images/ file named in data/image-focus.json (it brings its served alt). */
  photo: string;
  /** The card's one action: the page's enquiry. */
  cta: { label: string; href: string };
  /** Where the section sits from 1024px, for its photo's `sizes` (src/lib/cityKit.ts `CityFit`). */
  fit?: CityFit;
};
const { city, photo, cta, fit = 'column', class: cls, ...rest } = Astro.props;
const p = servedPhoto(photo);

const pups = availablePuppies();
const has = (sex: 'male' | 'female') => pups.some((x) => x.sex === sex);
const price = has('male') && has('female')
  ? `Each boy in this litter is ${BOY_PRICE} and each girl ${GIRL_PRICE}, whatever the coat.`
  : `Each ${has('male') ? 'boy' : 'girl'} in this litter is ${has('male') ? BOY_PRICE : GIRL_PRICE}, whatever the coat.`;
const [testA, testB] = PARENT_DNA_TESTS;
const ticks = [
  price,
  depositFact,
  `We deliver by ${transportName} for ${DELIVERY_BAND}, ${pricedBy}, or you collect in ${TOWN}.`,
  `Both parents are DNA tested for ${testA} and ${testB}, with the certificates shared on request.`,
  guaranteeFact(),
].map((t) => keepRuns(t, [BOY_PRICE, GIRL_PRICE, DEPOSIT, DELIVERY_BAND]));
const count = numberWord(ticks.length);
// The card: the box less its 16px gutters on a phone and 24px from a 640px box, at most 720px.
const sizes = citySizes(fit, {
  phone: (B) => `calc(${B} - 32px)`,
  tablet: (B) => `min(720px, calc(${B} - 48px))`,
  desktop: (B) => `min(720px, calc(${B} - 48px))`,
});
---
<section {...rest} class:list={['city-kit', 'city-tick-card', cls]}>
  <div class="card">
    <figure class="pic">
      <img src={p.file} srcset={p.srcset} sizes={p.srcset ? sizes : undefined}
        alt={p.alt} width={p.w} height={p.h} class={focusClassFor(photo, 2)} loading="lazy" decoding="async" />
    </figure>
    <div class="body">
      <div class="head">
        <p class="ttl">Before you ask about a puppy for your {city} home</p>
        <p class="lede">{count.charAt(0).toUpperCase() + count.slice(1)} plain answers from us, as they stand for this litter today.</p>
      </div>
      <ul>
        {ticks.map((runs) => (
          <li data-takeaway>
            <span class="tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg></span>
            <span>{runs.map((r) => (r.keep ? <span class="keep">{r.text}</span> : r.text))}</span>
          </li>
        ))}
      </ul>
      <p class="foot"><a class="cta" href={cta.href}>{cta.label}</a></p>
    </div>
  </div>
</section>
<style>
  @layer components {
    /* An in-body container (src/styles/city.css): no inline padding on the root, so its content
       box is its box; the card's own width is its gutter. */
    .city-tick-card { background: var(--color-surface); padding: var(--space-6) 0; }
    .card {
      width: calc(100% - 2 * var(--space-4)); max-width: 720px; margin: 0 auto; overflow: hidden;
      background: var(--color-surface-raised); border: var(--card-border); border-radius: var(--card-radius);
      box-shadow: var(--shadow-card);
    }
    .pic { margin: 0; }
    /* Bone behind the photo while it loads, never a grey box (rules/design.md, bleed in bone). */
    .pic img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; background: var(--color-bone-50); }
    .body { padding: var(--space-5) var(--space-4) var(--space-6); }
    /* A title in the display face that is not a heading (outline row 5 has none): a step under the
       tier's H2, at most the canvas's 23px. */
    .ttl {
      margin: 0 0 var(--space-2); font-family: var(--font-display); font-weight: 600;
      font-size: min(23px, calc(var(--city-h2) - 2px)); line-height: 1.3; color: var(--color-brand); text-wrap: balance;
    }
    .lede { margin: 0 0 var(--space-5); color: var(--color-text-muted); }
    ul {
      list-style: none; margin: 0; padding: var(--space-5) 0 0; border-top: 1px solid var(--color-border);
      display: grid; gap: var(--space-4);
    }
    li {
      margin: 0; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: var(--space-3); align-items: start;
      color: var(--color-text);
    }
    .tick {
      display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
      background: var(--color-cta); color: var(--color-cta-ink);
    }
    .tick svg { width: 16px; height: 16px; }
    .foot { margin: var(--space-6) 0 0; }
    .cta {
      display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--space-6); border-radius: var(--btn-radius);
      background: var(--color-cta); color: var(--color-cta-ink); font-weight: 700; text-decoration: none;
      transition: background-color var(--dur-fast) var(--ease-out);
    }
    .cta:hover { background: var(--color-cta-hover); }
    .cta:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    /* From a 640px box: the 2:1 photo, the title beside its answer, the ticks two to a row. An odd
       last tick takes the whole row rather than sitting alone beside an empty cell (Task 24). */
    @container (width >= 640px) {
      .city-tick-card { padding: var(--space-10) 0; }
      .card { width: calc(100% - 2 * var(--space-5)); }
      .pic img { aspect-ratio: 2 / 1; }
      .body { padding: var(--space-7); }
      /* The title takes the wider share (frontend-design, Task 30: at an even split it stacked to
         three lines beside a two-line answer, a chunky title in a ragged head). */
      .head {
        display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-6);
        align-items: start; margin-bottom: var(--space-5);
      }
      .ttl, .lede { margin: 0; }
      ul { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-5) var(--space-6); }
      li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    }
  }
</style>
