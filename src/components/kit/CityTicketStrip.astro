---
// src/components/kit/CityTicketStrip.astro — city component 17, the puppy cards. First built as
// the "Ticket strip" (answer board 2026-10-03-london-board-revision q02 (a)); restyled as CARD-3,
// "the steel pass", by the breeder's pick on the London previews (answer board 2026-10-04 q08 (c),
// docs/reference/answer-board/answers/2026-10-04-london-asset-gate-and-previews-2026-10-04.md;
// preview and diff docs/reports/london-previews-2026-10-04/). One card per available puppy on a
// steel panel: the name (the card's one link, to /available-puppies/<slug>/, a nav link on the
// board) with Boy or Girl and the colour, the price as a brass chip, the breeder's own line on the
// puppy, what comes home with it, then the delivery band and an arrow on a steel-100 stub.
//
// ITS OWN BAND, straight after the takeaways section (previews 2026-10-04, "Mount"): inside the
// takeaways the cards pushed that section past its height gate. It is a band, not a section: no
// heading and no data-section-label, so the outline, the nav set and seams = sections (M5) are
// unchanged.
//
// NO PHOTO: the hero filmstrip shows the same faces one screen up, and a second copy would repeat
// their alts (working rule 11).
//
// EVERY WORD IS DATA (working rule 9): name, sex, colour, price (cityKit `money(price_gbp)`) and
// the personality line from data/puppies.json (the breeder's approved lines, q07 (a)); the trust
// signs from data/settings.json `puppy_trust_signs`, then `guarantee_label` appended, never typed;
// the delivery line is cityKit `deliveryLine` (rules/puppies.md `delivery-band-on-every-card`).
// A puppy with no personality line stops the build.
//
// THE WHOLE CARD IS ONE TAP TARGET: the name link's ::before is stretched over the card. Hover
// moves only transform and opacity (a 3px lift and a --shadow-lift layer fading in), and both are
// off under prefers-reduced-motion. Conventions 2, 4, 6; brass is a fill (the price chip) with
// --color-cta-ink text.
import '../../styles/city.css';
import type { HTMLAttributes } from 'astro/types';
import settings from '../../../data/settings.json';
import { availablePuppies, deliveryLine, money, sexWord } from '../../lib/cityKit';
import { numberWord } from '../../lib/recordText';

type Props = HTMLAttributes<'div'> & {
  /** The words before the count's noun are the component's; the caller may replace the label. */
  label?: string;
};
const pups = availablePuppies();
if (!pups.length) throw new Error('CityTicketStrip: data/puppies.json has no available puppy');
for (const p of pups) {
  if (!(p.personality ?? '').trim()) throw new Error(`CityTicketStrip: ${p.slug} has no personality line in data/puppies.json`);
}
const signs = (settings as { puppy_trust_signs?: string[] }).puppy_trust_signs ?? [];
if (!signs.length) throw new Error('CityTicketStrip: data/settings.json has no puppy_trust_signs');
const trust = [...signs, settings.guarantee_label];
const { label = `Our ${numberWord(pups.length)} puppies · each opens its own page`, class: cls, ...rest } = Astro.props;
const CHECK = 'M5 12.5l4.5 4.5L19 7.5';
---
<div {...rest} class:list={['city-kit', 'city-ticket-strip', cls]} data-ticket-strip>
  <div class="in">
    <p class="label">{label}</p>
    <ul class="grid">
      {pups.map((p) => (
        <li>
          <article class="pc" data-ticket={p.slug}>
            <div class="pc-top">
              <p class="pc-name"><a href={`/available-puppies/${p.slug}/`}>{p.name}</a></p>
              <p class="pc-meta">{sexWord(p)} · {p.colour}</p>
              <p class="pc-price">{money(p.price_gbp)}</p>
            </div>
            <p class="pc-say">{p.personality}</p>
            <ul class="pc-trust" aria-label={`Comes home with ${p.name}`}>
              {trust.map((t) => (
                <li><svg class="ic" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CHECK} /></svg><span>{t}</span></li>
              ))}
            </ul>
            <div class="pc-stub">
              <p class="pc-del">{deliveryLine}</p>
              <span class="pc-go" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  @layer components {
    .city-ticket-strip { background: var(--color-surface); display: flow-root; }
    /* The steel pass: the cards sit on a surface-inverse panel, set in like the chapter trays. */
    .in {
      max-width: min(1100px, calc(100% - 2 * var(--space-4))); margin: var(--space-5) auto;
      padding: 16px 12px; border-radius: var(--radius-lg); background: var(--color-surface-inverse);
    }
    .label {
      margin: 0 0 var(--space-3); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--color-link-on-inverse); max-inline-size: 60ch; line-height: 1.5;
    }
    .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: minmax(0, 1fr); }
    .grid > li { margin: 0; min-width: 0; max-width: none; }
    .pc {
      position: relative; height: 100%; display: flex; flex-direction: column; gap: 8px; isolation: isolate;
      padding: 12px 14px; border-radius: var(--radius-md); background: var(--color-bone-50);
      transition: transform var(--dur-base) var(--ease-out);
    }
    .pc::after {
      content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: var(--shadow-lift);
      opacity: 0; z-index: -1; pointer-events: none; transition: opacity var(--dur-base) var(--ease-out);
    }
    .pc:hover { transform: translateY(-3px); }
    .pc:hover::after { opacity: 1; }
    .pc:focus-within { outline: 3px solid var(--color-focus-on-inverse); outline-offset: 3px; }
    p { margin: 0; max-inline-size: none; }
    .pc-top {
      display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name price" "meta price";
      column-gap: 10px; align-items: center;
    }
    .pc-name { grid-area: name; font-family: var(--font-display); font-weight: 650; font-size: var(--text-lg); line-height: 1.25; color: var(--color-brand); }
    .pc-name a { color: inherit; text-decoration: none; outline: none; }
    /* The whole card is the name link's tap target. */
    .pc-name a::before { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
    .pc-meta { grid-area: meta; font-size: 14px; line-height: 1.35; color: var(--color-ink-2); margin-top: 2px; }
    .pc-price {
      grid-area: price; align-self: center; padding: 6px 12px; border-radius: var(--radius-pill);
      background: var(--color-cta); color: var(--color-cta-ink); font-family: var(--font-display); font-weight: 650;
      font-size: 18px; line-height: 1.1; font-feature-settings: "tnum", "lnum"; white-space: nowrap;
    }
    .pc-say { font-size: var(--text-sm); line-height: 1.4; font-style: italic; color: var(--color-text); }
    .pc-trust { list-style: none; margin: 0; padding: 8px 0 0; display: flex; flex-wrap: wrap; gap: 1px 10px; border-top: var(--card-border); }
    .pc-trust li {
      margin: 0; max-width: none; display: flex; gap: 6px; align-items: flex-start;
      font-size: var(--text-xs); line-height: 1.3; color: var(--color-ink-2);
    }
    .pc-trust .ic { flex: none; margin-top: 2px; color: var(--color-ok); }
    .pc-stub {
      display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 8px; margin-top: auto;
      padding: 8px 12px; border-radius: var(--radius-sm); background: var(--color-brand-soft);
    }
    .pc-del { font-size: var(--text-xs); line-height: 1.4; color: var(--color-text); font-weight: 600; }
    .pc-go { color: var(--color-brand); display: inline-flex; transition: transform var(--dur-base) var(--ease-out); }
    .pc:hover .pc-go { transform: translateX(3px); }
    /* The kit's two tier edges (cityKit TIER): two cards to a row from a tablet box, three from a
       desktop box (the 832px column beside the dial at 1280). */
    @container (width >= 640px) {
      .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .in { max-width: min(1100px, calc(100% - 2 * var(--space-6))); padding: var(--space-5); margin-block: var(--city-pad-y); }
      .pc { padding: 14px 16px; gap: 10px; }
    }
    @container (width >= 800px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (prefers-reduced-motion: reduce) {
      .pc, .pc::after, .pc-go { transition: none; }
      .pc:hover, .pc:hover .pc-go { transform: none; }
    }
  }
</style>
