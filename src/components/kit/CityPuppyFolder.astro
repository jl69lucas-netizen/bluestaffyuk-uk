---
// src/components/kit/CityPuppyFolder.astro — Manchester's trust strip (pick:
// manchester/trust-strip/b, "Puppy folder"; frozen 355d5e43). The paperwork is drawn as what it
// is: a brass-tinted folder with a tab, holding the papers and records each puppy leaves with,
// each a paper slip with a line icon. Beside it, how a puppy reaches a home in the page's city:
// the deposit that holds it, then delivery or collection (the user's note on trust B, Task 26:
// the hero's ticks carry home, support and the guarantee, so this column says what only this
// strip needs). All of it inset in one soft steel panel on the bone page. Phones: intro, folder,
// then the three steps; from 1024px the three sit side by side. Built from
// design/city-canvas/manchester/trust-strip/b.html as the visual spec only; it imports no London
// component (rules/design.md own-components-per-page).
//
// EVERY LINE IS DATA (working rule 9): the folder's slips are data/settings.json
// `puppy_trust_signs` (each one this component draws an icon for, in the data's order, and a
// sign the data rewords stops the build through `sign()`); the deposit, the delivery band and the
// town are src/lib/cityKit.ts's. The deposit is never called refundable here: the slip states
// what it does, and its refund clause belongs to a deposit-terms sentence (Phase F ruling 10).
import '../../styles/city.css';
import type { HTMLAttributes } from 'astro/types';
import { DEPOSIT, DELIVERY_BAND, TOWN, PUPPY_SIGNS, sign } from '../../lib/cityKit';
import { numberWord } from '../../lib/recordText';

type Props = HTMLAttributes<'section'> & {
  /** The page's city, from data/locations.json `city`. */
  city: string;
};
const { city, class: cls, ...rest } = Astro.props;

/** The slips' line icons on the 24 grid, stroked in currentColor (the canvas's own set). Each key
 *  is a data sign, checked by `sign()`, so a reworded sign fails here rather than losing its slip. */
const PAPER_ICONS: Record<string, string> = {
  [sign('Vet-signed health card')]: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM12 8v6M9 11h6M9 17h6',
  [sign('First vaccinations')]: 'm18 2 4 4M17 7l3-3M19 9 9 19l-4 1 1-4L16 6zM14 8l2 2M11 11l2 2',
  [sign('Microchipped')]: 'M8 7h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4',
  [sign('Wormed and flea treated')]: 'M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5zM9 12h6',
  [sign('KC registration application form')]: 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5',
};
const papers = PUPPY_SIGNS.filter((s) => s in PAPER_ICONS);

const STEP_ICONS = {
  deposit: 'M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8zM6.5 8a1.5 1.5 0 1 0 3 0 1.5 1.5 0 1 0-3 0',
  delivery: 'M2 7h11v9H2zM13 10h4l4 3.5V16h-8zM4.7 17.5a1.8 1.8 0 1 0 3.6 0 1.8 1.8 0 1 0-3.6 0M15.2 17.5a1.8 1.8 0 1 0 3.6 0 1.8 1.8 0 1 0-3.6 0',
  collect: 'M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12zM9.5 9a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0-5 0',
};
---
<section {...rest} class:list={['city-kit', 'city-puppy-folder', cls]}>
  <div class="panel">
    <p class="intro"><b>The puppy folder.</b> The {numberWord(papers.length)} papers and records that go home with every one of our puppies.</p>
    <div class="folder">
      <p class="tab">In the folder</p>
      <ul class="docs">
        {papers.map((s) => (
          <li data-trust-item>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={PAPER_ICONS[s]} /></svg>
            {s}
          </li>
        ))}
      </ul>
    </div>
    <div class="steps">
      <p class="with">From us to {city}</p>
      <ul class="us">
        <li data-trust-item>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={STEP_ICONS.deposit} /></svg>
          {DEPOSIT} deposit secures your puppy
        </li>
        <li data-trust-item>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={STEP_ICONS.delivery} /></svg>
          <span>UK home delivery, <span class="keep">{DELIVERY_BAND}</span> by distance</span>
        </li>
        <li data-trust-item>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={STEP_ICONS.collect} /></svg>
          Or collect from us in {TOWN}
        </li>
      </ul>
    </div>
  </div>
</section>
<style>
  @layer components {
    /* A full-width strip, the viewport wide (src/styles/city.css): the root carries no inline
       padding, the panel's own margin and padding are its gutters. */
    .city-puppy-folder { background: var(--color-surface); padding: var(--space-5) 0; }
    .panel {
      max-width: min(1120px, calc(100% - 2 * var(--space-4))); margin: 0 auto;
      background: var(--color-brand-soft); border-radius: var(--radius-lg);
      padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-6);
    }
    .intro { margin: 0; font-size: var(--text-base); line-height: 1.5; color: var(--color-text); max-width: 40ch; }
    .intro b { font-family: var(--font-display); font-weight: 600; color: var(--color-brand); }
    /* The tab rides on the folder's top edge: the folder's top margin is the tab's room. */
    .folder {
      position: relative; margin-top: var(--space-5); padding: var(--space-4);
      background: var(--color-cta-soft); border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md);
    }
    .tab {
      position: absolute; left: 0; bottom: 100%; margin: 0; padding: var(--space-1) var(--space-4) 0;
      background: var(--color-cta-soft); border-radius: var(--radius-md) var(--radius-md) 0 0;
      font-size: var(--text-sm); line-height: 1.6; font-weight: 700; color: var(--color-brand);
    }
    ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
    .docs li {
      display: flex; align-items: center; gap: var(--space-3); margin: 0; max-width: none;
      padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm);
      background: var(--color-surface-raised); box-shadow: var(--shadow-card);
      font-weight: 600; line-height: 1.35; color: var(--color-text);
    }
    /* Balanced, so no step ends on one word ("£500 deposit / secures your puppy"; impeccable,
       Task 26). */
    .us li {
      display: flex; align-items: center; gap: var(--space-3); margin: 0; max-width: none;
      padding: var(--space-2) 0; font-weight: 600; line-height: 1.35; color: var(--color-text); text-wrap: balance;
    }
    .us li + li { border-top: 1px solid var(--color-steel-300); }
    svg { width: 22px; height: 22px; flex: none; color: var(--color-brand); }
    .with { margin: 0 0 var(--space-2); font-size: var(--text-sm); font-weight: 700; color: var(--color-brand); }
    /* Two slips a row from 640px; an odd last slip takes the whole row, so the folder never ends
       on one slip beside an empty cell (frontend-design, Task 28: at 1024 "KC registration
       application form" ran to three lines in a half-width cell). */
    @media (width >= 640px) {
      .docs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .docs li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    }
    @media (width >= 1024px) {
      .city-puppy-folder { padding: var(--space-6) 0; }
      .panel {
        max-width: min(1120px, calc(100% - 2 * var(--space-5)));
        grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr) minmax(0, .9fr); column-gap: var(--space-7);
        align-items: end; padding: var(--space-7) var(--space-7) var(--space-6);
      }
      .intro { align-self: center; }
    }
  }
</style>
