---
// src/components/kit/Faq.astro — spec §5 #9. Native <details>, five treatments.
// a plus icon · b chevron · c numbered · d bordered cards · e divided list
//
// Native <details>/<summary>, not a scripted accordion: it opens with JavaScript off, it
// is keyboard-operable and announced without an aria-expanded of our own, and the browser
// handles find-in-page opening the right panel. The question is an <h3> inside the
// <summary> so the answers are navigable as a heading list; <summary> permits flow
// content, and the disclosure role stays on the <summary> itself.
//
// THE ROWS ARE DATA (rule 9): data/faq.json via src/lib/faq.ts, each row naming in
// `source` the page or settings file that backs its answer, with the money and the
// delivery wording interpolated from data/settings.json at load. The plan's third question
// was "can we meet the mother"; the migrated pages make that claim only as generic buying
// advice in the buying guide, never as a promise this breeder makes, so the third row is
// the puppy package the homepage already describes.
//
// Rule 7: the markers are inline stroke SVG, never an emoji. Convention 2: the summary's
// focus ring reads --kit-ring, so it survives on a dark band.
import type { HTMLAttributes } from 'astro/types';
import type { Variant } from './_variant';
import { loadFaq, type FaqRow } from '../../lib/faq';

type Props = HTMLAttributes<'div'> & { variant?: Variant; items?: FaqRow[] };
const { variant = 'a', items = loadFaq(), class: cls, ...rest } = Astro.props;
---
<div {...rest} class:list={['kit-faq', `kit-faq-${variant}`, cls]} data-variant={variant}>
  {items.map((it, i) => (
    <details class:list={[variant === 'd' && 'kit-card']}>
      <summary>
        {variant === 'c' && <span class="num">{String(i + 1).padStart(2, '0')}</span>}
        <h3 class="q">{it.q}</h3>
        {variant === 'a' && <svg class="ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>}
        {variant === 'b' && <svg class="ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>}
      </summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>
<style>
  @layer components {
    .kit-faq { max-width: 640px; display: grid; gap: var(--space-2); color: var(--color-text); }
    details { background: var(--color-surface-raised); border-radius: var(--radius-md); }
    summary { display: flex; align-items: center; gap: var(--space-3); cursor: pointer; list-style: none; padding: var(--space-4); min-height: 44px; font-weight: 600; font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-brand); }
    summary::-webkit-details-marker { display: none; }
    .q { flex: 1; margin: 0; font: inherit; color: inherit; }
    .ico { transition: transform var(--dur-base) var(--ease-out); }
    details[open] .ico { transform: rotate(45deg); }
    .kit-faq-b details[open] .ico { transform: rotate(180deg); }
    p { margin: 0; padding: 0 var(--space-4) var(--space-4); font-size: var(--text-base); }
    /* The number is a muted label, not brass: brass is 2.1:1 as small text on bone. */
    .num { font-family: var(--font-body); font-size: var(--text-sm); color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
    /* d's shell is .kit-card from src/styles/kit.css (convention 9), applied as a CLASS
       rather than as a `.kit-faq-d details` rule, so d differs from e in what it renders
       and not only in this stylesheet. */
    .kit-faq-e { gap: 0; }
    .kit-faq-e details { border-radius: 0; border-bottom: 1px solid var(--color-border); background: transparent; }
    .kit-faq-e summary { padding-inline: 0; }
    .kit-faq-e p { padding-inline: 0; }
    /* --kit-ring, not --color-focus: the ring has to survive if this list is dropped on a
       steel band, where the fixed focus token is the band's own colour (convention 2). */
    summary:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
    @media (prefers-reduced-motion: reduce) { .ico { transition: none; } }
  }
</style>
