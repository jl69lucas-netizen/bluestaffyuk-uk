---
// src/components/kit/SiteFooterKit.astro — the footer (spec §5 #12). Picked 2026-09-18:
// the four-column arrangement — brand, Explore, Contact, Follow — over the legal row.
// It replaces SiteFooter.astro in project 4.
//
// EVERY LINK AND EVERY CONTACT ROW IS DATA (rule 9): the explore list is NAV from
// src/lib/site.ts — the same list the header renders, so a renamed page cannot leave a
// dead footer link — and the address line, the email, the hours and the social profiles
// are data/settings.json. Nothing here is typed out a second time, and the footer owns no
// copy of its own.
//
// The footer carries its own dark fill, so it declares data-surface="inverse": that flips
// --kit-ring to the on-inverse focus colour for everything inside it (convention 2) and
// switches any .kit-chip dropped in here. No colour is spelled — the hairline above the
// legal row is a color-mix of currentColor, so it follows the text on whatever surface
// the footer is retuned to.
//
// Tap targets: a footer link list is a column of close neighbours, so SC 2.5.8's spacing
// exception never applies and every link is a 44px line box (layout-tap-target-size).
import type { HTMLAttributes } from 'astro/types';
import { SITE, NAV } from '../../lib/site';
import Mark from './Mark.astro';

type Props = HTMLAttributes<'footer'>;
const { class: cls, ...rest } = Astro.props;

const year = new Date().getFullYear();
const socials = Object.entries(SITE.socials) as [string, string][];
const socialLabel = (key: string) => (key === 'x' ? 'X' : key[0].toUpperCase() + key.slice(1));
const legal = [{ href: '/privacy-policy-uk/', label: 'Privacy policy' }];
---
<footer
  {...rest}
  class:list={['kit-ftr', cls]}
  data-surface="inverse"
>
  <div class="container grid">
    <div class="brand">
      <Mark inverse size={40} title={`${SITE.site_name} mark`} />
      <p class="word">{SITE.site_name}<small>{SITE.location_label}</small></p>
      <p class="tag">{SITE.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>

    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li class="plain">{SITE.hours}</li>
        <li class="plain">{SITE.location_label}</li>
      </ul>
    </div>

    <div>
      <h2>Follow</h2>
      {/* The profiles are off-site, so they open in a new tab; rel is
          noopener noreferrer, never a target without it. */}
      <ul>
        {socials.map(([key, url]) => (
          <li><a href={url} target="_blank" rel="noopener noreferrer">{socialLabel(key)}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container legal">
    <span>© {year} {SITE.site_name}</span>
    <span class="legal-links">{legal.map((l) => <a href={l.href}>{l.label}</a>)}</span>
  </div>
</footer>

<style>
  @layer components {
    .kit-ftr {
      background: var(--color-surface-inverse);
      color: var(--color-text-on-inverse);
      padding-block: var(--space-8) var(--space-5);
    }

    .grid { display: grid; gap: var(--space-6); grid-template-columns: 1.4fr repeat(3, 1fr); }

    .brand { display: flex; flex-direction: column; gap: var(--space-2); }
    .word {
      margin: 0; display: flex; flex-direction: column;
      font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl);
    }
    .word small {
      font-family: var(--font-body); font-weight: 600; font-size: var(--text-xs);
      letter-spacing: .12em; text-transform: uppercase; color: var(--color-link-on-inverse);
    }
    .tag { margin: 0; max-width: 32ch; font-size: var(--text-sm); opacity: .85; }

    h2 {
      margin: 0 0 var(--space-2);
      font-family: var(--font-body); font-size: var(--text-xs); font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase; color: var(--color-cta);
    }
    ul { list-style: none; margin: 0; padding: 0; }

    /* 44px line boxes, not padding on an inline link: these lists are columns of close
       neighbours, so an undersized target here has no spacing exception to fall back on. */
    a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
    a:hover { color: var(--color-link-on-inverse); text-decoration: underline; }
    a:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
    /* A row that is information, not a link: it still gets the line box so the column
       rhythm does not break where a link and a fact sit next to each other. */
    .plain { display: flex; align-items: center; min-height: 44px; font-size: var(--text-sm); opacity: .85; }

    .legal {
      display: flex; flex-wrap: wrap; gap: var(--space-5); justify-content: space-between;
      margin-top: var(--space-6); padding-top: var(--space-4);
      font-size: var(--text-xs); opacity: .85;
      /* No hex outside tokens.css: the hairline is the footer's own text colour, thinned. */
      border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    }
    .legal-links { display: flex; gap: var(--space-4); }

    @media (max-width: 800px) { .grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
  }
</style>
