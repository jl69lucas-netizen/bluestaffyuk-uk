---
// src/components/kit/PageNav.astro — spec §5 #11. The breadcrumb trail plus the in-page
// "on this page" navigation, in five treatments.
// a breadcrumb only · b stacked list with a heading · c chip row · d sidebar, numbered ·
// e jump bar with arrows
//
// THE TRAIL IS NOT HAND-WRITTEN. It comes from crumbs() in src/lib/site.ts, the same
// function the pages use, so the intermediate labels stay in step with NAV and a renamed
// section cannot leave a stale crumb behind here.
//
// `sections` DEFAULTS TO EMPTY, and an empty list renders the breadcrumb alone. The
// component has no opinion about what a page's sections are: the canvas's four are demo
// data and live in the registry fixture, where they read as fixture and not as content.
//
// The jump links rely on the global `[id]` scroll-margin rule (nav-jump-target-lands) for
// the landing offset, and nothing here re-states it — but variant b PINS ITS OWN CHROME
// above the target, which that rule's offset does not account for: it clears the measured
// header only. Picking b is therefore a decision with a consequence in project 4, so b's
// <nav> carries `data-pinned-chrome`: mount b and the global `[id] { scroll-margin-top }`
// has to grow by that element's height, or every jump lands with its heading under the
// pinned list. A component cannot set a :root variable, so this is a marker for the page
// that mounts it, not a fix the component can apply to itself.
//
// Tap targets (layout-tap-target-size / WCAG SC 2.5.8): crumbs and jump links sit in rows
// of close neighbours, so neither gets the isolated-target spacing exception and both are
// measured against the 24px floor. Crumbs are 32px line boxes and jump links 44px.
import type { HTMLAttributes } from 'astro/types';
import type { Variant } from './_variant';
import { crumbs } from '../../lib/site';

export interface NavSection { id: string; label: string }
type Props = HTMLAttributes<'div'> & {
  variant?: Variant;
  path?: string;
  title?: string;
  sections?: NavSection[];
};
const {
  variant = 'a',
  path = '/uk-staffordshire-bull-terrier-guide/',
  title = 'Staffordshire Bull Terrier guide',
  sections = [],
  class: cls,
  ...rest
} = Astro.props;

const trail = crumbs(path, title);
const showToc = variant !== 'a' && sections.length > 0;
const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M6 13l6 6 6-6"/></svg>';
---
<div {...rest} class:list={['kit-nav', `kit-page-nav-${variant}`, cls]} data-variant={variant}>
  <nav aria-label="Breadcrumb" class="crumbs">
    <ol>
      {trail.map((c, i) => (
        <li>
          {i < trail.length - 1
            ? <a href={c.href}>{c.label}</a>
            : <span aria-current="page">{c.label}</span>}
        </li>
      ))}
    </ol>
  </nav>

  {showToc && (
    <nav aria-label="On this page" class="toc" data-pinned-chrome={variant === 'b' ? '' : undefined}>
      {/* b and d announce the list with a visible heading; c and e are self-evidently a
          row of jumps and would only be given a heading to fill space. */}
      {(variant === 'b' || variant === 'd') && <h2>On this page</h2>}
      {variant === 'd' ? (
        <ol>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        </ol>
      ) : (
        <ul>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                {variant === 'e' && <Fragment set:html={arrow} />}
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </nav>
  )}
</div>

<style>
  @layer components {
    .kit-nav { display: grid; gap: var(--space-3); max-width: 640px; color: var(--color-text); }

    .crumbs ol {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; align-items: center;
      gap: 0 var(--space-2); font-size: var(--text-sm);
    }
    .crumbs li { display: flex; align-items: center; gap: var(--space-2); }
    .crumbs li + li::before { content: "/"; color: var(--color-text-muted); }
    .crumbs a, .crumbs [aria-current] {
      display: inline-flex; align-items: center; min-height: 32px;
    }
    .crumbs a { color: var(--color-link); }
    .crumbs [aria-current] { color: var(--color-text-muted); }

    .toc h2 {
      margin: 0 0 var(--space-2);
      font-family: var(--font-body); font-size: var(--text-xs); font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-muted);
    }
    .toc ul, .toc ol {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: var(--space-2);
    }
    .toc a {
      display: inline-flex; align-items: center; gap: 6px;
      min-height: 44px; padding: 0 14px;
      border-radius: var(--radius-pill);
      background: var(--color-brand-soft); color: var(--color-brand);
      font-weight: 600; font-size: var(--text-sm); text-decoration: none;
    }
    .toc a:hover { text-decoration: underline; }
    /* --kit-ring, not --color-focus: this block is dropped on steel bands too (convention 2). */
    .kit-nav a:focus-visible {
      outline: 3px solid var(--kit-ring); outline-offset: 2px; border-radius: var(--radius-sm);
    }

    /* b: the list stays with the reader as the page scrolls, under the measured header. */
    .kit-page-nav-b .toc {
      /* --hdr-measured is written by the header's own measurement; --hdr is the
         no-JS fallback, the same order global.css uses. */
      position: sticky; top: calc(var(--hdr-measured, var(--hdr)) + var(--space-2)); z-index: 1;
      background: var(--color-surface); padding-block: var(--space-2);
    }
    .kit-page-nav-b .toc ul { flex-direction: column; gap: 0; }
    .kit-page-nav-b .toc a { background: transparent; border-radius: 0; padding-inline: 0; }

    /* d: the rail beside the prose. The counter is the <ol>'s own numbering, painted with
       ::before because list-style is off — no extra element, no duplicated number. */
    .kit-page-nav-d { grid-template-columns: minmax(180px, 220px) 1fr; }
    .kit-page-nav-d .crumbs { grid-column: 1 / -1; }
    .kit-page-nav-d .toc ol {
      flex-direction: column; gap: 0;
      counter-reset: toc; border-left: 2px solid var(--color-border);
    }
    .kit-page-nav-d .toc li { counter-increment: toc; }
    .kit-page-nav-d .toc a {
      background: transparent; border-radius: 0; width: 100%;
      padding: 0 var(--space-3); color: var(--color-text);
    }
    .kit-page-nav-d .toc a::before {
      content: counter(toc, decimal-leading-zero);
      color: var(--color-text-muted); font-variant-numeric: tabular-nums;
      font-weight: 400; margin-right: 6px;
    }

    /* e: one segmented bar, the links divided rather than spaced. */
    .kit-page-nav-e .toc ul {
      gap: 0; border: var(--card-border); border-radius: var(--radius-md); overflow: hidden;
    }
    .kit-page-nav-e .toc li { flex: 1 1 auto; }
    .kit-page-nav-e .toc a {
      width: 100%; justify-content: center; border-radius: 0;
      background: var(--color-surface-raised); border-left: 1px solid var(--color-border);
    }
    .kit-page-nav-e .toc li:first-child a { border-left: 0; }

    @media (max-width: 640px) {
      .kit-page-nav-d { grid-template-columns: 1fr; }
      .kit-page-nav-e .toc ul { flex-direction: column; }
      .kit-page-nav-e .toc a { border-left: 0; border-top: 1px solid var(--color-border); }
      .kit-page-nav-e .toc li:first-child a { border-top: 0; }
    }
  }
</style>
