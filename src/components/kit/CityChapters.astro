---
// src/components/kit/CityChapters.astro — city component 11, image and text (London pick:
// image-text C, "Two chapters"). A sunk steel-100 tray that reads like two short chapters of one
// story: each chapter is a brass numeral and a place, an H3 question, its own photograph, then
// the prose that answers it. A hairline divides the chapters. On a phone each runs numeral,
// heading, photo, prose in one column. From a 640px box (a tablet, and the column beside the dial)
// each chapter OPENS on one row, the numeral and heading beside the photo, and the prose with its
// H4-H6 ladder runs the chapter's full width UNDER that row, at the reading measure (the breeder's
// ruling on the Harden pass, answer board 2026-10-03 q02: "the text or paragraphs go under the
// image/header ... no long/tall, empty space"). The three columns this replaced (heading | photo |
// prose) let a ladder run two to three times the height of the photo beside it, leaving bays of
// 250-980px under the heading and photo at 768 and 1280 (impeccable D1).
//
// THE PHOTO IS THE H3's NEXT SIBLING (rule 17 and `layout-h3-image-first`): the check walks the
// heading's following siblings, so the numeral sits BEFORE the heading and nothing wraps the
// heading — the canvas's `.hd` wrapper would have hidden the photo from it. The photo carries
// `.bl-img`: a served file renders through BodyImage (its path, its served alt, its baked
// siblings — working rule 11), a puppy photo through astro:assets with the page's own alt; both
// are cropped on their faces (src/lib/imageFocus.ts), never by an inline style.
// Conventions 4 and 6; brass is a fill (the numeral disc) with --color-cta-ink text.
//
// A WRITTEN PAGE NEEDS MORE THAN THE CANVAS'S TWO SHORT CHAPTERS (London's page run, row 12): an
// approved outline gives a section an image under its H2, up to three H3s, and under each H3 an
// H4-H6 ladder with its own links and images. So, all optional and none changing how the
// specimen renders: `image` puts a body photograph between the H2 and the lede; a chapter may
// take `asset` (a board record's baked row, through BodyImage in the uniform box, its served alt
// kept) in place of `photo`; `wide` sets one chapter in a single column, for an infographic that
// must not be squeezed into the photo column; the named slot `ch-<n>` carries the rest of
// chapter n after its opening paragraph; and the default slot closes the tray (a section's
// call to action). The opening paragraph is still the chapter's `text`, the first prose after
// its photo.
import '../../styles/city.css';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import BodyImage from '../BodyImage.astro';
import { puppyImage } from '../../lib/puppyImages';
import { focusClass, focusRow, servedPhoto } from '../../lib/imageFocus';
import { chapterWideSizes, citySizes, type CityFit } from '../../lib/cityKit';
import type { BodyAsset } from '../BodyImage.astro';

export interface Chapter {
  place: string; question: string; text: string;
  /** A puppy photo or a served file named in data/image-focus.json (the canvas's form). */
  photo?: string; photoAlt?: string;
  /** A board record's baked row, rendered by BodyImage in `box` (default `uniform`). */
  asset?: BodyAsset; box?: 'uniform' | 'tall';
  /** One column at every width (an infographic). */
  wide?: boolean;
  /** Show the whole picture on the bone-50 ground instead of cropping it (a graphic with words
   *  baked into it: frontend-design D8). */
  contain?: boolean;
  /** The crop's focal point for `asset` in the uniform box ("50% 30%"; BodyImage `focal`), so a
   *  photograph that is not 16:9 keeps every head inside the box (Asset Gate, 2026-10-04). */
  focal?: string;
}
type Props = HTMLAttributes<'section'> & {
  heading: string;
  lede: string;
  chapters: Chapter[];
  /** The photograph under the H2, before the lede (a board record's baked row). */
  image?: BodyAsset;
  /** Show the H2 photograph whole on the bone-50 ground (a graphic with lettering: D8). */
  imageContain?: boolean;
  /** The H2 photograph's focal point in the uniform box (BodyImage `focal`). */
  imageFocal?: string;
  /** Where the section sits from 1024px, for its images' `sizes` (src/lib/cityKit.ts `CityFit`). */
  fit?: CityFit;
};
const { heading, lede, chapters, image, imageContain = false, imageFocal, fit = 'column', class: cls, ...rest } = Astro.props;
if (chapters.length < 1 || chapters.length > 3) throw new Error('CityChapters: one to three chapters');
const missing = chapters.filter((c) => !c.photo && !c.asset).map((c) => c.question);
if (missing.length) throw new Error(`CityChapters: no photo for ${missing.join(' | ')}`);
// Each chapter's own slot, rendered once here: what follows its opening paragraph.
const rich = await Promise.all(chapters.map((_, i) =>
  Astro.slots.has(`ch-${i + 1}`) ? Astro.slots.render(`ch-${i + 1}`) : Promise.resolve('')));
// Each chapter's full-width slot, `ch-<n>-full`: what follows the text column, across the whole
// chapter at every width (London board revision q03 and q04: the rest of a chapter's ladder and
// the piece that sits under it, the video-call checklist and the London places).
const full = await Promise.all(chapters.map((_, i) =>
  Astro.slots.has(`ch-${i + 1}-full`) ? Astro.slots.render(`ch-${i + 1}-full`) : Promise.resolve('')));
// The tray, less its padding (16px; 48px from tablet): the H2 photo and a wide chapter's image.
const WIDE_SIZES = chapterWideSizes(fit);
// The tray is the box less its side inset (16px a side on a phone, 32px from a 640px box: D7), at
// most 1100px, less its padding (16px; 32px from tablet):
// the photo is the tray on a phone, and from a 640px box the second of two equal columns beside
// the heading (24px apart on a tablet, 32px from a desktop box, where it stops at 340px).
const SIZES = citySizes(fit, {
  phone: (B) => `calc(min(${B}, 1132px) - 64px)`,
  tablet: (B) => `calc((min(${B}, 1164px) - 152px) / 2)`,
  desktop: (B) => `min(340px, calc((min(${B}, 1164px) - 160px) / 2))`,
});
---
<section {...rest} class:list={['city-kit', 'city-chapters', cls]}>
  <div class="tray">
    <h2>{heading}</h2>
    {image && <BodyImage asset={image} srcset={image.srcset} phone={image.phone} box="uniform" sizes={WIDE_SIZES} focal={imageFocal} class={imageContain ? 'h2-img fit-contain' : 'h2-img'} />}
    <p class="lede">{lede}</p>
    {chapters.map((c, i) => {
      if (c.asset) {
        return (
          <div class:list={['ch', { wide: c.wide }]}>
            <span class="num"><b aria-hidden="true">{i + 1}</b>{c.place}</span>
            <h3>{c.question}</h3>
            <BodyImage asset={c.asset} srcset={c.asset.srcset} phone={c.asset.phone} box={c.box ?? 'uniform'} focal={c.focal}
              sizes={c.wide ? WIDE_SIZES : SIZES} class={c.contain ? 'media-u fit-contain' : 'media-u'} />
            <div class="txt"><p>{c.text}</p><Fragment set:html={rich[i]} /></div>
            {full[i] && <div class="full"><Fragment set:html={full[i]} /></div>}
          </div>
        );
      }
      const photo = c.photo!;
      const served = focusRow(photo).src === 'images';
      const asset = served ? servedPhoto(photo) : null;
      if (!served && !c.photoAlt) throw new Error(`CityChapters: ${photo} is a puppy photo and needs its photoAlt`);
      return (
        <div class:list={['ch', { wide: c.wide }]}>
          <span class="num"><b aria-hidden="true">{i + 1}</b>{c.place}</span>
          <h3>{c.question}</h3>
          {asset
            ? <BodyImage asset={asset} srcset={asset.srcset} sizes={SIZES} class={`${focusClass(photo)} media`} />
            : <Image src={puppyImage(photo)} alt={c.photoAlt!} widths={[400, 700]} sizes={SIZES}
                class={`bl-img media ${focusClass(photo)}`} loading="lazy" decoding="async" />}
          <div class="txt"><p>{c.text}</p><Fragment set:html={rich[i]} /></div>
          {full[i] && <div class="full"><Fragment set:html={full[i]} /></div>}
        </div>
      );
    })}
    {Astro.slots.has('default') && <div class="close"><slot /></div>}
  </div>
</section>
<style>
  @layer components {
    /* A container (src/styles/city.css): its tiers read this section's own box. */
    /* THE BAND KEEPS THE SIBLINGS' VERTICAL RHYTHM (frontend-design pass, 2026-10-03): every other
       city band (letter, newsletter, FAQ, contact) sets its panel in by the tier's --city-pad-y
       (32 / 40 / 48) top and bottom; the tray sat a flat 32px down at every tier, so from a tablet
       box the chapter bands ran tighter than the cards between them. The tray is the root's direct
       child, so it reads the tier's value; flow-root keeps its margins inside the painted band.
       ITS SIDE INSET IS THE SIBLINGS' TOO (frontend-design D7, the breeder's yes, answer board
       2026-10-03 london-design-pass q05): 16px a side on a phone and 32px from a 640px box, where it
       sat 12px at every width and read as a panel slipped inside a thin bone frame. The 500px
       kc-registered-staffy-puppies.webp that stopped it first time has -240/-400 siblings beside
       it now (working rule 11), and src/lib/cityKit.ts's sizes follow the narrower tray. */
    .city-chapters { background: var(--color-surface); padding: 0; display: flow-root; }
    .tray { max-width: min(1100px, calc(100% - 2 * var(--space-4))); margin: var(--city-pad-y) auto; padding: var(--space-5) var(--space-4); border-radius: var(--radius-lg); background: var(--color-brand-soft); }
    h2 { margin: 0 0 var(--space-2); }
    .lede { margin: 0 0 var(--space-5); font-size: var(--city-lead); color: var(--color-text); }
    .ch {
      display: grid; gap: var(--space-3); padding: var(--space-5) 0; border-top: 1px solid var(--color-steel-300);
      grid-template-areas: "num" "h3" "img" "text";
    }
    .num { grid-area: num; display: block; font-family: var(--font-display); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.08em; color: var(--color-ink-2); }
    .num b {
      display: inline-grid; place-items: center; width: 28px; height: 28px; margin-right: var(--space-2);
      border-radius: 50%; background: var(--color-cta); color: var(--color-cta-ink); font-size: var(--text-sm);
    }
    h3 { grid-area: h3; margin: 0; }
    /* The numeral belongs to its heading: the canvas set them a --space-1 apart, inside the
       chapter's --space-3 rhythm, so the H3 is pulled up by the difference. */
    .num + h3 { margin-top: calc(var(--space-1) - var(--space-3)); }
    .ch :global(.media) {
      grid-area: img; display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover;
      border-radius: var(--radius-md); background: var(--color-bone-50);
    }
    .ch :global(.media-u) { grid-area: img; }
    /* A GRAPHIC WITH WORDS IN IT IS SHOWN WHOLE (frontend-design D8, the breeder's yes, answer
       board 2026-10-03 london-design-pass q06): the uniform box's cover crop cut the top of the
       "Contact Us" headline and the second line of the breed labels. `contain` fits the whole
       picture in the same box, and what the picture does not fill is the bone-50 ground (the
       image-bleed rule: a design colour, never grey or black). Opted into per image. */
    .tray :global(img.fit-contain) { object-fit: contain; background: var(--color-bone-50); }
    .txt { grid-area: text; min-width: 0; color: var(--color-text); }
    .txt :global(p) { margin: 0 0 var(--space-3); color: var(--color-text); }
    .txt :global(p:last-child) { margin-bottom: 0; }
    .txt :global(:is(h4, h5, h6)) { margin: var(--space-4) 0 var(--space-2); }
    /* H4-H6 sat on the body's 1.65 leading, so a two- or three-line question read as loose as
       prose (harden pass 2026-10-03): a heading's own leading, and balanced lines. */
    .ch :global(:is(h4, h5, h6)) { line-height: 1.3; text-wrap: balance; }
    /* THE LADDER IN BRAND STEEL AT 600 (impeccable D2, the breeder's yes, 2026-10-03 q03): Fraunces
       400 in body ink read lighter than the prose around it on a phone. The site's heading role is
       --color-brand (board-styles.css, city.css); 600 sits a step under the H2/H3's 700, so the
       ladder still ranks below its chapter question. Only the ladder (the slots' own direct
       children): a component inside a slot keeps its own headings. */
    .txt > :global(:is(h4, h5, h6)), .full > :global(:is(h4, h5, h6)) { font-weight: 600; color: var(--color-brand); }
    /* The full-width slot: a row of its own under the chapter's grid, spanning every column. */
    .full { grid-column: 1 / -1; min-width: 0; color: var(--color-text); }
    .full > :global(p) { margin: 0 0 var(--space-3); color: var(--color-text); }
    .full > :global(:is(h4, h5, h6)) { margin: var(--space-2) 0 var(--space-2); }
    .full > :global(* + :is(h4, h5, h6)) { margin-top: var(--space-5); }
    .full > :global(:last-child) { margin-bottom: 0; }
    .txt :global(.bl-img) { margin: var(--space-2) 0 var(--space-3); }
    .txt :global(ul) { margin: 0 0 var(--space-3); padding-left: var(--space-5); }
    /* The H2 sat 8px over its photograph while every H3 in the same component sits --space-3 over
       its own (the chapter's row gap): one heading-to-image distance in one component. */
    .tray > :global(.h2-img) { margin: var(--space-3) auto var(--space-4); }
    /* THE CHAPTER'S CLOSING LINE IS ITS CALL TO ACTION (London previews 2026-10-04, CTA-1, the
       breeder's pick, answer board 2026-10-04 q09 (a)): the sentence's link, always its first child
       (links-plan M2, sentence_start), is the brass pill (rules/design.md rule 3); the rest of the
       sentence follows it, in ink-2 on a bone-50 card ruled in brass. Words and hrefs are the
       board's, unchanged. Only transform and background move on hover; off under reduced motion. */
    .close {
      margin-top: var(--space-3); padding: var(--space-4); border-radius: var(--radius-md);
      background: var(--color-bone-50); border-left: 3px solid var(--color-cta);
    }
    .close :global(p) { margin: 0; font-weight: 600; color: var(--color-ink-2); line-height: 1.5; }
    .close :global(p > a:first-child) {
      display: inline-flex; align-items: center; min-height: 44px; padding: var(--space-2) 22px;
      margin: 0 6px 6px 0; border-radius: var(--btn-radius); background: var(--color-cta);
      color: var(--color-cta-ink); font-weight: 700; line-height: 1.25; text-wrap: balance;
      text-align: center; text-decoration: none; box-shadow: var(--shadow-card);
      transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    }
    .close :global(p > a:first-child:hover) { background: var(--color-cta-hover); transform: translateY(-1px); }
    .close :global(p > a:first-child:focus-visible) { outline: 3px solid var(--kit-ring); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) {
      .close :global(p > a:first-child) { transition: none; }
      .close :global(p > a:first-child:hover) { transform: none; }
    }
    /* FROM A 640px BOX: THE CHAPTER OPENS ON ONE ROW, THE PROSE RUNS UNDER IT (impeccable D1, the
       breeder's direction, 2026-10-03 q02). The numeral and the heading sit beside the photo,
       centred on it by the two empty 1fr rows above and below them (the photo spans all four),
       and the prose takes the full row underneath at the reading measure: a paragraph keeps
       city.css's 65ch, and the ladder headings and lists take the same 65ch here, so nothing ever
       stands beside the prose and no column runs on past its neighbour. The photo stays the H3's
       next sibling (layout-h3-image-first); only the grid places it. Images inside the prose
       take the chapter's width, as the full-width slot's and a wide chapter's do (the uniform box,
       rules/images.md): src/lib/cityKit.ts chapterTextSizes says so. */
    @container (width >= 640px) {
      .tray { max-width: min(1100px, calc(100% - 2 * var(--space-6))); padding: var(--space-6) var(--space-6); }
      .ch {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: 1fr auto auto 1fr auto;
        grid-template-areas: ". img" "num img" "h3 img" ". img" "text text";
        column-gap: var(--space-5); row-gap: var(--space-3);
      }
      .ch :global(:is(.media, .media-u)) { align-self: center; }
      .txt { margin-top: var(--space-3); }
      .txt > :global(:is(h4, h5, h6, ul, ol)), .full > :global(:is(h4, h5, h6)) { max-inline-size: 65ch; }
    }
    @container (width >= 800px) {
      .ch { grid-template-columns: minmax(0, 1fr) minmax(0, 340px); column-gap: var(--space-6); }
      .ch :global(.media) { max-width: 340px; }
      .ch:not(.wide) :global(.media-u) { max-width: 340px; }
    }
    /* A wide chapter (an infographic) keeps one column at every width: heading, image, prose. */
    .ch.wide { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: "num" "h3" "img" "text"; }
    .ch.wide .txt { margin-top: 0; }
  }
</style>
