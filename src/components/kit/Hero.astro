---
// src/components/kit/Hero.astro — spec §5 #2.
// a photo right, copy left, bone · b full-bleed photo, inverse overlay · c split with trust chips
// d text-only on inverse (guide pages) · e short location hero (eyebrow + H1 + one line)
//
// THE PHOTO. There is no distinct homepage hero image in this repo and no src/assets/hero/:
// the masters are the six puppy photos in src/assets/puppies/. The hero imports one of them
// directly (portrait, so the 4:5 crop below is the master's own shape) until project 4
// supplies a real hero photo; swapping that import is then the whole change.
//
// SIZES. `.pic` paints at ~560px on desktop and full width below 900px, which is what the
// `sizes` attribute says — a hero that claimed 100vw everywhere would download the 1200px
// candidate onto a 560px box. The hero image is the page's LCP element in every variant that
// shows one, so it is eager with fetchpriority="high" rather than lazy. The crop is CSS
// (aspect-ratio + object-fit), never a baked one, so one master serves every variant.
//
// HEADING LEVEL. `as` exists because the canvas mounts five heroes on one page: the page owns
// the only <h1> there and the demo fixture passes `as="h2"`. On a real page the default 'h1'
// is correct and is what project 4 will use.
//
// Variants b and d paint their own steel band, so they carry `data-surface="inverse"`: the
// global rule flips --kit-ring and the on-inverse text colour for everything inside, rather
// than each child naming a dark-band colour of its own (convention 3).
import type { HTMLAttributes } from 'astro/types';
import type { Variant } from './_variant';
import { Image } from 'astro:assets';
import hero from '../../assets/puppies/Cheryl1.jpeg';
import { SITE } from '../../lib/site';
import Button from './Button.astro';
type Props = HTMLAttributes<'section'> & {
  variant?: Variant;
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title?: string;
  lede?: string;
};
// Every figure and claim below is in data/settings.json or on the live homepage
// (KC registration, health-tested parents): rule 9, nothing is typed from memory.
const {
  variant = 'a',
  as: Heading = 'h1',
  eyebrow = `KC registered · ${SITE.location_label}`,
  title = 'Blue Staffy puppies raised in a family home',
  lede = `Health-tested parents, Kennel Club registration paperwork, and UK delivery from £${SITE.delivery_min_gbp}.`,
  class: cls,
  ...rest
} = Astro.props;
const inverse = variant === 'b' || variant === 'd';
// Backed on the homepage today: KC registration, L-2-HGA/HC-HSF4 clear parents, home rearing.
const chips = ['KC registered', 'DNA-tested parents', 'Raised in the home'];
const alt = 'A blue Staffordshire Bull Terrier puppy resting in a family home';
---
<section
  {...rest}
  class:list={['kit-hero', `kit-hero-${variant}`, cls]}
  data-surface={inverse ? 'inverse' : undefined}
  data-variant={variant}
>
  {variant === 'b' && (
    <Image
      src={hero}
      alt=""
      widths={[800, 1280, 1920]}
      sizes="100vw"
      class="bg"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
  <div class="container inner">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <Heading class="title">{title}</Heading>
      <p class="lede">{lede}</p>
      {variant === 'c' && <ul class="chips">{chips.map((c) => <li class="kit-chip">{c}</li>)}</ul>}
      {variant !== 'e' && (
        <div class="ctas">
          <Button variant="a" href="/available-puppies/" label="Meet the puppies" />
          <Button variant={inverse ? 'c' : 'b'} href="/uk-blue-staffy-breeders-contact/" label="Ask a question" />
        </div>
      )}
    </div>
    {(variant === 'a' || variant === 'c') && (
      <Image
        src={hero}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, 560px"
        class="pic"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
  </div>
</section>
<style>
  @layer components {
    .kit-hero { background: var(--color-surface); color: var(--color-text); position: relative; overflow: hidden; }
    .kit-hero[data-surface="inverse"] { background: var(--color-surface-inverse); }
    .inner { display: grid; grid-template-columns: 1fr; gap: var(--space-8); align-items: center; padding-block: var(--space-10); position: relative; }
    .kit-hero-a .inner, .kit-hero-c .inner { grid-template-columns: 1.1fr 1fr; }
    /* Brass is 3.1:1 on bone, so the light eyebrow is steel, not brass; on the dark band
       brass is 4.9:1 and is the accent the header and buttons already use there. */
    .eyebrow { margin: 0 0 var(--space-3); font-size: var(--text-xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-brand); }
    [data-surface="inverse"] .eyebrow { color: var(--color-cta); }
    .title { margin: 0 0 var(--space-4); font-family: var(--font-display); font-weight: 700; font-size: var(--text-4xl); line-height: var(--text-4xl--line-height); text-wrap: balance; color: var(--color-brand); }
    [data-surface="inverse"] .title { color: inherit; }
    .lede { margin: 0 0 var(--space-5); font-size: var(--text-lg); max-width: 52ch; }
    .ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; }
    .chips { list-style: none; margin: 0 0 var(--space-5); padding: 0; display: flex; gap: var(--space-2); flex-wrap: wrap; }
    /* .kit-chip (src/styles/kit.css) is the shape; the hero's chips sit on the bone
       surface rather than inside a card, so they take the raised fill and a hairline. */
    .chips li { padding: 6px 12px; background: var(--color-surface-raised); border: var(--card-border); }
    .pic { display: block; width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--card-radius); box-shadow: var(--shadow-lift); }
    /* The band photo is a texture, not content: alt="" and .28 opacity over the steel fill,
       which keeps the on-inverse text reading against a near-flat surface. */
    .kit-hero-b .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .28; }
    .kit-hero-b .inner { min-height: 520px; }
    .kit-hero-d .inner { padding-block: var(--space-8); }
    .kit-hero-d .title { font-size: var(--text-3xl); }
    .kit-hero-e .inner { padding-block: var(--space-7); }
    .kit-hero-e .title { font-size: var(--text-3xl); margin-bottom: var(--space-2); }
    .kit-hero-e .lede { margin-bottom: 0; }
    @media (max-width: 900px) {
      .kit-hero-a .inner, .kit-hero-c .inner { grid-template-columns: 1fr; }
      .title { font-size: var(--text-3xl); }
      .kit-hero-a .pic, .kit-hero-c .pic { aspect-ratio: 3/2; }
    }
  }
</style>
