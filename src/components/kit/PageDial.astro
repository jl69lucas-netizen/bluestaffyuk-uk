---
// src/components/kit/PageDial.astro — desktop in-page dial (spec §3): sticky sidebar card,
// 64px progress ring ("n of N"), numbered section list, scroll-spy.
//
// Hidden below 1024px, where SectionSheet takes over — the two are one component split by
// width, and a page mounts both. Metrics match the source site's dial: a 196px column, a
// 64px ring box drawn on a 50px inner circle, rows of at least 24px, a dashed top rule.
//
// Convention 2: the focus ring reads `--kit-ring`. Convention 4: Props extends
// HTMLAttributes<'aside'>, `...rest` is spread, `class` is applied with `class:list`.
// Convention 6: everything overridable is in `@layer components`. Convention 9: the card
// shell is `.kit-card` from kit.css rather than a second copy of it here.
//
// The ONE inline style is the ring's dash geometry, which depends on N and so cannot live
// in a stylesheet. It carries no colour — rule 1, and the dist test asserts it.
import type { HTMLAttributes } from 'astro/types';
import type { SectionRef } from '../../lib/sections';
type Props = HTMLAttributes<'aside'> & { sections: SectionRef[]; title?: string };
const { sections, title = 'On this page', class: cls, ...rest } = Astro.props;
const N = sections.length;
const C = 2 * Math.PI * 22; // ring circumference at r=22, inside the 64px box
const dash = C.toFixed(1);
---
<aside class:list={['kit-dial kit-card', cls]} data-dial {...rest}>
  <div class="ring" aria-hidden="true">
    <svg viewBox="0 0 64 64" width="64" height="64">
      <circle cx="32" cy="32" r="22" class="track" />
      <circle cx="32" cy="32" r="22" class="fill" data-ring style={`stroke-dasharray:${dash};stroke-dashoffset:${dash}`} />
    </svg>
    <span class="n"><b data-ring-n>1</b><small>of {N}</small></span>
  </div>
  <nav aria-label="Sections">
    <p class="t">{title}</p>
    <ol>
      {sections.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-spy={s.id}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="lab">{s.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
<script>
  // Scroll-spy. The section nearest the top of the reading band wins; the ring shows n of N.
  // The band is `-40% 0px -55% 0px`, so a section counts as current once its top passes 40%
  // down the viewport and stops counting once it leaves the bottom 45% — the same window the
  // sheet uses, so the two never disagree about which section the reader is in.
  const dial = document.querySelector<HTMLElement>('[data-dial]');
  if (dial) {
    const links = [...dial.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
    const ring = dial.querySelector<SVGCircleElement>('[data-ring]');
    const nEl = dial.querySelector<HTMLElement>('[data-ring-n]');
    const C = 2 * Math.PI * 22;
    const targets = links
      .map((a) => document.getElementById(a.dataset.spy!))
      .filter((t): t is HTMLElement => Boolean(t));
    const set = (i: number) => {
      if (i < 0) return;
      links.forEach((a, j) => a.toggleAttribute('aria-current', j === i));
      if (ring) ring.style.strokeDashoffset = String(C * (1 - (i + 1) / links.length));
      if (nEl) nEl.textContent = String(i + 1);
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) set(targets.indexOf(visible[0].target as HTMLElement));
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    targets.forEach((t) => io.observe(t));
    set(0);
  }
</script>
<style>
  @layer components {
    /* Hidden by default: below 1024px SectionSheet is the in-page nav, and a dial that
       merely shrank would be a second copy of the same links in the tab order. */
    .kit-dial { display: none; }
    @media (min-width: 1024px) {
      .kit-dial {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
        width: 196px;
        padding: 12px 10px;
        position: sticky;
        /* Same expression global.css gives every [id] its scroll-margin-top from, so the
           dial clears exactly the chrome a jump target clears. */
        top: calc(var(--hdr-measured, var(--hdr)) + 16px);
        max-height: calc(100vh - var(--hdr) - 32px);
        overflow-y: auto;
        color: var(--color-text);
      }
    }
    .ring { position: relative; width: 64px; height: 64px; margin: 2px auto 0; flex: none; }
    .ring svg { transform: rotate(-90deg); }
    .track { fill: none; stroke: var(--color-border); stroke-width: 6; }
    .fill {
      fill: none;
      stroke: var(--color-cta);
      stroke-width: 6;
      stroke-linecap: round;
      transition: stroke-dashoffset var(--dur-base) var(--ease-out);
    }
    /* Brass as a STROKE on bone is decoration, not text — the "n of N" it rings is set in
       brand and muted below it. */
    .n { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; line-height: 1; }
    /* 18px over 13px, not 15px over 7px. The source site's dial sets the caption at 7px;
       `layout-min-font-size` is blocking at 12.5px and is right — a 7px caption is not text
       anyone reads, it is a texture. `--text-xs` is the floor token, and "of 6" at 13px is
       ~32px wide inside a 44px inner diameter, so the pair still sits in the ring. Lowercase
       and untracked for the same reason: uppercase with letter-spacing would not fit. */
    .n b { font-family: var(--font-display); font-size: 18px; line-height: 1; color: var(--color-brand); }
    .n small {
      display: block;
      font-size: var(--text-xs);
      line-height: 1.1;
      color: var(--color-text-muted);
    }
    .t {
      margin: 0;
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    ol {
      list-style: none;
      margin: 0;
      padding: 8px 0 0;
      display: grid;
      gap: 1px;
      border-top: 1px dashed var(--color-border);
    }
    li a {
      display: flex;
      gap: 7px;
      align-items: baseline;
      min-height: 24px;
      padding: 3px 4px;
      border-radius: var(--radius-sm);
      font-size: var(--text-sm);
      color: var(--color-text);
      text-decoration: none;
    }
    li a[aria-current] { background: var(--color-brand-soft); color: var(--color-brand); font-weight: 600; }
    li a:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 1px; }
    .num { font-feature-settings: 'tnum'; color: var(--color-text-muted); font-size: var(--text-xs); }
    /* A flex item's automatic minimum size is its max-content width, so a two-word label
       would hold the 196px column open rather than wrapping inside it. */
    .lab { min-width: 0; overflow-wrap: anywhere; }
    @media (prefers-reduced-motion: reduce) {
      .fill { transition: none; }
    }
  }
</style>
