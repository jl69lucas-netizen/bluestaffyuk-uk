---
// src/components/kit/PageDial.astro — desktop in-page dial (spec §3): sticky sidebar card,
// 64px progress ring ("n of N"), numbered section list, scroll-spy.
//
// Hidden below 1024px, where SectionSheet takes over — the two are one component split by
// width, and a page mounts both. Metrics match the source site's dial: a 196px column, a
// 64px ring box drawn on a 50px inner circle, rows of at least 24px, a dashed top rule.
//
// Convention 2: the focus ring reads `--kit-ring`. Convention 4: Props extends
// HTMLAttributes<'aside'>, `...rest` is spread, `class` is applied with `class:list`.
// Convention 6: everything overridable is in `@layer components`. Convention 9: the card
// shell is `.kit-card` from kit.css rather than a second copy of it here.
//
// The ONE inline style is the ring's dash geometry, which depends on N and so cannot live
// in a stylesheet. It carries no colour — rule 1, and the dist test asserts it.
//
// `aria-current="location"`, never a bare `aria-current`. `toggleAttribute` emits
// `aria-current=""`, and the empty string is the token `false`: a dial marking its current
// section that way announces every row as NOT current, which is worse than marking none.
// The CSS therefore matches `[aria-current="location"]` rather than bare `[aria-current]`,
// so the paint and the announcement can never disagree.
//
// TEMPORARY `style` PROP (project 4, Task 9). The dial is one of the two pieces of chrome
// the contact board puts three arrangements of in front of the breeder, so all three live
// here at once behind `style`: S1 is the shipped dial above, S2 drops the ring for a compact
// numbered strip, S3 keeps the ring and shows labels only with a thicker current bar. The
// map that names them is `dial` in src/lib/boardStyles.ts. AFTER THE PICK THE OTHER TWO ARE
// DELETED along with this prop — the same prune project 3 ran on the kit's style options.
import type { HTMLAttributes } from 'astro/types';
import type { SectionRef } from '../../lib/sections';
type Props = HTMLAttributes<'aside'> & {
  sections: SectionRef[];
  title?: string;
  style?: 'S1' | 'S2' | 'S3';
  /** Distinguishes the ids of two dials on ONE document. A page mounts one dial and never
   *  passes it; the board preview mounts three of the same section and must, or all three
   *  `aria-labelledby` targets collapse onto the first heading. */
  idPrefix?: string;
};
const {
  sections,
  title = 'On this page',
  style: styleId = 'S1',
  idPrefix = 'kit-dial',
  class: cls,
  ...rest
} = Astro.props;
// S2 is the one style with no ring, and S3 the one with no row numbers. Naming the two
// facts once keeps the markup and the CSS from disagreeing about which style is which.
const hasRing = styleId !== 'S2';
const hasNumbers = styleId !== 'S3';
const N = sections.length;
const C = 2 * Math.PI * 22; // ring circumference at r=22, inside the 64px box
const dash = C.toFixed(1);
// The nav is labelled BY the visible heading, not by a duplicate literal: a reader who can
// see "On this page" and a reader who hears the landmark then get the same words, and a
// caller who passes `title` renames both at once.
const titleId = `${idPrefix}-title`;
---
<aside class:list={['kit-dial', `dial-${styleId.toLowerCase()}`, styleId !== 'S2' && 'kit-card', cls]} data-dial {...rest}>
  {hasRing && (
    <div class="ring" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="64" height="64">
        <circle cx="32" cy="32" r="22" class="track" />
        <circle cx="32" cy="32" r="22" class="fill" data-ring style={`stroke-dasharray:${dash};stroke-dashoffset:${dash}`} />
      </svg>
      <span class="n"><b data-ring-n>1</b><small>of {N}</small></span>
    </div>
  )}
  <nav aria-labelledby={titleId}>
    <p class="t" id={titleId}>{title}</p>
    <ol>
      {sections.map((s, i) => (
        <li>
          {/* The first row is marked current AT RENDER, not only by the spy: a reader at
              the top of the page is in section one, and a dial that marks nothing until
              the first scroll event is a dial that looks broken before JS runs — and in a
              board preview, where the block is static markup, it never runs at all. */}
          <a href={`#${s.id}`} data-spy={s.id} aria-current={i === 0 ? 'location' : undefined}>
            {hasNumbers && <span class="num">{String(i + 1).padStart(2, '0')}</span>}
            <span class="lab">{s.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
<script>
  // Scroll-spy. The section nearest the top of the reading band wins; the ring shows n of N.
  // The band is `-40% 0px -55% 0px`, so a section counts as current once its top passes 40%
  // down the viewport and stops counting once it leaves the bottom 45% — the same window the
  // sheet uses, so the two never disagree about which section the reader is in.
  // Singleton by design: a page mounts ONE dial (and one SectionSheet), the way it mounts
  // one site header. `querySelector` rather than a per-instance loop says so out loud —
  // two dials would be two copies of the same links in the tab order, and the second would
  // silently not be wired.
  const dial = document.querySelector<HTMLElement>('[data-dial]');
  if (dial) {
    // Links and targets are PAIRED, never zipped by index. Filtering them into two arrays
    // independently lets one id that does not resolve shift every later pairing by one, so
    // the spy would highlight the wrong row for the rest of the page — a silent failure
    // that looks like a scroll bug. The pair also gives the ring an honest denominator:
    // "n of N" counts the rows the spy can actually reach.
    const rows = [...dial.querySelectorAll<HTMLAnchorElement>('[data-spy]')]
      .map((link) => ({ link, target: document.getElementById(link.dataset.spy!) }))
      .filter((r): r is { link: HTMLAnchorElement; target: HTMLElement } => r.target !== null);
    const ring = dial.querySelector<SVGCircleElement>('[data-ring]');
    const nEl = dial.querySelector<HTMLElement>('[data-ring-n]');
    const C = 2 * Math.PI * 22;
    const N = rows.length;
    const set = (i: number) => {
      if (i < 0 || i >= N) return;
      // setAttribute/removeAttribute, not toggleAttribute: `aria-current=""` is the token
      // `false`, so a toggled attribute announces the current row as not current.
      rows.forEach((r, j) => {
        if (j === i) r.link.setAttribute('aria-current', 'location');
        else r.link.removeAttribute('aria-current');
      });
      if (ring) ring.style.strokeDashoffset = String(C * (1 - (i + 1) / N));
      if (nEl) nEl.textContent = String(i + 1);
    };
    // The bottom of the document is a place the reading band cannot reach: a short final
    // section never gets its top past 40% of the viewport, so the spy would sit on the
    // second-to-last row while the reader is plainly at the end. When the page is scrolled
    // to the bottom the last row IS the answer, whatever is intersecting.
    const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    let fromObserver = 0;
    const apply = () => set(atBottom() ? N - 1 : fromObserver);
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!visible[0]) return;
        const i = rows.findIndex((r) => r.target === visible[0].target);
        if (i >= 0) fromObserver = i;
        apply();
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    rows.forEach((r) => io.observe(r.target));
    window.addEventListener('scroll', apply, { passive: true });
    // Seed from the fragment: a reader arriving on /page/#deposit is already in that
    // section, and starting at row 1 would be the dial disagreeing with the viewport
    // until the first scroll event.
    const fromHash = rows.findIndex((r) => r.target.id === decodeURIComponent(location.hash.slice(1)));
    if (fromHash >= 0) fromObserver = fromHash;
    apply();
  }
</script>
<style>
  @layer components {
    /* Hidden by default: below 1024px SectionSheet is the in-page nav, and a dial that
       merely shrank would be a second copy of the same links in the tab order. */
    .kit-dial { display: none; }
    @media (min-width: 1024px) {
      .kit-dial {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
        width: 196px;
        padding: 12px 10px;
        position: sticky;
        /* Same expression global.css gives every [id] its scroll-margin-top from, so the
           dial clears exactly the chrome a jump target clears. */
        top: calc(var(--hdr-measured, var(--hdr)) + 16px);
        max-height: calc(100vh - var(--hdr) - 32px);
        overflow-y: auto;
        color: var(--color-text);
      }
    }
    .ring { position: relative; width: 64px; height: 64px; margin: 2px auto 0; flex: none; }
    .ring svg { transform: rotate(-90deg); }
    .track { fill: none; stroke: var(--color-border); stroke-width: 6; }
    .fill {
      fill: none;
      stroke: var(--color-cta);
      stroke-width: 6;
      stroke-linecap: round;
      transition: stroke-dashoffset var(--dur-base) var(--ease-out);
    }
    /* Brass as a STROKE on bone is decoration, not text — the "n of N" it rings is set in
       brand and muted below it. */
    .n { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; line-height: 1; }
    /* 18px over 13px, not 15px over 7px. The source site's dial sets the caption at 7px;
       `layout-min-font-size` is blocking at 12.5px and is right — a 7px caption is not text
       anyone reads, it is a texture. `--text-xs` is the floor token, and "of 6" at 13px is
       ~32px wide inside a 44px inner diameter, so the pair still sits in the ring. Lowercase
       and untracked for the same reason: uppercase with letter-spacing would not fit. */
    .n b { font-family: var(--font-display); font-size: 18px; line-height: 1; color: var(--color-brand); }
    .n small {
      display: block;
      font-size: var(--text-xs);
      line-height: 1.1;
      color: var(--color-text-muted);
    }
    .t {
      margin: 0;
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    ol {
      list-style: none;
      margin: 0;
      padding: 8px 0 0;
      display: grid;
      gap: 1px;
      border-top: 1px dashed var(--color-border);
    }
    li a {
      display: flex;
      gap: 7px;
      align-items: baseline;
      min-height: 24px;
      padding: 3px 4px;
      border-radius: var(--radius-sm);
      font-size: var(--text-sm);
      color: var(--color-text);
      text-decoration: none;
    }
    li a[aria-current='location'] { background: var(--color-brand-soft); color: var(--color-brand); font-weight: 600; }
    li a:focus-visible { outline: 3px solid var(--kit-ring); outline-offset: 1px; }
    .num { font-feature-settings: 'tnum'; color: var(--color-text-muted); font-size: var(--text-xs); }
    /* A flex item's automatic minimum size is its max-content width, so a two-word label
       would hold the 196px column open rather than wrapping inside it. */
    .lab { min-width: 0; overflow-wrap: anywhere; }
    @media (prefers-reduced-motion: reduce) {
      .fill { transition: none; }
    }

    /* --- the two style arrangements the contact board offers (temporary, see the header) ---
       Each is a STRUCTURAL change to the dial, never a recolour: S2 removes the ring and
       the card and runs the rows as a ruled rail, S3 removes the row numbers and marks the
       current section with a bar down its leading edge instead of a filled row. */

    /* S2 — compact numbered strip. No card, no ring: a hairline rail of rows that takes
       about half the height of S1, for a page whose dial would otherwise outrun its own
       first screen. The rail rule is on the list, so the rows read as one strip. */
    .dial-s2 { gap: 6px; padding: 0; background: none; border: 0; box-shadow: none; }
    .dial-s2 ol { border-top: 0; padding-top: 4px; gap: 0; }
    .dial-s2 li + li { border-top: 1px solid var(--color-border); }
    .dial-s2 li a { min-height: 28px; padding: 4px 2px; }

    /* S3 — ring and labels, no numbers. The current row is called out by a 3px bar on its
       leading edge rather than by the soft fill, which is what makes it readable at a
       glance from the body column. */
    .dial-s3 li a {
      padding-left: 7px;
      border-left: 3px solid transparent;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
    .dial-s3 li a[aria-current='location'] { border-left-color: var(--color-cta); }
  }
</style>
