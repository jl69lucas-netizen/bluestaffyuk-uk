---
// src/components/kit/InfoCard.astro — the content/info card (spec §5 #7). Picked
// 2026-09-18: the eyebrow treatment — a statement label with a brass hairline running out
// from it, and a brass bar down the card's leading edge.
//
// A DEFERRED CHECK LIVES HERE. `sem-statement-label-visible` (tests/render/checks/sem.ts)
// selects `main .stmt-label` and requires each one to be painted AND to carry a `data-kind`
// of exactly `fact`, `observed` or `recommendation`. The label is therefore a statement
// label with a kind, not a free-text eyebrow: `kind` picks the word. It is a state check,
// so convention 10 applies — the real coverage is the fixture pair
// tests/render/fixtures/{known_good,known_broken}/kit-stmt-label*.html, which pins this
// component's own markup.
//
// `layout-h3-image-first` no longer has a subject here: the image-top layout was one of the
// five treatments and the prune did not keep it. Its fixture pair
// (kit-h3-image-*.html) is still what covers the check, and project 4's page sections are
// where a real `.sec-img` block next appears.
//
// Brass is never the colour of this small label on a bone card (2.1:1). The label takes
// --color-text-muted, which data/design/contrast.json already carries against both
// surfaces; brass appears only as the bar and the hairline, which are non-text.
import type { HTMLAttributes } from 'astro/types';
// The statement vocabulary lives in src/lib/ because the three kinds outlive this folder.
import { LABELS, type StatementKind } from '../../lib/statement';

type Props = HTMLAttributes<'article'> & {
  kind?: StatementKind;
  label?: string;
  /** `heading`, not `title`: HTMLAttributes<'article'> already owns `title`, and a prop
   *  that shadowed it would silently swallow a caller's tooltip attribute. */
  heading?: string;
  body?: string;
};
const {
  kind = 'fact',
  label = LABELS[kind],
  // Both sentences are claims the live homepage already makes: the parents' L-2-HGA / HC-HSF4
  // DNA tests (named, never a result: the breeder holds no certificates, answer board q01,
  // 2026-09-29), and the puppy package's first vaccination, microchip and veterinary health
  // check. Rule 9: a card does not get to invent a fourth.
  heading = 'What a health-tested litter means',
  body = 'Both parents are DNA tested for L-2-HGA and HC-HSF4. Every puppy leaves with a full veterinary health check, its first vaccination and a microchip.',
  class: cls,
  ...rest
} = Astro.props;
---
<article {...rest} class:list={['kit-card', 'kit-info', cls]}>
  <div class="body">
    <p class="eyebrow eyebrow-ruled">
      <span class="stmt-label" data-kind={kind}>{label}</span>
      <span class="rule" aria-hidden="true"></span>
    </p>
    <h3>{heading}</h3>
    <p>{body}</p>
  </div>
</article>
<style>
  @layer components {
    /* The shell is .kit-card from src/styles/kit.css (convention 9). Only the things that
       are this card's own live here — including the 4px brass bar down the leading edge,
       which is brass as a FILL and never as the label's colour. */
    .kit-info { overflow: hidden; max-width: 420px; color: var(--color-text); border-left: 4px solid var(--color-cta); }
    .stmt-label { font-size: var(--text-xs); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
    .eyebrow { margin: 0 0 var(--space-2); color: var(--color-text-muted); }
    /* The hairline is a real <span>, not an ::after: it runs out from the label to the
       card's inner edge, and an element is what lets it flex. */
    .eyebrow-ruled { display: flex; align-items: center; gap: var(--space-3); }
    .eyebrow-ruled .rule { flex: 1; height: 2px; background: var(--color-cta); }
    .body { padding: var(--space-5); }
    .body p:last-child { margin: 0; font-size: var(--text-sm); }
    h3 { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-brand); }
  }
</style>
