---
// src/components/kit/InfoCard.astro — spec §5 #7. The content/info card.
// a brand header band · b eyebrow label · c icon-led · d image-top, H3 owns the .sec-img
// e plain, bordered, no shadow
//
// TWO DEFERRED CHECKS LIVE HERE.
//  · `layout-h3-image-first` (tests/render/checks/layout.ts) walks the SIBLINGS of an h3
//    until the next H1-H3 and reports a block whose first <p> of >40 characters precedes
//    its first `img.sec-img`. Variant d is that shape deliberately: h3, then the image,
//    then the prose, all as direct children of the article so the check has a block to
//    judge rather than a wrapper it cannot see into.
//  · `sem-statement-label-visible` (tests/render/checks/sem.ts) selects `main .stmt-label`
//    and requires each one to be painted AND to carry a `data-kind` of exactly `fact`,
//    `observed` or `recommendation`. The label is therefore a statement label with a kind,
//    not a free-text eyebrow: `kind` picks the word, and every variant paints one.
// Both are POSITIONAL/state checks, so convention 10 applies — the real coverage is the
// fixture pairs tests/render/fixtures/{known_good,known_broken}/kit-h3-image-*.html and
// kit-stmt-label*.html, which pin this component's own markup.
//
// The photo is a puppy master through astro:assets: the card is max-width 420px, so the
// srcset is 420/840 and `sizes` says exactly that. A hero master at hero widths would
// hand a 420px box a 1600px decode, which is Known Issue 4 in miniature.
//
// Brass is never the colour of this small label on a bone card (2.1:1). The label takes
// --color-text-muted, which data/design/contrast.json already carries against both
// surfaces; brass appears only as the icon accent, which is non-text.
import type { HTMLAttributes } from 'astro/types';
import type { Variant } from './_variant';
import { Image } from 'astro:assets';
import photo from '../../assets/puppies/Roman2.jpg';
// The statement vocabulary lives in src/lib/ because Task 19 deletes this folder and the
// three kinds outlive it.
import { LABELS, type StatementKind } from '../../lib/statement';

type Props = HTMLAttributes<'article'> & {
  variant?: Variant;
  kind?: StatementKind;
  label?: string;
  /** `heading`, not `title`: HTMLAttributes<'article'> already owns `title`, and a prop
   *  that shadowed it would silently swallow a caller's tooltip attribute. */
  heading?: string;
  body?: string;
};
const {
  variant = 'a',
  kind = 'fact',
  label = LABELS[kind],
  // Both sentences are claims the live homepage already makes: the L-2-HGA / HC-HSF4 clear
  // parents, and the puppy package's first vaccination, microchip and veterinary health
  // check. Rule 9: a card does not get to invent a fourth.
  heading = 'What a health-tested litter means',
  body = 'Both parents are clear of L-2-HGA and HC-HSF4. Every puppy leaves with a full veterinary health check, its first vaccination and a microchip.',
  class: cls,
  ...rest
} = Astro.props;
---
<article {...rest} class:list={['kit-card', 'kit-info', `kit-info-${variant}`, cls]} data-variant={variant}>
  {variant === 'a' && (
    <div class="band"><span class="stmt-label" data-kind={kind}>{label}</span></div>
  )}
  {variant === 'd' && (
    <h3 class="sec-h3"><span class="stmt-label" data-kind={kind}>{label}</span>{heading}</h3>
  )}
  {variant === 'd' && (
    <Image
      src={photo}
      alt=""
      widths={[420, 840]}
      sizes="(max-width: 640px) 100vw, 420px"
      class="sec-img"
      loading="lazy"
      decoding="async"
    />
  )}
  {variant === 'd' && <p class="prose">{body}</p>}
  {variant !== 'd' && (
    <div class="body">
      {variant === 'b' && (
        <p class="eyebrow eyebrow-ruled">
          <span class="stmt-label" data-kind={kind}>{label}</span>
          <span class="rule" aria-hidden="true"></span>
        </p>
      )}
      {variant === 'e' && (
        <p class="eyebrow"><span class="stmt-label" data-kind={kind}>{label}</span></p>
      )}
      {variant === 'c' && (
        <p class="icon-row">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
          <span class="stmt-label" data-kind={kind}>{label}</span>
        </p>
      )}
      <h3>{heading}</h3>
      <p>{body}</p>
    </div>
  )}
</article>
<style>
  @layer components {
    /* The shell is .kit-card from src/styles/kit.css (convention 9). Only the things that
       are this card's own live here. */
    .kit-info { overflow: hidden; max-width: 420px; color: var(--color-text); }
    .band { background: var(--color-brand); color: var(--color-text-on-inverse); padding: var(--space-2) var(--space-5); }
    .stmt-label { font-size: var(--text-xs); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
    .eyebrow { margin: 0 0 var(--space-2); color: var(--color-text-muted); }
    .icon-row { margin: 0 0 var(--space-3); display: flex; align-items: center; gap: var(--space-2); color: var(--color-brand); }
    /* Brass as a non-text accent only. */
    .icon-row svg { color: var(--color-cta-hover); }
    .body { padding: var(--space-5); }
    .body p:last-child { margin: 0; font-size: var(--text-sm); }
    h3 { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-brand); }
    .sec-h3 { margin: 0; padding: var(--space-5) var(--space-5) var(--space-3); display: flex; flex-direction: column; gap: 4px; }
    .sec-h3 .stmt-label { color: var(--color-text-muted); }
    .sec-img { display: block; width: 100%; height: auto; }
    .prose { margin: 0; padding: var(--space-5); font-size: var(--text-sm); }

    /* b is the brass treatment, and brass is a FILL here, never the label's colour: a 4px
       bar down the card's leading edge and a hairline that runs out from the label to the
       card's inner edge. The hairline is a real <span>, not an ::after, so b differs from
       e in what it renders and not only in this stylesheet. */
    .kit-info-b { border-left: 4px solid var(--color-cta); }
    .eyebrow-ruled { display: flex; align-items: center; gap: var(--space-3); }
    .eyebrow-ruled .rule { flex: 1; height: 2px; background: var(--color-cta); }
    /* e is the plain one: the bordered card with no fill, no bar and no shadow. */
    .kit-info-e { box-shadow: none; }
  }
</style>
