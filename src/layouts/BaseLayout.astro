---
// src/layouts/BaseLayout.astro — a page on the LEGACY chrome: src/layouts/BaseDocument.astro with
// its two chrome slots filled by the legacy pair, SiteHeader above and SiteFooter below. Every
// page that has not moved onto the kit imports this file, and renders exactly what it rendered
// when the legacy pair was BaseDocument's slot fallback.
//
// The pair lives HERE, not in BaseDocument, so its CSS ships only to the pages that render it:
// Astro bundles a component's styles into every page whose module graph imports it, rendered or
// not, and the kit pages (src/layouts/PageShell.astro) import BaseDocument directly
// (visual-intelligence audit 2026-10-04, rec 14: 87 dead legacy rules on London).
// One line, on purpose: whitespace around <slot /> would add a text node inside <main>, and a legacy
// page's markup is meant to come out byte for byte what it was.
import BaseDocument, { type BaseProps } from './BaseDocument.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
export type { BaseProps };
type Props = BaseProps;
---
<BaseDocument {...Astro.props}><SiteHeader slot="header" /><slot /><SiteFooter slot="footer" /></BaseDocument>
