---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import MarkSprite from '../components/kit/MarkSprite.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Schema from '../components/Schema.astro';
import { SITE, LOGO_RASTER, abs } from '../lib/site';
import pageDates from '../../data/page-dates.json';
interface Props { title: string; description: string; canonical?: string; robots?: string; noindex?: boolean; ogType?: string; ogImage?: string; schema?: unknown[]; crumbTitle?: string }
const { title, description, canonical = Astro.url.pathname, robots = 'index, follow', noindex = false, ogType = 'website', ogImage = LOGO_RASTER, schema = [], crumbTitle = title } = Astro.props;
// `noindex` is the shorthand for the internal pages; it wins over any `robots` string and
// still resolves to the SAME single robots meta below, because that one tag is what
// scripts/generate_sitemaps.py and scripts/sitemap_check.py read to decide indexability —
// a second tag would leave them reading whichever came first.
const robotsContent = noindex ? 'noindex, nofollow' : robots;
const path = canonical.replace(/^https?:\/\/[^/]+/, '') || '/';

// FRESHNESS COMES FROM GIT, ONCE PER PAGE.
//
// `data/page-dates.json` is written by scripts/generate_page_dates.py from real git history
// and regenerated by `prebuild` before every `npm run build`. Never `new Date()` here: a
// build-time stamp tells a crawler every page changed today, every day. Note that the map
// is derived from COMMITTED history, so an uncommitted edit to a page does not move its
// date — that is the point, not a gap: an unpushed working tree has not changed anything a
// crawler can see.
//
// WHY THE CONDITION IS THE PAGE'S OWN SCHEMA AND NOT THE MAP'S `selfDated` FLAG.
// A migrated page carries its own WebPage node with the old site's dates inside its ported
// meta and passes it through `schema`; adding a second node here would put two contradicting
// `dateModified` values on one page, which is worse than none and is what
// `test_no_built_page_carries_two_contradicting_date_modified_values` measures. The map's
// `selfDated` is the generator's SOURCE-level heuristic: it is true when any source file
// behind the route mentions `dateModified`, so every one of the eleven location pages
// inherits the flag from data/locations.json as soon as a single row in it carries a date —
// and the rows that carry none then shipped with no date at all (Birmingham did). What the
// page actually passes is the exact signal, and it is available right here.
const selfDated = JSON.stringify(schema).includes('dateModified');
const dateRow = (pageDates.routes as Record<string, { datePublished: string; dateModified: string; selfDated: boolean }>)[path];
const webPage = dateRow && !selfDated
  ? [{ '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${path}#webpage`, url: path,
       name: title, datePublished: dateRow.datePublished, dateModified: dateRow.dateModified,
       inLanguage: 'en-GB' }]
  : [];
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={abs(path)} />
  <meta property="og:type" content={ogType} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={abs(path)} /><meta property="og:image" content={abs(ogImage)} /><meta property="og:locale" content="en_GB" /><meta property="og:site_name" content={SITE.site_name} />
  <meta name="twitter:card" content="summary_large_image" />
  {/* SVG first for anything that takes one, the 32px PNG for the rest, and the
      180px apple-touch-icon for a home-screen pin. All three are rendered from
      public/brand/logo-icon.svg by scripts/build_favicons.py. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <Schema extra={[...webPage, ...schema]} path={path} title={crumbTitle} />
</head>
<body>
  {/* The mark's two <symbol>s, once per document: every <Mark /> below is a <use> at them. */}
  <MarkSprite />
  <a href="#main" class="skip-link">Skip to content</a>
  {/* The chrome is a pair of NAMED SLOTS whose fallback is the legacy pair, so a page that
      passes nothing renders exactly what it rendered before this layout learned the word
      "slot" — project 4 moves pages onto the kit one at a time, and a page that has not
      moved yet must not change. src/layouts/PageShell.astro fills both with the kit. */}
  <slot name="header"><SiteHeader /></slot>
  <Breadcrumb path={path} title={crumbTitle} />
  <main id="main"><slot /></main>
  <slot name="footer"><SiteFooter /></slot>
  <!--
    Measure the sticky header instead of guessing it.

    `--hdr` drives `[id] { scroll-margin-top: calc(var(--hdr) + 16px) }`, so whenever it
    disagrees with the header's real height an in-page jump lands under the pinned chrome
    and the reader sees the heading they jumped to covered up. The CSS carries two guessed
    values (72px, and 120px under `max-width: 640px`), which were measured on THIS header at
    THIS font size — a longer nav item, a larger default font, or a viewport at 641px where
    the header still wraps all put the guess back out of step, and the failure is silent.

    This script writes the measured height and keeps writing it: on load, on resize, and via
    a ResizeObserver, which is the only one of the three that fires when the header changes
    height without the window changing size (a wrapping nav, a late-loading webfont, the
    logo image finally decoding). The media query above stays exactly as it is and remains
    the no-JS answer — this only narrows the window in which it is wrong, it does not
    replace it. Inline and at the end of <body> so it costs no request and runs after the
    header exists.
  -->
  <script is:inline>
    (function () {
      // Either header: `.site-header` is the legacy one, `.kit-hdr` the kit's. Both set
      // `min-height: var(--hdr)`, so the no-JS fallback is right for both and this only
      // narrows the window in which it is wrong — for whichever one the page mounted.
      var header = document.querySelector('.site-header, .kit-hdr');
      if (!header) return;
      var last = -1;
      function sync() {
        var h = Math.round(header.getBoundingClientRect().height);
        // Only touch the custom property when the value actually changed: a ResizeObserver
        // that writes on every frame would invalidate style on every frame.
        if (h > 0 && h !== last) {
          last = h;
          document.documentElement.style.setProperty('--hdr-measured', h + 'px');
        }
      }
      sync();
      addEventListener('load', sync);
      addEventListener('resize', sync);
      if (window.ResizeObserver) new ResizeObserver(sync).observe(header);
    })();
  </script>
</body>
</html>
