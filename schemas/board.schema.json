{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BSUK Page Board record",
  "type": "object",
  "required": ["meta", "meta_set", "brief", "h1", "sections", "tuple", "assets", "approval"],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object", "required": ["level", "heading", "intent", "children"], "additionalProperties": false,
      "properties": {
        "level": {"type": "integer", "minimum": 3, "maximum": 6},
        "heading": {"type": "string", "minLength": 1},
        "intent": {"type": "string"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object", "required": ["slug", "page_type", "status", "research_as_of", "sources"], "additionalProperties": false,
      "properties": {
        "slug": {
          "comment": "A leading underscore on the first segment marks a record that is NOT a page (today: _demo, the fixture the board-preview route, the cutter and their tests render). No real slug starts with one, so the underscore is what keeps such a record out of every page consumer.",
          "type": "string", "pattern": "^_?[a-z0-9-]+(/[a-z0-9-]+)*$"
        },
        "preview": {
          "comment": "Render this record on /board-preview/<slug>/ even though it is not a draft. Only a record that is NOT a page ever sets it; the route already builds every draft.",
          "type": "boolean"
        },
        "page_type": {"enum": ["home", "hub", "location", "puppy", "blog", "about", "contact", "comparison", "interior", "for-sale"]},
        "status": {"enum": ["draft", "boarded", "approved", "built", "released"]},
        "research_as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "sources": {"type": "array", "items": {"type": "object", "required": ["path", "fetched"], "additionalProperties": false,
                    "properties": {"path": {"type": "string"}, "fetched": {"type": "string"}}}}
      }
    },
    "brief": {
      "type": "object", "required": ["goal", "scope", "gates", "done", "out_of_scope", "primary_keyword", "angles", "strategy", "cta", "tool", "schema"],
      "additionalProperties": false,
      "properties": {
        "goal": {"type": "string"}, "scope": {"type": "string"}, "done": {"type": "string"},
        "gates": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "primary_keyword": {"type": "string", "minLength": 3},
        "angles": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {"type": "object", "required": ["name", "hook", "why_not"], "additionalProperties": false,
                    "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 240},
                                   "hook": {"type": "string", "minLength": 1, "maxLength": 240},
                                   "why_not": {"type": "string", "maxLength": 240}}}
        },
        "strategy": {"type": "object", "required": ["name", "why", "trade_off"], "additionalProperties": false,
                     "properties": {"name": {"type": "string"}, "why": {"type": "string"}, "trade_off": {"type": "string"}}},
        "cta": {"type": "object", "required": ["cadence", "destination", "anchors", "global_cta"], "additionalProperties": false,
                "properties": {
                  "cadence": {"type": "object", "required": ["min", "max"], "additionalProperties": false,
                              "properties": {"min": {"type": "integer", "minimum": 100}, "max": {"type": "integer", "minimum": 100}}},
                  "destination": {"type": "string", "pattern": "^#[a-z][a-z0-9-]*$"},
                  "anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 60}},
                  "global_cta": {"enum": ["hidden", "shown"]}}},
        "tool": {"type": "object", "required": ["pick", "evidence", "trade_off"], "additionalProperties": false,
                 "properties": {"pick": {"type": "string", "minLength": 1, "maxLength": 120},
                                "evidence": {"type": "string", "minLength": 20, "maxLength": 400},
                                "trade_off": {"type": "string", "maxLength": 240}}},
        "schema": {"type": "object", "required": ["types", "offer_model"], "additionalProperties": false,
                   "properties": {"types": {"type": "array", "minItems": 1, "uniqueItems": true,
                                            "items": {"type": "string", "pattern": "^[A-Z][A-Za-z]+$"}},
                                  "offer_model": {"enum": ["product-offer-per-puppy", "aggregate-offer", "none"]}}}
      }
    },
    "h1": {
      "type": "object", "required": ["variants", "recommended", "pick"], "additionalProperties": false,
      "properties": {
        "variants": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
        "recommended": {"type": "integer", "minimum": 0, "maximum": 4},
        "pick": {"type": ["integer", "null"], "minimum": 0, "maximum": 4}
      }
    },
    "meta_set": {
      "type": "object", "required": ["titles", "descriptions", "recommended", "pick"], "additionalProperties": false,
      "properties": {
        "titles": {"type": "array", "minItems": 3, "maxItems": 3,
                   "items": {"type": "string", "minLength": 1, "maxLength": 70}},
        "descriptions": {"type": "array", "minItems": 3, "maxItems": 3,
                         "items": {"type": "string", "minLength": 140, "maxLength": 160}},
        "recommended": {"type": "object", "required": ["title", "description"], "additionalProperties": false,
          "properties": {"title": {"type": "integer", "minimum": 0, "maximum": 2},
                         "description": {"type": "integer", "minimum": 0, "maximum": 2}}},
        "pick": {"type": "object", "required": ["title", "description"], "additionalProperties": false,
          "properties": {"title": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
                         "description": {"type": ["integer", "null"], "minimum": 0, "maximum": 2}}}
      }
    },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "n", "heading", "intent", "category", "group", "why", "why_source", "framework", "words", "shape", "keywords", "entities", "tree", "images", "links", "options"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "n": {"type": "integer", "minimum": 1},
          "heading": {"type": "string", "minLength": 1},
          "intent": {"type": "string"},
          "category": {"enum": ["A", "B", "C"]},
          "group": {"enum": ["MANDATORY", "COMPETITOR-BASED", "SUGGESTED-RECOMMENDED"]},
          "why": {"type": "string", "minLength": 20, "maxLength": 400},
          "why_source": {"type": "string", "minLength": 1, "maxLength": 300},
          "framework": {"enum": ["EEBP", "FAB", "QAB", "PAS", "BAB", "PDB", "AIDA", "EBD", "HSS"]},
          "words": {"type": "object", "required": ["min", "max"], "additionalProperties": false,
                    "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}},
          "shape": {
            "comment": "The first eight are the ported CAG shapes, which name the pool a section's component option comes from. The thirteen that follow are project 4's KIT shapes: each names an arrangement family src/lib/boardStyles.ts renders three ways on /board-preview/<slug>/. `standard` is in both worlds and keeps its meaning — prose. `dial`, `sheet` and `strip` are the three CHROME shapes: not a stretch of page a reader scrolls past but the in-page nav itself, boarded once — on the contact board — so the breeder picks the dial, the section sheet and the mobile section strip every rebuilt page then carries.",
            "enum": ["inventory", "compare", "sequence", "proof", "price", "nav", "narrative", "standard",
                     "hero", "takeaways", "puppies", "reviews", "faq", "form", "stats", "trust", "divider",
                     "dial", "sheet", "strip"]
          },
          "styles": {
            "comment": "The style options this section offers on its board: empty (no style pick — the section is not rendered on the preview route) or exactly the three src/lib/boardStyles.ts defines. scripts/build_board_previews.py refuses anything else, and board_gate.py FAILs `style-unpicked` when an approved record leaves one of these sections without a pick.",
            "type": "array", "uniqueItems": true, "items": {"enum": ["S1", "S2", "S3"]},
            "oneOf": [{"maxItems": 0}, {"minItems": 3, "maxItems": 3}]
          },
          "cta": {"type": "integer", "minimum": 0, "maximum": 6},
          "keywords": {"type": "object",
                       "required": ["primary", "lsi", "longtail", "brand", "geo", "conversational", "comparison", "solution", "transactional"],
                       "additionalProperties": false,
                       "properties": {"primary": {"type": "array", "items": {"type": "string"}}, "lsi": {"type": "array", "items": {"type": "string"}},
                                      "longtail": {"type": "array", "items": {"type": "string"}}, "brand": {"type": "array", "items": {"type": "string"}},
                                      "geo": {"type": "array", "items": {"type": "string"}},
                                      "conversational": {"type": "array", "items": {"type": "string"}}, "comparison": {"type": "array", "items": {"type": "string"}},
                                      "solution": {"type": "array", "items": {"type": "string"}}, "transactional": {"type": "array", "items": {"type": "string"}}}},
          "entities": {"type": "array", "items": {"type": "string", "pattern": "^ont:[a-z0-9-]+$"}},
          "tree": {"type": "array", "items": {"$ref": "#/$defs/node"}},
          "questions": {"type": "array", "minItems": 8, "maxItems": 14, "uniqueItems": true,
                        "items": {"type": "string", "minLength": 8, "pattern": "\\?$"}},
          "images": {"type": "array", "items": {"type": "object", "required": ["slot", "kind", "required", "prompt"], "additionalProperties": false,
                     "properties": {"slot": {"type": "string"}, "kind": {"enum": ["photo", "infographic"]},
                                    "required": {"type": "boolean"}, "prompt": {"type": "string"}}}},
          "links": {
            "type": "object", "required": ["internal", "external"], "additionalProperties": false,
            "properties": {
              "internal": {"type": "array", "items": {
                "type": "object", "required": ["href", "anchor"], "additionalProperties": false,
                "properties": {"href": {"type": "string", "pattern": "^/"},
                               "anchor": {"type": "string", "minLength": 1},
                               "nav": {"type": "boolean"},
                               "why": {"type": "string", "minLength": 1, "description": "where this link comes from, e.g. 'carried from the migrated page' (working rule 12)"},
                               "sentence_start": {"const": true}},
                "if": {"required": ["nav"], "properties": {"nav": {"const": true}}},
                "then": true,
                "else": {"required": ["sentence_start"]}}},
              "external": {"type": "array", "items": {
                "type": "object", "required": ["href", "anchor", "library_row"], "additionalProperties": false,
                "properties": {"href": {"type": "string", "pattern": "^https?://"},
                               "anchor": {"type": "string", "minLength": 1},
                               "why": {"type": "string", "minLength": 1, "description": "where this link comes from, e.g. 'carried from the migrated page' (working rule 12)"},
                               "library_row": {"type": "string", "minLength": 1}}}}
            }
          },
          "options": {"type": "object", "required": ["candidates", "excluded", "pick", "note"], "additionalProperties": false,
                      "properties": {"candidates": {"type": "array", "items": {"type": "string"}},
                                     "excluded": {"type": "array", "items": {"type": "object", "required": ["component", "owner"], "additionalProperties": false,
                                                  "properties": {"component": {"type": "string"}, "owner": {"type": "string"},
                                                                 "owners": {"type": "array", "items": {"type": "string"}}}}},
                                     "pick": {"type": ["string", "null"]}, "note": {"type": "string"}}}
        },
        "allOf": [
          {
            "if": {"required": ["id", "shape"],
                   "properties": {"id": {"const": "faq"}, "shape": {"const": "standard"}}},
            "then": {"required": ["questions"]}
          },
          {
            "comment": "A KIT shape draws its component from src/lib/boardStyles.ts, not from a ledger pool, so its board offers rendered arrangements and nothing else. A kit-shaped section with no `styles` would therefore reach the approve button owing a pick it is never shown a control for — an unapprovable board. The nine are required to carry the three. `standard` is deliberately NOT among them: it is shared with the ported CAG shapes, it is what every section of the existing homepage record is, and its board still offers the ledger default.",
            "if": {"required": ["shape"],
                   "properties": {"shape": {"enum": ["hero", "takeaways", "puppies", "reviews", "faq",
                                                     "form", "stats", "trust", "divider",
                                                     "dial", "sheet", "strip"]}}},
            "then": {"required": ["styles"], "properties": {"styles": {"minItems": 3}}}
          }
        ]
      }
    },
    "tuple": {
      "type": "object", "required": ["hero", "dial", "rail", "toc", "takeaway", "table", "faq", "stepper", "newsletter", "h6_prefixes"], "additionalProperties": false,
      "properties": {
        "hero": {"type": "string"}, "dial": {"type": "string"}, "rail": {"type": "string"}, "toc": {"type": "string"},
        "takeaway": {"type": "array", "items": {"type": "string", "minLength": 1}}, "table": {"type": "string"}, "faq": {"type": "string"},
        "stepper": {"type": "string"},
        "newsletter": {"type": "object", "required": ["after", "variant"], "additionalProperties": false,
                       "properties": {"after": {"type": "string"}, "variant": {"enum": ["", "A", "B", "C"]}}},
        "h6_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": ":$"}}
      }
    },
    "assets": {
      "type": "array",
      "items": {"type": "object", "required": ["slot", "kind", "w", "h", "required", "status", "file", "alt"], "additionalProperties": false,
                "properties": {"slot": {"type": "string"}, "kind": {"enum": ["photo", "infographic"]},
                               "w": {"type": "integer"}, "h": {"type": "integer"}, "required": {"type": "boolean"},
                               "status": {"enum": ["missing", "baked"]}, "file": {"type": ["string", "null"]}, "alt": {"type": "string"}}}
    },
    "dropped": {
      "comment": "Facts of the migrated page this rebuild deliberately leaves out, keyed by the fact kind scripts/facts_preserved_check.py names (prices, names, tests, creds, images, embeds), plus `links` for a body link of the migrated page the outline does not carry (working rule 12) and `text` for a CLAIM SENTENCE of the migrated body the rebuilt prose does not restate. Every entry reads \"<the fact, or enough of it to find> \u2014 <why it is not carried>\". For `text` the checker extracts the migrated body's claim sentences -- the ones carrying a number, a named organisation or a named process (training, review, audit, screening, vaccination) -- and asks that each is either restated on the rebuilt page or listed here, so a claim cannot leave a page by being quietly not rewritten. A fact, link or claim listed here is one the user agreed to drop; one that simply vanished is a problem the gate reports.",
      "type": "object",
      "propertyNames": {"enum": ["prices", "names", "tests", "creds", "images", "embeds", "links", "text"]},
      "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}
    },
    "approval": {
      "type": ["object", "null"],
      "required": ["approved_at", "h1", "picks", "notes", "canvas_version", "record_hash"], "additionalProperties": false,
      "properties": {
        "approved_at": {"type": "string"}, "h1": {"type": "integer", "minimum": 0, "maximum": 4},
        "meta": {"type": "object", "required": ["title", "description"], "additionalProperties": false,
                 "properties": {"title": {"type": "integer", "minimum": 0, "maximum": 2},
                                "description": {"type": "integer", "minimum": 0, "maximum": 2}}},
        "picks": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"type": "string"}},
        "notes": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"type": "string"}},
        "canvas_version": {"type": ["string", "null"]},
        "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tuple_before": {"$ref": "#/properties/tuple",
                         "description": "the tuple as the author wrote it, before board_approve.py derived the seven component axes from the picks; restoring it is what keeps re-approving an already-approved record idempotent"}
      }
    },
    "approval_previous": {
      "comment": "The approval a record carried before it was sent back to the board. Kept so the picks the user already made are not retyped, and so the diff between two approvals of one page is readable. It is NOT an approval: board_gate.py reads `approval` only, and a record holding this and a null `approval` is unapproved.",
      "$ref": "#/properties/approval"
    }
  }
}
