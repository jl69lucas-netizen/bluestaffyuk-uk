{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BSUK competitor registry",
  "description": "data/competitors.json — the national competitor list the gap matrix counts against. Spec 2026-09-23-competitor-intel §4. Rules a schema cannot state (derived priority, cities, duplicates, link guard) live in scripts/competitor_registry_check.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "competitors"],
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_discovery_run", "seed_keywords", "total"],
      "properties": {
        "last_discovery_run": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "seed_keywords": {"type": "array", "minItems": 1, "uniqueItems": true,
                          "items": {"type": "string", "minLength": 1}},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "competitors": {"type": "array", "items": {"$ref": "#/$defs/competitor"}}
  },
  "$defs": {
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "root_domain", "tier", "seed_hits", "cities", "priority",
                   "link_allowed", "last_analyzed", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "not": {"const": "bsuk"}},
        "name": {"type": "string", "minLength": 1},
        "root_domain": {"type": "string", "minLength": 3},
        "tier": {"enum": [1, 2, 3, 4, 5]},
        "seed_hits": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["keyword", "position"],
            "properties": {
              "keyword": {"type": "string", "minLength": 1},
              "position": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }
        },
        "cities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "priority": {"enum": ["high", "medium", "low"]},
        "link_allowed": {"type": "boolean"},
        "last_analyzed": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "notes": {"type": "string"}
      }
    }
  }
}
